  "semantics": {
    "reference": "https://cdrdv2-public.intel.com/836199/361050-intel-avx10.2-spec.pdf",
    "section": "E4 exception conditions, table 4.7",
    "control": "Existing byte control is unchanged; i386 CS/ES/SS uses a checked two-byte control with the architectural prefix in bits 8..15.",
    "address": "EA wraps at original addr16/addr32 width; raw segment offsets are never rebased as image pointers.",
    "concrete_execution": "Active CS/ES/SS access refuses without descriptor context before observing or mutating memory; zero-mask suppression needs no descriptor.",
    "source_storage": "HighIR scalar inputs have unsigned _BitInt storage at their complete packed width, including all four packed sources. LLVM-to-C keeps its already checked vector types."
  },
