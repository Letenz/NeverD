+  // Specifier values belong to the target, not to MC as a whole. X86's PLT
+  // value overlaps the ELF AArch64 PAGE bitfield; applying that interpretation
+  // to an x86 call loses both the target and fixup's low twelve address bits.
+  if (TT.isAArch64()) {
+    if (Spec) {
+      IsPage = (Spec & 0x0f0) == 0x010;
+      IsPage |= (Spec == 0x406 || Spec == 0x404 || Spec == 0x409);
+      IsPageOff = (Spec & 0x0f0) == 0x020;
+      IsPageOff |= (Spec == 0x407 || Spec == 0x405 || Spec == 0x40a);
+    }
+    if (!IsPage && isAArch64PageFixup(*Wrapped, FK))
+      IsPage = true;
+    if (!IsPageOff && isAArch64PageOffFixup(*Wrapped, FK))
+      IsPageOff = true;
+  }
