# Runs after Qt's deployment script, in the install tree, never on build inputs.
if(NOT NEVERD_DEPLOY_SYSTEM MATCHES "^(Linux|Windows)$")
  message(FATAL_ERROR "Desktop runtime collector supports Linux and Windows")
endif()
set(_prefix "${QT_DEPLOY_PREFIX}")
if(NOT IS_DIRECTORY "${_prefix}/bin")
  message(FATAL_ERROR "Missing desktop install bin directory")
endif()
set(_executables)
foreach(_name neverd-gui neverd-worker neverd-mcp neverd)
  set(_path "${_prefix}/bin/${_name}${NEVERD_DEPLOY_EXECUTABLE_SUFFIX}")
  if(EXISTS "${_path}")
    list(APPEND _executables "${_path}")
  elseif(NOT _name STREQUAL "neverd")
    message(FATAL_ERROR "Desktop package is missing ${_name}")
  endif()
endforeach()

# Only local SQLite is used by NDDB. Avoid shipping external SQL connectors
# that introduce unrelated database clients and unresolved optional libraries.
set(_sql "${_prefix}/${QT_DEPLOY_PLUGINS_DIR}/sqldrivers")
if(NEVERD_DEPLOY_SYSTEM STREQUAL "Windows")
  set(_debug_suffix "")
  if(NEVERD_DEPLOY_CONFIG STREQUAL "Debug")
    set(_debug_suffix "d")
  endif()
  set(_sqlite "qsqlite${_debug_suffix}.dll")
  set(_sql_pattern "^qsql(mimer|mysql|odbc|psql|oci|db2|ibase)${_debug_suffix}\\.dll$")
  set(_lib_dir "${_prefix}/bin")
  set(_pre_exclude "[Aa][Pp][Ii]-[Mm][Ss]-.*" "[Ee][Xx][Tt]-[Mm][Ss]-.*")
  set(_post_exclude ".*[/\\\\][Ww][Ii][Nn][Dd][Oo][Ww][Ss][/\\\\].*")
else()
  set(_sqlite "libqsqlite.so")
  set(_sql_pattern "^libqsql(mimer|mysql|odbc|psql|oci|db2|ibase)\\.so$")
  set(_lib_dir "${_prefix}/${QT_DEPLOY_LIB_DIR}")
  # The OS owns glibc, the loader, and graphics dispatch/driver libraries.
  # Other dependencies, including Qt's own dynamic zlib, are copied privately.
  set(_pre_exclude
    "^ld-(linux|musl).*" "^lib(c|m|dl|pthread|rt|util|resolv|anl)\\.so\\..*"
    "^lib(GL|GLX|EGL|OpenGL|GLdispatch|vulkan)\\.so\\..*")
  set(_post_exclude)
endif()
if(NOT EXISTS "${_sql}/${_sqlite}" OR IS_DIRECTORY "${_sql}/${_sqlite}")
  message(FATAL_ERROR "Desktop package must contain the SQLite Qt driver")
endif()
file(GLOB _sql_entries "${_sql}/*")
set(_remove)
foreach(_path IN LISTS _sql_entries)
  get_filename_component(_name "${_path}" NAME)
  if(IS_SYMLINK "${_path}" OR IS_DIRECTORY "${_path}")
    message(FATAL_ERROR "Unexpected Qt SQL driver entry: ${_path}")
  elseif(_name STREQUAL _sqlite)
    continue()
  elseif(_name MATCHES "${_sql_pattern}")
    list(APPEND _remove "${_path}")
  else()
    message(FATAL_ERROR "Unknown Qt SQL driver: ${_path}")
  endif()
endforeach()
if(_remove)
  file(REMOVE ${_remove})
endif()

# Normalize installed inputs before discovery as well as after copying. This
# also keeps repeated installs from mixing original and already bundled paths.
function(neverd_relocate_desktop_images)
  if(NOT NEVERD_DEPLOY_SYSTEM STREQUAL "Linux")
    return()
  endif()
  find_program(_patchelf patchelf REQUIRED)
  set(_images ${ARGN})
  set(_real_images)
  foreach(_path IN LISTS _images)
    file(REAL_PATH "${_path}" _real)
    file(RELATIVE_PATH _relative "${_prefix}" "${_real}")
    if(_relative MATCHES "^\\.\\." OR IS_ABSOLUTE "${_relative}")
      message(FATAL_ERROR "Refusing to patch a runtime outside the package: ${_real}")
    endif()
    if(IS_SYMLINK "${_path}")
      file(READ_SYMLINK "${_path}" _link)
      if(IS_ABSOLUTE "${_link}")
        message(FATAL_ERROR "Non-relocatable runtime symlink: ${_path}")
      endif()
    endif()
    list(APPEND _real_images "${_real}")
  endforeach()
  list(REMOVE_DUPLICATES _real_images)
  foreach(_path IN LISTS _real_images)
    get_filename_component(_directory "${_path}" DIRECTORY)
    file(RELATIVE_PATH _relative "${_directory}" "${_lib_dir}")
    set(_rpath "$ORIGIN")
    if(NOT _relative STREQUAL "")
      string(APPEND _rpath "/${_relative}")
    endif()
    execute_process(COMMAND "${_patchelf}" --set-rpath "${_rpath}" "${_path}"
      RESULT_VARIABLE _result ERROR_VARIABLE _error)
    if(NOT _result EQUAL 0)
      message(FATAL_ERROR "Cannot relocate ${_path}: ${_error}")
    endif()
  endforeach()
endfunction()

file(MAKE_DIRECTORY "${_lib_dir}")
set(_search_dirs ${NEVERD_DEPLOY_SEARCH_DIRS})
foreach(_path IN LISTS NEVERD_DEPLOY_RUNTIME_LIBRARIES)
  get_filename_component(_directory "${_path}" DIRECTORY)
  list(APPEND _search_dirs "${_directory}")
  file(INSTALL "${_path}" DESTINATION "${_lib_dir}" FOLLOW_SYMLINK_CHAIN)
endforeach()

file(GLOB_RECURSE _libraries "${_lib_dir}/*.so*" "${_prefix}/bin/*.dll")
file(GLOB_RECURSE _plugins "${_prefix}/${QT_DEPLOY_PLUGINS_DIR}/*.so*"
  "${_prefix}/${QT_DEPLOY_PLUGINS_DIR}/*.dll")
neverd_relocate_desktop_images(${_executables} ${_libraries} ${_plugins})
file(GET_RUNTIME_DEPENDENCIES
  EXECUTABLES ${_executables} LIBRARIES ${_libraries} MODULES ${_plugins}
  DIRECTORIES "${_lib_dir}" ${_search_dirs}
  PRE_EXCLUDE_REGEXES ${_pre_exclude} POST_EXCLUDE_REGEXES ${_post_exclude}
  RESOLVED_DEPENDENCIES_VAR _resolved UNRESOLVED_DEPENDENCIES_VAR _unresolved
  CONFLICTING_DEPENDENCIES_PREFIX _conflicts)
if(_unresolved OR _conflicts_FILENAMES)
  message(FATAL_ERROR "Incomplete desktop runtime: ${_unresolved}; conflicts: ${_conflicts_FILENAMES}")
endif()
foreach(_path IN LISTS _resolved)
  file(RELATIVE_PATH _relative "${_prefix}" "${_path}")
  if(_relative MATCHES "^\\.\\.")
    file(INSTALL "${_path}" DESTINATION "${_lib_dir}" FOLLOW_SYMLINK_CHAIN)
  endif()
endforeach()

file(GLOB_RECURSE _libraries "${_lib_dir}/*.so*" "${_prefix}/bin/*.dll")
neverd_relocate_desktop_images(${_executables} ${_libraries} ${_plugins})

# Resolve again from the completed package. A library found only in the build
# machine's directories is a packaging failure, even if it exists locally.
file(GET_RUNTIME_DEPENDENCIES
  EXECUTABLES ${_executables} LIBRARIES ${_libraries} MODULES ${_plugins}
  DIRECTORIES "${_lib_dir}"
  PRE_EXCLUDE_REGEXES ${_pre_exclude} POST_EXCLUDE_REGEXES ${_post_exclude}
  RESOLVED_DEPENDENCIES_VAR _resolved UNRESOLVED_DEPENDENCIES_VAR _unresolved
  CONFLICTING_DEPENDENCIES_PREFIX _conflicts)
if(_unresolved OR _conflicts_FILENAMES)
  message(FATAL_ERROR "Relocated desktop runtime is incomplete: ${_unresolved}; ${_conflicts_FILENAMES}")
endif()
set(_audit "Private desktop runtime; operating-system and graphics-driver libraries remain external.\n")
set(_audited)
foreach(_path IN LISTS _resolved _executables _libraries _plugins)
  file(REAL_PATH "${_path}" _real)
  file(RELATIVE_PATH _relative "${_prefix}" "${_real}")
  if(_relative MATCHES "^\\.\\." OR IS_ABSOLUTE "${_relative}")
    message(FATAL_ERROR "Desktop runtime escapes the package: ${_real}")
  endif()
  if(_real IN_LIST _audited)
    continue()
  endif()
  list(APPEND _audited "${_real}")
  file(SHA256 "${_real}" _sha)
  string(APPEND _audit "${_sha}  ${_relative}\n")
endforeach()
file(MAKE_DIRECTORY "${_prefix}/share/neverd")
file(WRITE "${_prefix}/share/neverd/dependency-audit.txt" "${_audit}")
