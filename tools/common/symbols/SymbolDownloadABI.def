//===- SymbolDownloadABI.def - Symbol transport constants -------*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// Constants shared by command-line and workbench symbol downloads: the
/// libraries that carry libcurl, the libcurl options and values it sets (fixed
/// numbers of libcurl's stable ABI), and the limits of a transfer, shared by
/// both surfaces.  Define the macros before including this file.
///
///   NEVERD_CURL_LIBRARY(Name)       a library to load libcurl from, in order
///   NEVERD_CURL_VALUE(Name, Value)  a libcurl option, info or value number
///   NEVERD_SYMBOL_LIMIT(Name, Value) a limit of a transfer
///
//===----------------------------------------------------------------------===//

#ifndef NEVERD_CURL_LIBRARY
#define NEVERD_CURL_LIBRARY(Name)
#endif
#ifndef NEVERD_CURL_VALUE
#define NEVERD_CURL_VALUE(Name, Value)
#endif
#ifndef NEVERD_SYMBOL_LIMIT
#define NEVERD_SYMBOL_LIMIT(Name, Value)
#endif

// libcurl is part of every macOS and of most Linux installations; it is
// loaded when a download is asked for, so the command line runs without it.
NEVERD_CURL_LIBRARY("libcurl.so.4")
NEVERD_CURL_LIBRARY("libcurl-gnutls.so.4")
NEVERD_CURL_LIBRARY("/usr/lib/libcurl.4.dylib")
NEVERD_CURL_LIBRARY("libcurl.4.dylib")

// curl_global_init's flags.
NEVERD_CURL_VALUE(GlobalDefault, 3)
// Options: a long, a pointer or a function, by their number's range.
NEVERD_CURL_VALUE(OptTimeout, 13)
NEVERD_CURL_VALUE(OptLowSpeedLimit, 19)
NEVERD_CURL_VALUE(OptLowSpeedTime, 20)
NEVERD_CURL_VALUE(OptNoProgress, 43)
NEVERD_CURL_VALUE(OptFollowLocation, 52)
NEVERD_CURL_VALUE(OptMaxRedirects, 68)
NEVERD_CURL_VALUE(OptConnectTimeout, 78)
NEVERD_CURL_VALUE(OptWriteData, 10001)
NEVERD_CURL_VALUE(OptURL, 10002)
NEVERD_CURL_VALUE(OptErrorBuffer, 10010)
NEVERD_CURL_VALUE(OptUserAgent, 10018)
NEVERD_CURL_VALUE(OptXferInfoData, 10057)
NEVERD_CURL_VALUE(OptProtocols, 10318)
NEVERD_CURL_VALUE(OptRedirectProtocols, 10319)
NEVERD_CURL_VALUE(OptWriteFunction, 20011)
NEVERD_CURL_VALUE(OptXferInfoFunction, 20219)
NEVERD_CURL_VALUE(OptMaxFileSize, 30117)
// curl_easy_getinfo's response code, a long.
NEVERD_CURL_VALUE(InfoResponseCode, 0x200002)
// Room curl_easy_strerror's longer messages need in an error buffer.
NEVERD_CURL_VALUE(ErrorBufferSize, 256)

// A transfer's limits: its size, its connection and idle times, its whole
// time, how many redirects and retries it may take, and the pause before a
// retry, which grows with each.
NEVERD_SYMBOL_LIMIT(MaxBytes, 2LL * 1024 * 1024 * 1024)
NEVERD_SYMBOL_LIMIT(ConnectSeconds, 30)
NEVERD_SYMBOL_LIMIT(IdleSeconds, 30)
NEVERD_SYMBOL_LIMIT(TransferSeconds, 600)
NEVERD_SYMBOL_LIMIT(MaxRedirects, 5)
NEVERD_SYMBOL_LIMIT(TransferRetries, 2)
NEVERD_SYMBOL_LIMIT(RetryPauseMs, 750)

#undef NEVERD_CURL_LIBRARY
#undef NEVERD_CURL_VALUE
#undef NEVERD_SYMBOL_LIMIT
