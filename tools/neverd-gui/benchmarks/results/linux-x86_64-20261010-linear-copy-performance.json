    "assembly_source": "// Diagnostic-only reproduction: same index, low-byte versus full-width guard.\n// Each table has explicit independent storage ownership.\n        .macro count_guard name, instruction, byte_guard\n        .text\n        .globl \\name\n        .type \\name,@function\n\\name:\n        \\instruction %edi, %ecx\n        .if \\byte_guard\n        cmpb $3, %cl\n        .else\n        cmpl $3, %ecx\n        .endif\n        ja .Ldefault\\@\n        leaq .Ltable\\@(%rip), %rax\n        movslq (%rax,%rcx,4), %rdx\n        addq %rax, %rdx\n        jmpq *%rdx\n.Lcase0\\@:\n        movl $8100, %eax\n        retq\n.Lcase1\\@:\n        movl $8101, %eax\n        retq\n.Lcase2\\@:\n        movl $8102, %eax\n        retq\n.Lcase3\\@:\n        movl $8103, %eax\n        retq\n.Ldefault\\@:\n        movl $8999, %eax\n        retq\n        .size \\name, .-\\name\n        .section .rodata.\\name,\"a\",@progbits\n        .p2align 2\n.Ltable\\@:\n        .long .Lcase0\\@-.Ltable\\@, .Lcase1\\@-.Ltable\\@\n        .long .Lcase2\\@-.Ltable\\@, .Lcase3\\@-.Ltable\\@\n        .endm\n        count_guard jt_ctz_byteguard, tzcntl, 1\n        count_guard jt_ctz_fullguard, tzcntl, 0\n        count_guard jt_popcount_byteguard, popcntl, 1\n        count_guard jt_popcount_fullguard, popcntl, 0\n        count_guard jt_lzcnt_byteguard, lzcntl, 1\n        count_guard jt_lzcnt_fullguard, lzcntl, 0\n        .purgem count_guard\n        .section .note.GNU-stack,\"\",@progbits\n"
  },
