// NEVERD_RUST_CONTROL(Word), NEVERD_RUST_KEYWORD(Word), NEVERD_RUST_TYPE(Word):
// the Rust view of pseudocode.  It keeps C's `goto` and the SEH and C++
// handler forms where Rust has none.
#ifndef NEVERD_RUST_CONTROL
#define NEVERD_RUST_CONTROL(Word)
#endif
NEVERD_RUST_CONTROL("if")
NEVERD_RUST_CONTROL("else")
NEVERD_RUST_CONTROL("loop")
NEVERD_RUST_CONTROL("while")
NEVERD_RUST_CONTROL("for")
NEVERD_RUST_CONTROL("match")
NEVERD_RUST_CONTROL("break")
NEVERD_RUST_CONTROL("continue")
NEVERD_RUST_CONTROL("return")
NEVERD_RUST_CONTROL("goto")
NEVERD_RUST_CONTROL("__try")
NEVERD_RUST_CONTROL("__except")
NEVERD_RUST_CONTROL("__finally")
NEVERD_RUST_CONTROL("__leave")
NEVERD_RUST_CONTROL("try")
NEVERD_RUST_CONTROL("catch")
NEVERD_RUST_CONTROL("throw")
#undef NEVERD_RUST_CONTROL
#ifndef NEVERD_RUST_KEYWORD
#define NEVERD_RUST_KEYWORD(Word)
#endif
NEVERD_RUST_KEYWORD("fn")
NEVERD_RUST_KEYWORD("let")
NEVERD_RUST_KEYWORD("mut")
NEVERD_RUST_KEYWORD("unsafe")
NEVERD_RUST_KEYWORD("as")
NEVERD_RUST_KEYWORD("extern")
NEVERD_RUST_KEYWORD("static")
NEVERD_RUST_KEYWORD("const")
NEVERD_RUST_KEYWORD("struct")
NEVERD_RUST_KEYWORD("type")
NEVERD_RUST_KEYWORD("raw")
NEVERD_RUST_KEYWORD("impl")
NEVERD_RUST_KEYWORD("dyn")
NEVERD_RUST_KEYWORD("true")
NEVERD_RUST_KEYWORD("false")
NEVERD_RUST_KEYWORD("abort")
#undef NEVERD_RUST_KEYWORD
#ifndef NEVERD_RUST_TYPE
#define NEVERD_RUST_TYPE(Word)
#endif
NEVERD_RUST_TYPE("bool")
NEVERD_RUST_TYPE("char")
NEVERD_RUST_TYPE("str")
NEVERD_RUST_TYPE("c_void")
NEVERD_RUST_TYPE("isize")
NEVERD_RUST_TYPE("usize")
NEVERD_RUST_TYPE("f32")
NEVERD_RUST_TYPE("f64")
NEVERD_RUST_TYPE("Self")
