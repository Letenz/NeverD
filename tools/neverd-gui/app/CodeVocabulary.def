//===- CodeVocabulary.def - Pseudocode and IR highlighting -----*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// Words the code view colors specially in C pseudocode and in the textual
/// intermediate representations.  Highlighting is presentation only.
///
//===----------------------------------------------------------------------===//

// NEVERD_C_CONTROL(Word): control-flow keywords.
#ifndef NEVERD_C_CONTROL
#define NEVERD_C_CONTROL(Word)
#endif
NEVERD_C_CONTROL("if")
NEVERD_C_CONTROL("else")
NEVERD_C_CONTROL("for")
NEVERD_C_CONTROL("while")
NEVERD_C_CONTROL("do")
NEVERD_C_CONTROL("switch")
NEVERD_C_CONTROL("case")
NEVERD_C_CONTROL("default")
NEVERD_C_CONTROL("break")
NEVERD_C_CONTROL("continue")
NEVERD_C_CONTROL("return")
NEVERD_C_CONTROL("goto")
NEVERD_C_CONTROL("__try")
NEVERD_C_CONTROL("__except")
NEVERD_C_CONTROL("__finally")
NEVERD_C_CONTROL("__leave")
NEVERD_C_CONTROL("try")
NEVERD_C_CONTROL("catch")
NEVERD_C_CONTROL("throw")
#undef NEVERD_C_CONTROL

