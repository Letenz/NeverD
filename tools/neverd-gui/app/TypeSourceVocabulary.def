//===- TypeSourceVocabulary.def - Local type source highlighting -*- C++
//-*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// The words the Local Types window colors in the C, C++, Rust and Go it
/// shows types in.  Highlighting is presentation only.
///
/// NEVERD_TYPE_SOURCE_KEYWORD(Language, Word): a keyword of the language
///   (c, cpp, rust, go, python, javascript or lua); C++ colors C's words
///   too.
/// NEVERD_TYPE_SOURCE_BUILTIN(Language, Word): a builtin type name.
///
//===----------------------------------------------------------------------===//

#ifndef NEVERD_TYPE_SOURCE_KEYWORD
#define NEVERD_TYPE_SOURCE_KEYWORD(Language, Word)
#endif
#ifndef NEVERD_TYPE_SOURCE_BUILTIN
#define NEVERD_TYPE_SOURCE_BUILTIN(Language, Word)
#endif

