/* Workbench chrome after the Visual Studio Code workbench.  A placeholder
   (a name in braces after a dollar sign) is an entry of app/ChromeColors.def
   for the active theme; Mode names the theme itself, which picks the glyphs
   drawn for it, and CodeFont is the code font in which text fields type. */
QMainWindow, QDialog { background: ${Window}; }
QDialog#commandPalette { border: 1px solid ${MenuSeparator}; }
QMenuBar { background: ${MenuBar}; color: ${MenuBarText}; border: none; padding: 0 2px; }
QMenuBar::item { background: transparent; padding: 4px 8px; border-radius: 3px; }
QMenuBar::item:selected, QMenuBar::item:pressed { background: ${MenuBarSelection}; }
QMenu { background: ${Menu}; color: ${MenuText}; border: 1px solid ${MenuSeparator}; padding: 4px 0; }
QMenu::item { padding: 4px 24px 4px 26px; }
QMenu::item:selected { background: ${MenuSelection}; color: ${HighlightedText}; }
QMenu::item:disabled { color: ${DisabledText}; }
QMenu::separator { height: 1px; background: ${MenuSeparator}; margin: 4px 0; }
QMenu::icon { padding-left: 6px; }
QMenu::indicator { width: 14px; height: 14px; left: 6px; }
QMenu::indicator:checked { image: url(:/neverd/icons/menu_check-${Mode}.svg); }
QToolBar { background: ${ToolBar}; border: none; spacing: 1px; padding: 2px 3px; }
QToolBar::separator { background: ${Separator}; width: 1px; margin: 3px 4px; }
QToolBar::handle:horizontal { image: url(:/neverd/icons/grip_vertical-${Mode}.svg); width: 6px; margin: 0 2px; }
QToolBar::handle:vertical { image: url(:/neverd/icons/grip_horizontal-${Mode}.svg); height: 6px; margin: 2px 0; }
QToolButton { background: transparent; color: ${WindowText}; border: 1px solid transparent; border-radius: 3px; padding: 2px; }
QToolButton:hover { background: ${ToolBarHover}; }
QToolButton:pressed, QToolButton:checked { background: ${Highlight}; color: ${HighlightedText}; }
QToolButton::menu-indicator { image: none; width: 0; }
QStatusBar { background: ${StatusBar}; color: ${StatusBarText}; min-height: 22px; }
QStatusBar QLabel { color: ${StatusBarText}; padding: 0 8px; }
QStatusBar::item { border: none; }
QTreeView, QListView, QTableView { background: ${Base}; alternate-background-color: ${AlternateBase}; color: ${Text}; border: none; selection-background-color: ${Highlight}; selection-color: ${HighlightedText}; outline: none; }
QTreeView::item, QListView::item { padding: 1px 2px; }
QTreeView::item:hover, QListView::item:hover { background: ${Hover}; }
QTreeView::item:selected, QListView::item:selected { background: ${Highlight}; color: ${HighlightedText}; }
QHeaderView { background: ${HeaderBackground}; }
QHeaderView::section { background: ${HeaderBackground}; color: ${HeaderText}; border: none; border-right: 1px solid ${Border}; border-bottom: 1px solid ${Border}; padding: 3px 6px; }
QLineEdit, QComboBox, QAbstractSpinBox, QPlainTextEdit, QTextEdit { background: ${Input}; color: ${Text}; border: 1px solid ${InputBorder}; border-radius: 2px; padding: 3px 4px; selection-background-color: ${Highlight}; selection-color: ${HighlightedText}; }
QLineEdit:focus, QComboBox:focus, QAbstractSpinBox:focus, QPlainTextEdit:focus, QTextEdit:focus { border: 1px solid ${Focus}; }
QPlainTextEdit[readOnly="true"], QTextEdit[readOnly="true"] { background: ${Base}; border: none; }
QLineEdit, QAbstractSpinBox, QPlainTextEdit[readOnly="false"], QTextEdit[readOnly="false"] { font: ${CodeFont}; }
QComboBox { padding-right: 20px; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: center right; width: 20px; border: none; }
QComboBox::down-arrow { image: url(:/neverd/icons/chevron_down-${Mode}.svg); width: 10px; height: 10px; }
QComboBox QLineEdit { background: transparent; border: none; padding: 0; }
QAbstractSpinBox { padding-right: 18px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { subcontrol-origin: border; width: 18px; border: none; background: transparent; }
QAbstractSpinBox::up-button { subcontrol-position: top right; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background: ${ToolBarHover}; }
QAbstractSpinBox::up-arrow { image: url(:/neverd/icons/chevron_up-${Mode}.svg); width: 10px; height: 10px; }
QAbstractSpinBox::down-arrow { image: url(:/neverd/icons/chevron_down-${Mode}.svg); width: 10px; height: 10px; }
QComboBox QAbstractItemView { background: ${Menu}; color: ${MenuText}; border: 1px solid ${MenuSeparator}; selection-background-color: ${MenuSelection}; }
QPushButton { background: ${Button}; color: ${ButtonText}; border: 1px solid ${Border}; border-radius: 2px; padding: 4px 14px; }
QPushButton:hover { background: ${ToolBarHover}; }
QPushButton:default { background: ${ButtonPrimary}; color: ${ButtonPrimaryText}; border: 1px solid ${ButtonPrimary}; }
QPushButton:default:hover { background: ${ButtonPrimaryHover}; }
QPushButton:disabled { color: ${DisabledText}; }
QDialogButtonBox { dialogbuttonbox-buttons-have-icons: 0; }
QCheckBox, QRadioButton, QLabel, QGroupBox { color: ${WindowText}; }
QLabel[placeholder="true"] { color: ${PlaceholderText}; background: ${Base}; }
QCheckBox, QRadioButton { spacing: 6px; }
QCheckBox:disabled, QRadioButton:disabled { color: ${DisabledText}; }
QCheckBox::indicator, QGroupBox::indicator, QAbstractItemView::indicator { width: 14px; height: 14px; border: 1px solid ${CheckboxBorder}; border-radius: 3px; background: ${CheckboxBackground}; }
QRadioButton::indicator { width: 14px; height: 14px; border: 1px solid ${CheckboxBorder}; border-radius: 8px; background: ${CheckboxBackground}; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QGroupBox::indicator:hover { border-color: ${Focus}; }
QCheckBox::indicator:checked, QGroupBox::indicator:checked, QAbstractItemView::indicator:checked { background: ${CheckboxChecked}; border-color: ${CheckboxChecked}; image: url(:/neverd/icons/check.svg); }
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate { background: ${CheckboxChecked}; border-color: ${CheckboxChecked}; image: url(:/neverd/icons/check_partial.svg); }
QRadioButton::indicator:checked { background: ${CheckboxChecked}; border-color: ${CheckboxChecked}; image: url(:/neverd/icons/radio_dot.svg); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background: ${Window}; border-color: ${Border}; }
QCheckBox::indicator:checked:disabled, QRadioButton::indicator:checked:disabled { background: ${DisabledText}; border-color: ${DisabledText}; }
QGroupBox { border: 1px solid ${Border}; border-radius: 3px; margin-top: 8px; padding-top: 6px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; }
QScrollBar:vertical { background: transparent; width: 12px; margin: 0; border: none; }
QScrollBar:horizontal { background: transparent; height: 12px; margin: 0; border: none; }
QScrollBar::handle:vertical { background: ${ScrollbarSlider}; min-height: 24px; }
QScrollBar::handle:horizontal { background: ${ScrollbarSlider}; min-width: 24px; }
QScrollBar::handle:hover { background: ${ScrollbarSliderHover}; }
QScrollBar::handle:pressed { background: ${ScrollbarSliderActive}; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QTabBar { background: ${TabBar}; }
QTabBar::tab { background: ${TabInactive}; color: ${TabInactiveText}; padding: 5px 10px; border: none; border-right: 1px solid ${TabBar}; border-top: 1px solid transparent; }
QTabBar::tab:selected { background: ${TabActive}; color: ${TabActiveText}; border-top: 1px solid ${TabActiveBorder}; }
QTabBar::tab:hover:!selected { color: ${TabActiveText}; }
QTabBar::close-button { image: url(:/neverd/icons/close_small.svg); subcontrol-position: right; border-radius: 3px; padding: 1px; margin-left: 4px; }
QTabBar::close-button:hover { background: ${ToolBarHover}; }
QTabWidget::pane { border: none; }
QToolTip { background: ${ToolTipBase}; color: ${ToolTipText}; border: 1px solid ${MenuSeparator}; padding: 3px; }
QSplitter::handle { background: ${DockSeparator}; width: 1px; height: 1px; }
QSplitter::handle:hover, QSplitter::handle:pressed { background: ${DockSeparatorHover}; }
QAbstractScrollArea { border: none; }
QDialog#quickStartDialog { background: ${Base}; }
QLabel#quickStartTitle { color: ${QuickStartTitle}; }
QLabel#quickStartSubtitle, QCheckBox#quickStartAtStartup { color: ${QuickStartSecondaryText}; }
QLabel#quickStartVersion { color: ${QuickStartMetadataText}; }
QLabel#quickStartSection { color: ${QuickStartTitle}; }
QPushButton#quickStartAction, QPushButton#quickStartAction:default { background: transparent; border: none; padding: 0; }
QListWidget#quickStartRecent { background: transparent; border: none; outline: none; }
QScrollBar#quickStartScrollBar:vertical { width: 10px; }
QScrollBar#quickStartScrollBar::handle:vertical { border-radius: 3px; margin: 2px; min-height: 32px; }
