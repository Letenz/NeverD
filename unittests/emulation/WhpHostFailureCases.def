#ifdef NEVERD_WHP_BOUNDARY_BYTES
// Win64 arguments: input, output, original host state. Preserve the host FPU.
NEVERD_WHP_BOUNDARY_BYTES(HostRoundTrip, 0x49, 0x0f, 0xae, 0x00, 0x48, 0x0f,
                          0xae, 0x09, 0x48, 0x0f, 0xae, 0x02, 0x49, 0x0f, 0xae,
                          0x08, 0xc3)
// Win64 machine registers: RCX points to output, RDX to the input packet.
// Full program restores FP in the guest, saves it to RAM, then completes HLT.
NEVERD_WHP_BOUNDARY_BYTES(RestoreAndSave, 0x48, 0x0f, 0xae, 0x0a, 0x48, 0x0f,
                          0xae, 0x01, 0xf4)
NEVERD_WHP_BOUNDARY_BYTES(Save, 0x48, 0x0f, 0xae, 0x01, 0xf4)
// Set TF with PUSH 0x102 / POPFQ so the trap follows FXSAVE64, not FXRSTOR64.
NEVERD_WHP_BOUNDARY_BYTES(RestoreAndTrap, 0x48, 0x0f, 0xae, 0x0a, 0x68, 0x02,
                          0x01, 0x00, 0x00, 0x9d, 0x48, 0x0f, 0xae, 0x01, 0xf4)
NEVERD_WHP_BOUNDARY_BYTES(Trap, 0x68, 0x02, 0x01, 0x00, 0x00, 0x9d, 0x48, 0x0f,
                          0xae, 0x01, 0xf4)
#endif
