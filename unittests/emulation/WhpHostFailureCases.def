#ifdef NEVERD_WHP_RUN_FAILURE
NEVERD_WHP_RUN_FAILURE(
    E_FAIL, "WHP single-step execution failed (WHvRunVirtualProcessor; HRESULT "
            "0x80004005)")
NEVERD_WHP_RUN_FAILURE(
    E_ACCESSDENIED,
    "WHP single-step execution failed (WHvRunVirtualProcessor; HRESULT "
    "0x80070005)")
#endif
