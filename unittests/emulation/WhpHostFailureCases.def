#ifdef NEVERD_WHP_XSAVE_SIZE
// Actual byte count, capacity, independent legacy and modern diagnostics.
NEVERD_WHP_XSAVE_SIZE(
    575, 0,
    "invalid x64 floating-point state buffer "
    "(WHvGetVirtualProcessorXsaveState; returned bytes 575; capacity 0; "
    "admitted 576..65536)",
    "invalid x64 floating-point state buffer "
    "(WHvGetVirtualProcessorState; returned bytes 575; capacity 0; "
    "admitted 576..65536)")
NEVERD_WHP_XSAVE_SIZE(
    65537, 0,
    "invalid x64 floating-point state buffer "
    "(WHvGetVirtualProcessorXsaveState; returned bytes 65537; capacity 0; "
    "admitted 576..65536)",
    "invalid x64 floating-point state buffer "
    "(WHvGetVirtualProcessorState; returned bytes 65537; capacity 0; "
    "admitted 576..65536)")
NEVERD_WHP_XSAVE_SIZE(
    575, 576,
    "invalid x64 floating-point state buffer "
    "(WHvGetVirtualProcessorXsaveState; returned bytes 575; capacity 576; "
    "admitted 576..65536)",
    "invalid x64 floating-point state buffer "
    "(WHvGetVirtualProcessorState; returned bytes 575; capacity 576; "
    "admitted 576..65536)")
NEVERD_WHP_XSAVE_SIZE(
    577, 576,
    "invalid x64 floating-point state buffer "
    "(WHvGetVirtualProcessorXsaveState; returned bytes 577; capacity 576; "
    "admitted 576..65536)",
    "invalid x64 floating-point state buffer "
    "(WHvGetVirtualProcessorState; returned bytes 577; capacity 576; "
    "admitted 576..65536)")
#endif
