    "guest restore {0}; host pointer feature {1}; "
    "partition pointer feature {2}; explicit feature {3}; debug exit {4}; "
    "pending x87 {5}; host vendor {6}; host-process FOP {7:x}; "
    "host-process FIP {8:x}; host-process FDP {9:x}")
