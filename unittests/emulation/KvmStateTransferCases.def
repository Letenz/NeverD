//===- KvmStateTransferCases.def - Native capture failure fixtures --------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
#ifdef NEVERD_KVM_STATE_VALUE
NEVERD_KVM_STATE_VALUE(Code, 0x100000)
NEVERD_KVM_STATE_VALUE(Data, 0x200000)
NEVERD_KVM_STATE_VALUE(PageSize, 4096)
NEVERD_KVM_STATE_VALUE(Limit, 8 * 1024 * 1024)
NEVERD_KVM_STATE_VALUE(Timeout, 1'000'000)
NEVERD_KVM_STATE_VALUE(InitialFlags, 0x202)
NEVERD_KVM_STATE_VALUE(InitialInteger, 0x123456789abcdef0ULL)
NEVERD_KVM_STATE_VALUE(IntegerIncrement, 1)
NEVERD_KVM_STATE_VALUE(IncrementVectorIndex, 1)
NEVERD_KVM_STATE_VALUE(InitialPacked, 0x0101010101010101ULL)
NEVERD_KVM_STATE_VALUE(IncrementedPacked, 0x0202020202020202ULL)
NEVERD_KVM_STATE_VALUE(WordBytes, 8)
NEVERD_KVM_STATE_VALUE(RepeatedSteps, 32)
#endif
#ifdef NEVERD_KVM_STATE_TEXT
NEVERD_KVM_STATE_TEXT(SyncUnavailable,
                      "host lacks the requested KVM synchronized register set")
#endif
#ifdef NEVERD_KVM_STATE_CODE
NEVERD_KVM_STATE_CODE(Warm, 0x90)
NEVERD_KVM_STATE_CODE(StoreInteger, 0x48, 0x89, 0x07)
// INC RAX; NOP. A failed capture must not advance the retry's input.
NEVERD_KVM_STATE_CODE(IncrementInteger, 0x48, 0xff, 0xc0)
// PADDB XMM0,XMM1; NOP. Two executions without FP reinstall would add twice.
NEVERD_KVM_STATE_CODE(IncrementVector, 0x66, 0x0f, 0xfc, 0xc1)
// DIV RCX with a zero divisor must retain its actual CPU exception.
NEVERD_KVM_STATE_CODE(DivideInteger, 0x48, 0xf7, 0xf1)
#endif
// Names stay independent of host ioctl numbers and GoogleTest tuple rendering.
#ifdef NEVERD_KVM_STATE_BASE_PARAMETER
NEVERD_KVM_STATE_BASE_PARAMETER(IntegerRegistersIoctl, false, KVM_GET_REGS, 0)
NEVERD_KVM_STATE_BASE_PARAMETER(IntegerRegistersQueryFailure, false,
                                KVM_GET_REGS, -1)
NEVERD_KVM_STATE_BASE_PARAMETER(IntegerXsaveIoctl, false, KVM_GET_XSAVE, 0)
NEVERD_KVM_STATE_BASE_PARAMETER(IntegerXsaveQueryFailure, false, KVM_GET_XSAVE,
                                -1)
NEVERD_KVM_STATE_BASE_PARAMETER(VectorRegistersIoctl, true, KVM_GET_REGS, 0)
NEVERD_KVM_STATE_BASE_PARAMETER(VectorRegistersQueryFailure, true, KVM_GET_REGS,
                                -1)
NEVERD_KVM_STATE_BASE_PARAMETER(VectorXsaveIoctl, true, KVM_GET_XSAVE, 0)
NEVERD_KVM_STATE_BASE_PARAMETER(VectorXsaveQueryFailure, true, KVM_GET_XSAVE,
                                -1)
#endif
#ifdef NEVERD_KVM_STATE_SYNC_PARAMETER
NEVERD_KVM_STATE_SYNC_PARAMETER(IntegerRegistersSyncSpecial, false,
                                KVM_GET_REGS, KVM_SYNC_X86_SREGS)
NEVERD_KVM_STATE_SYNC_PARAMETER(IntegerXsaveSyncGeneral, false, KVM_GET_XSAVE,
                                KVM_SYNC_X86_REGS)
NEVERD_KVM_STATE_SYNC_PARAMETER(IntegerXsaveSyncSpecial, false, KVM_GET_XSAVE,
                                KVM_SYNC_X86_SREGS)
NEVERD_KVM_STATE_SYNC_PARAMETER(IntegerXsaveSyncBoth, false, KVM_GET_XSAVE,
                                KVM_SYNC_X86_REGS | KVM_SYNC_X86_SREGS)
NEVERD_KVM_STATE_SYNC_PARAMETER(VectorRegistersSyncSpecial, true, KVM_GET_REGS,
                                KVM_SYNC_X86_SREGS)
NEVERD_KVM_STATE_SYNC_PARAMETER(VectorXsaveSyncGeneral, true, KVM_GET_XSAVE,
                                KVM_SYNC_X86_REGS)
NEVERD_KVM_STATE_SYNC_PARAMETER(VectorXsaveSyncSpecial, true, KVM_GET_XSAVE,
                                KVM_SYNC_X86_SREGS)
NEVERD_KVM_STATE_SYNC_PARAMETER(VectorXsaveSyncBoth, true, KVM_GET_XSAVE,
                                KVM_SYNC_X86_REGS | KVM_SYNC_X86_SREGS)
#endif
