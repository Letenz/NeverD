//===- driver_resource_double_shift.def - Original WDK shift probes -------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
#ifdef NEVERD_RESOURCE_DOUBLE_SHIFT_CASE
#define NEVERD_RESOURCE_DOUBLE_SHIFT_CODE(Instruction)                         \
  "pushfq; popq %0; pushq %3; popfq; " Instruction                             \
  "; pushfq; popq %1; pushq %0; popfq"
NEVERD_RESOURCE_DOUBLE_SHIFT_CASE(
    Left16Register, 0x1234567887654321ULL, 0xfedcba9876543210ULL, 5,
    0x1234567887656426ULL, 0x602, 0x6c7,
    NEVERD_RESOURCE_DOUBLE_SHIFT_CODE("shldw %%cl, %w4, %w2"), "+a")
NEVERD_RESOURCE_DOUBLE_SHIFT_CASE(
    Left16Memory, 0x1234567887654321ULL, 0xfedcba9876543210ULL, 5,
    0x1234567887656426ULL, 0x602, 0x6c7,
    NEVERD_RESOURCE_DOUBLE_SHIFT_CODE("shldw %%cl, %w4, %w2"), "+m")
NEVERD_RESOURCE_DOUBLE_SHIFT_CASE(
    Left32Register, 0x1234567887654321ULL, 0xfedcba9876543210ULL, 5,
    0xeca8642eULL, 0x686, 0x6c7,
    NEVERD_RESOURCE_DOUBLE_SHIFT_CODE("shldl %%cl, %k4, %k2"), "+a")
NEVERD_RESOURCE_DOUBLE_SHIFT_CASE(
    Left32Memory, 0x1234567887654321ULL, 0xfedcba9876543210ULL, 5,
    0x12345678eca8642eULL, 0x686, 0x6c7,
    NEVERD_RESOURCE_DOUBLE_SHIFT_CODE("shldl %%cl, %k4, %k2"), "+m")
NEVERD_RESOURCE_DOUBLE_SHIFT_CASE(
    Left64Register, 0x1234567887654321ULL, 0xfedcba9876543210ULL, 5,
    0x468acf10eca8643fULL, 0x606, 0x6c7,
    NEVERD_RESOURCE_DOUBLE_SHIFT_CODE("shldq %%cl, %q4, %q2"), "+a")
NEVERD_RESOURCE_DOUBLE_SHIFT_CASE(
    Left64Memory, 0x1234567887654321ULL, 0xfedcba9876543210ULL, 5,
    0x468acf10eca8643fULL, 0x606, 0x6c7,
    NEVERD_RESOURCE_DOUBLE_SHIFT_CODE("shldq %%cl, %q4, %q2"), "+m")
NEVERD_RESOURCE_DOUBLE_SHIFT_CASE(
    Right16Register, 0x1234567887654321ULL, 0xfedcba9876543210ULL, 5,
    0x1234567887658219ULL, 0x682, 0x6c7,
    NEVERD_RESOURCE_DOUBLE_SHIFT_CODE("shrdw %%cl, %w4, %w2"), "+a")
NEVERD_RESOURCE_DOUBLE_SHIFT_CASE(
    Right16Memory, 0x1234567887654321ULL, 0xfedcba9876543210ULL, 5,
    0x1234567887658219ULL, 0x682, 0x6c7,
    NEVERD_RESOURCE_DOUBLE_SHIFT_CODE("shrdw %%cl, %w4, %w2"), "+m")
NEVERD_RESOURCE_DOUBLE_SHIFT_CASE(
    Right32Register, 0x1234567887654321ULL, 0xfedcba9876543210ULL, 5,
    0x843b2a19ULL, 0x682, 0x6c7,
    NEVERD_RESOURCE_DOUBLE_SHIFT_CODE("shrdl %%cl, %k4, %k2"), "+a")
NEVERD_RESOURCE_DOUBLE_SHIFT_CASE(
    Right32Memory, 0x1234567887654321ULL, 0xfedcba9876543210ULL, 5,
    0x12345678843b2a19ULL, 0x682, 0x6c7,
    NEVERD_RESOURCE_DOUBLE_SHIFT_CODE("shrdl %%cl, %k4, %k2"), "+m")
NEVERD_RESOURCE_DOUBLE_SHIFT_CASE(
    Right64Register, 0x1234567887654321ULL, 0xfedcba9876543210ULL, 5,
    0x8091a2b3c43b2a19ULL, 0x682, 0x6c7,
    NEVERD_RESOURCE_DOUBLE_SHIFT_CODE("shrdq %%cl, %q4, %q2"), "+a")
NEVERD_RESOURCE_DOUBLE_SHIFT_CASE(
    Right64Memory, 0x1234567887654321ULL, 0xfedcba9876543210ULL, 5,
    0x8091a2b3c43b2a19ULL, 0x682, 0x6c7,
    NEVERD_RESOURCE_DOUBLE_SHIFT_CODE("shrdq %%cl, %q4, %q2"), "+m")
#undef NEVERD_RESOURCE_DOUBLE_SHIFT_CODE
#endif
