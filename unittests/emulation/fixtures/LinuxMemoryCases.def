#ifdef NEVERD_LINUX_MEMORY_BYTES
// x64: mov eax,41/73; ret. Replacing code at one VA must invalidate old code.
NEVERD_LINUX_MEMORY_BYTES(FirstCode, 0xb8, 0x29, 0x00, 0x00, 0x00, 0xc3)
NEVERD_LINUX_MEMORY_BYTES(SecondCode, 0xb8, 0x49, 0x00, 0x00, 0x00, 0xc3)
#endif
