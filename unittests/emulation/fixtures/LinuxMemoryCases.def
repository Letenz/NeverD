#ifdef NEVERD_LINUX_MEMORY_SERVICE
#if defined(__aarch64__)
NEVERD_LINUX_MEMORY_SERVICE(Mmap, 222)
NEVERD_LINUX_MEMORY_SERVICE(Mprotect, 226)
NEVERD_LINUX_MEMORY_SERVICE(Munmap, 215)
NEVERD_LINUX_MEMORY_SERVICE(Brk, 214)
NEVERD_LINUX_MEMORY_SERVICE(Write, 64)
NEVERD_LINUX_MEMORY_SERVICE(Exit, 93)
#else
NEVERD_LINUX_MEMORY_SERVICE(Mmap, 9)
NEVERD_LINUX_MEMORY_SERVICE(Mprotect, 10)
NEVERD_LINUX_MEMORY_SERVICE(Munmap, 11)
NEVERD_LINUX_MEMORY_SERVICE(Brk, 12)
NEVERD_LINUX_MEMORY_SERVICE(Write, 1)
NEVERD_LINUX_MEMORY_SERVICE(Exit, 60)
#endif
