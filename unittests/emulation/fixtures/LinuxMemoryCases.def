NEVERD_LINUX_MEMORY_VALUE(HeapPages, 2)
NEVERD_LINUX_MEMORY_VALUE(FirstByte, 41)
NEVERD_LINUX_MEMORY_VALUE(SecondByte, 73)
NEVERD_LINUX_MEMORY_VALUE(HeapOffset, 16)
NEVERD_LINUX_MEMORY_VALUE(ProtRead, 1)
NEVERD_LINUX_MEMORY_VALUE(ProtWrite, 2)
NEVERD_LINUX_MEMORY_VALUE(ProtExecute, 4)
NEVERD_LINUX_MEMORY_VALUE(PrivateAnonymous, 0x22)
NEVERD_LINUX_MEMORY_VALUE(MapFixed, 0x10)
NEVERD_LINUX_MEMORY_VALUE(InvalidArgument, 22)
NEVERD_LINUX_MEMORY_VALUE(NoMemory, 12)
NEVERD_LINUX_MEMORY_VALUE(BadAddress, 14)
NEVERD_LINUX_MEMORY_VALUE(FailureStatus, 90)
NEVERD_LINUX_MEMORY_VALUE(ExitStatus, 0)
NEVERD_LINUX_MEMORY_VALUE(StandardOutput, 1)
NEVERD_LINUX_MEMORY_VALUE(InstructionLimit, 100000)
NEVERD_LINUX_MEMORY_VALUE(UnitLimit, 8 * PageSize)
NEVERD_LINUX_MEMORY_VALUE(UnitHeap, 0x200000)
NEVERD_LINUX_MEMORY_VALUE(UnitHint, 0x800000)
NEVERD_LINUX_MEMORY_VALUE(UserLimit, 0x0000800000000000ULL)
NEVERD_LINUX_MEMORY_VALUE(CheckMap, 1)
NEVERD_LINUX_MEMORY_VALUE(CheckZero, 2)
NEVERD_LINUX_MEMORY_VALUE(CheckProtect, 3)
NEVERD_LINUX_MEMORY_VALUE(CheckHole, 4)
NEVERD_LINUX_MEMORY_VALUE(CheckRemap, 5)
NEVERD_LINUX_MEMORY_VALUE(CheckHeap, 6)
NEVERD_LINUX_MEMORY_VALUE(CheckErrors, 7)
NEVERD_LINUX_MEMORY_VALUE(CheckCode, 8)
#endif
#ifdef NEVERD_LINUX_MEMORY_TEXT
NEVERD_LINUX_MEMORY_TEXT(Message, "anonymous memory ok\n")
NEVERD_LINUX_MEMORY_TEXT(ExecutableName, "memory-fixture")
NEVERD_LINUX_MEMORY_TEXT(Normal, "normal")
NEVERD_LINUX_MEMORY_TEXT(ProtectionFault, "fault")
NEVERD_LINUX_MEMORY_TEXT(HoleFault, "hole")
