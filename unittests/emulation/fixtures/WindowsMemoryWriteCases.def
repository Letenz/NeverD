                             WrittenSeed, ReadOnly, ExecuteReadWrite,
                             InitialFirst, InitialSecond)
NEVERD_MEMORY_WRITE_EXPECTED(ReadWrite, NoAccess, 0, ErrorPartialCopy,
                             PrefixSize, ReadWrite, NoAccess, UpdatedFirst,
                             InitialSecond)
NEVERD_MEMORY_WRITE_EXPECTED(ReadWrite, ReadOnly, 0, ErrorPartialCopy,
                             PrefixSize, ReadWrite, ReadOnly, UpdatedFirst,
                             InitialSecond)
NEVERD_MEMORY_WRITE_EXPECTED(ReadWrite, ReadWrite, 1, LastErrorSeed, WriteSize,
                             ReadWrite, ReadWrite, UpdatedFirst, UpdatedSecond)
NEVERD_MEMORY_WRITE_EXPECTED(ReadWrite, ExecuteRead, 0, ErrorPartialCopy,
                             PrefixSize, ReadWrite, ExecuteRead, UpdatedFirst,
