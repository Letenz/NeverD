NEVERD_MEMORY_WRITE_EXPECTED(ExecuteRead, ReadOnly, 1, LastErrorSeed,
                             PrefixSize, ExecuteRead, ReadOnly, UpdatedFirst,
                             InitialSecond)
NEVERD_MEMORY_WRITE_EXPECTED(ExecuteRead, ReadWrite, 1, LastErrorSeed,
                             WriteSize, ExecuteRead, ReadWrite, UpdatedFirst,
                             UpdatedSecond)
NEVERD_MEMORY_WRITE_EXPECTED(ExecuteRead, ExecuteRead, 1, LastErrorSeed,
                             WriteSize, ExecuteRead, ExecuteRead, UpdatedFirst,
                             UpdatedSecond)
NEVERD_MEMORY_WRITE_EXPECTED(ExecuteRead, ExecuteReadWrite, 1, LastErrorSeed,
                             WriteSize, ExecuteRead, ExecuteReadWrite,
                             UpdatedFirst, UpdatedSecond)
NEVERD_MEMORY_WRITE_EXPECTED(ExecuteReadWrite, NoAccess, 0, ErrorPartialCopy,
