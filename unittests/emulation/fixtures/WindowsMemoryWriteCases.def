// Windows x64 10.0.26100 and ARM64 10.0.26200 agree on every field. Preserve
// partial writes even when the wrapper returns success after an RX prefix.
#ifdef NEVERD_MEMORY_WRITE_EXPECTED
NEVERD_MEMORY_WRITE_EXPECTED(NoAccess, NoAccess, 0, ErrorNoAccess, WrittenSeed,
                             NoAccess, NoAccess, InitialFirst, InitialSecond)
NEVERD_MEMORY_WRITE_EXPECTED(NoAccess, ReadOnly, 0, ErrorNoAccess, WrittenSeed,
                             NoAccess, ReadOnly, InitialFirst, InitialSecond)
NEVERD_MEMORY_WRITE_EXPECTED(NoAccess, ReadWrite, 0, ErrorNoAccess, WrittenSeed,
                             NoAccess, ReadWrite, InitialFirst, InitialSecond)
