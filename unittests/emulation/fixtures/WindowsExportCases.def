#ifdef NEVERD_EXPORT_ASM
#if defined(_M_X64) || defined(__x86_64__)
NEVERD_EXPORT_ASM(ReadTEB, "movq %%gs:0x30, %0")
#else
NEVERD_EXPORT_ASM(ReadTEB, "mov %0, x18")
#endif
#endif
#ifdef NEVERD_EXPORT_WIDE
NEVERD_EXPORT_WIDE(LeafName, L"LOOKUP-LEAF.DLL")
NEVERD_EXPORT_WIDE(BridgeName, L"lookup-bridge")
NEVERD_EXPORT_WIDE(TopModuleName, L"lookup-top.dll")
#endif
#ifdef NEVERD_EXPORT_LEAF
NEVERD_EXPORT_LEAF(Probe, "@1")
NEVERD_EXPORT_LEAF(Alias, "=Probe @2")
NEVERD_EXPORT_LEAF(Value, "@3 DATA")
NEVERD_EXPORT_LEAF(OrdinalProbe, "@7 NONAME")
#endif
#ifdef NEVERD_EXPORT_BRIDGE
NEVERD_EXPORT_BRIDGE(ForwardName, "=lookup-leaf.Probe @1")
NEVERD_EXPORT_BRIDGE(ForwardOrdinal, "=lookup-leaf.#7 @2")
NEVERD_EXPORT_BRIDGE(ForwardData, "=lookup-leaf.Value @3 DATA")
NEVERD_EXPORT_BRIDGE(ForwardPID, "=kernel32.GetCurrentProcessId @4")
NEVERD_EXPORT_BRIDGE(Self, "=lookup-bridge.ForwardName @5")
NEVERD_EXPORT_BRIDGE(Unused, "=absent.Missing @6")
NEVERD_EXPORT_BRIDGE(WithExtension, "=lookup-leaf.dll.Probe @7")
NEVERD_EXPORT_BRIDGE(CycleA, "=lookup-bridge.CycleB @8")
NEVERD_EXPORT_BRIDGE(CycleB, "=lookup-bridge.CycleA @9")
NEVERD_EXPORT_BRIDGE(BadOrdinal, "=lookup-leaf.#65536 @10")
#endif
#ifdef NEVERD_EXPORT_TOP
NEVERD_EXPORT_TOP(TopProbe, "=lookup-bridge.Self @1")
NEVERD_EXPORT_TOP(TopOrdinal, "=lookup-bridge.ForwardOrdinal @2")
NEVERD_EXPORT_TOP(TopData, "=lookup-bridge.ForwardData @3 DATA")
NEVERD_EXPORT_TOP(TopPID, "=lookup-bridge.ForwardPID @4")
#endif
