NEVERD_USER_SEH_VALUE(FilterTrace, 2)
NEVERD_USER_SEH_VALUE(FinallyTrace, 3)
NEVERD_USER_SEH_VALUE(HandlerTrace, 4)
NEVERD_USER_SEH_VALUE(ResumeTrace, 5)
NEVERD_USER_SEH_VALUE(LocalHandlerTrace, 6)
NEVERD_USER_SEH_VALUE(ContinueTrace, 9)
NEVERD_USER_SEH_VALUE(VectoredTrace, 10)
NEVERD_USER_SEH_VALUE(ContextRCX, 128)
NEVERD_USER_SEH_VALUE(PageReadWrite, 4)
NEVERD_USER_SEH_VALUE(DOSNTOffset, 60)
NEVERD_USER_SEH_VALUE(ExceptionDirectoryOffset, 160)
NEVERD_USER_SEH_VALUE(InstructionLimit, 200000)
