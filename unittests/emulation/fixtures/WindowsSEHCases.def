#ifdef NEVERD_USER_SEH_BUILD
NEVERD_USER_SEH_BUILD(OutputDirectory, "windows-seh-fixtures")
NEVERD_USER_SEH_BUILD(Target, "x86_64-pc-windows-msvc")
NEVERD_USER_SEH_BUILD(Machine, "x64")
NEVERD_USER_SEH_BUILD(Entry, "entry")
NEVERD_USER_SEH_BUILD(Base, "0x140000000")
NEVERD_USER_SEH_BUILD(Kernel, "kernel32.dll")
NEVERD_USER_SEH_BUILD(Native, "ntdll.dll")
NEVERD_USER_SEH_BUILD(Personality, "__C_specific_handler")
#endif
#ifdef NEVERD_USER_SEH_ASM
NEVERD_USER_SEH_ASM(
    ".text\n.globl ReadFault\nReadFault:\nmovq (%rcx), %rax\nretq\n")
#endif
