#ifdef NEVERD_USER_SEH_PROBE
NEVERD_USER_SEH_PROBE(SecondarySame, 'b', "!b")
NEVERD_USER_SEH_PROBE(SecondarySearch, 'i', "!i")
NEVERD_USER_SEH_PROBE(SecondaryFinally, 'j', "!j")
NEVERD_USER_SEH_PROBE(SecondaryVectored, 'v', "!v")
NEVERD_USER_SEH_PROBE(SecondaryRepeat, 'r', "!r")
NEVERD_USER_SEH_PROBE(SecondaryRedirect, 'd', "!d")
NEVERD_USER_SEH_PROBE(SecondaryUnwind, 'w', "!w")
NEVERD_USER_SEH_PROBE(SecondaryDLL, 'k', "!k")
NEVERD_USER_SEH_PROBE(SecondaryDLLHandler, 'h', "!h")
#endif
#ifdef NEVERD_USER_SEH_CASE
NEVERD_USER_SEH_CASE(Catch, 'C', "!C", 0x4)
NEVERD_USER_SEH_CASE(Helper, 'H', "!H", 0x24)
NEVERD_USER_SEH_CASE(Search, 'S', "!S", 0x124)
NEVERD_USER_SEH_CASE(Finally, 'F', "!F", 0x234)
NEVERD_USER_SEH_CASE(VectoredFirst, 'V', "!V", 0xa24)
NEVERD_USER_SEH_CASE(Continue, 'R', "!R", 0x295)
NEVERD_USER_SEH_CASE(ReadFault, 'D', "!D", 0x24)
NEVERD_USER_SEH_CASE(RepairFault, 'P', "!P", 0x295)
NEVERD_USER_SEH_CASE(CrossImage, 'X', "!X", 0x234)
NEVERD_USER_SEH_CASE(DLLHandler, 'Y', "!Y", 0x245)
NEVERD_USER_SEH_CASE(NestedFilter, 'N', "!N", 0x124)
NEVERD_USER_SEH_CASE(LocalNested, 'L', "!L", 0x264)
NEVERD_USER_SEH_CASE(CollidedFinally, 'U', "!U", 0x2324)
NEVERD_USER_SEH_CASE(NoncontinuableCatch, 'Q', "!Q", 0x24)
#endif
#ifdef NEVERD_USER_SEH_NEGATIVE
NEVERD_USER_SEH_NEGATIVE(Metadata, 'M', "!M", ExceptionMetadataChanged)
NEVERD_USER_SEH_NEGATIVE(Retired, 'T', "!T", ExceptionModuleRetired)
NEVERD_USER_SEH_NEGATIVE(Noncontinuable, 'B', "!B",
                         ExceptionNoncontinuableFilter)
#endif
