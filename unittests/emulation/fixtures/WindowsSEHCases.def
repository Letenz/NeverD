NEVERD_USER_SEH_VALUE(ContextSP, 152)
NEVERD_USER_SEH_VALUE(ContextPC, 248)
NEVERD_USER_SEH_VALUE(MaxObservations, 16)
NEVERD_USER_SEH_VALUE(ContextSize, 1232)
