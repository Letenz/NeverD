#ifdef NEVERD_USER_SEH_TEXT
NEVERD_USER_SEH_TEXT(ProgramFile, "user-seh.exe")
NEVERD_USER_SEH_TEXT(LibraryFile, "user-seh.dll")
NEVERD_USER_SEH_TEXT(DLLRaiseName, "RaiseFromDLL")
NEVERD_USER_SEH_TEXT(DLLCatchName, "CatchInDLL")
