// Naked tail calls preserve the original WDK signatures and stack layout.
// Only undefined argument-register bits change before the real API import.
#ifdef NEVERD_MULTI_WAIT_INITIALIZE_SEMAPHORE_ASM
NEVERD_MULTI_WAIT_INITIALIZE_SEMAPHORE_ASM(
    "movabsq $0xa5a55a5a00000000, %rax\n\t"
    "orq %rax, %rdx\n\t"
    "orq %rax, %r8\n\t"
    "jmpq *__imp_KeInitializeSemaphore(%rip)\n\t")
#endif
#ifdef NEVERD_MULTI_WAIT_RELEASE_SEMAPHORE_ASM
NEVERD_MULTI_WAIT_RELEASE_SEMAPHORE_ASM(
    "movabsq $0xa5a55a5a00000000, %rax\n\t"
    "orq %rax, %rdx\n\t"
    "orq %rax, %r8\n\t"
    "orq %rax, %r9\n\t"
    "jmpq *__imp_KeReleaseSemaphore(%rip)\n\t")
#endif
#ifdef NEVERD_MULTI_WAIT_INITIALIZE_MUTEX_ASM
NEVERD_MULTI_WAIT_INITIALIZE_MUTEX_ASM(
    "movabsq $0xa5a55a5a00000000, %rax\n\t"
    "orq %rax, %rdx\n\t"
    "jmpq *__imp_KeInitializeMutex(%rip)\n\t")
#endif

