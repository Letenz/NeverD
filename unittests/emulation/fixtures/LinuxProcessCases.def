#ifndef NEVERD_LINUX_FIXTURE_PAGE_SIZE
#define NEVERD_LINUX_FIXTURE_PAGE_SIZE 4096
#define NEVERD_LINUX_FIXTURE_INITIAL_DATA 0x1020304050607080ULL
#endif
#ifdef NEVERD_LINUX_FIXTURE_VALUE
NEVERD_LINUX_FIXTURE_VALUE(PageSize, NEVERD_LINUX_FIXTURE_PAGE_SIZE)
NEVERD_LINUX_FIXTURE_VALUE(InitialData, NEVERD_LINUX_FIXTURE_INITIAL_DATA)
NEVERD_LINUX_FIXTURE_VALUE(StackAlignment, 16)
NEVERD_LINUX_FIXTURE_VALUE(StandardOutput, 1)
NEVERD_LINUX_FIXTURE_VALUE(StandardError, 2)
NEVERD_LINUX_FIXTURE_VALUE(ExitStatus, 37)
NEVERD_LINUX_FIXTURE_VALUE(FailureStatus, 91)
NEVERD_LINUX_FIXTURE_VALUE(UnknownService, 65535)
NEVERD_LINUX_FIXTURE_VALUE(BadAddress, 1)
NEVERD_LINUX_FIXTURE_VALUE(BadFD, 123)
NEVERD_LINUX_FIXTURE_VALUE(ErrorFault, 14)
NEVERD_LINUX_FIXTURE_VALUE(ErrorDescriptor, 9)
NEVERD_LINUX_FIXTURE_VALUE(PageszTag, 6)
NEVERD_LINUX_FIXTURE_VALUE(PhdrTag, 3)
NEVERD_LINUX_FIXTURE_VALUE(PhentTag, 4)
NEVERD_LINUX_FIXTURE_VALUE(RandomTag, 25)
NEVERD_LINUX_FIXTURE_VALUE(PhdrEntrySize, 56)
NEVERD_LINUX_FIXTURE_VALUE(MaxAuxEntries, 64)
NEVERD_LINUX_FIXTURE_VALUE(RandomSize, 16)
NEVERD_LINUX_FIXTURE_VALUE(ExpectedArgc, 2)
#endif
#ifdef NEVERD_LINUX_FIXTURE_TEXT
NEVERD_LINUX_FIXTURE_TEXT(Message, "linux process ok\n")
NEVERD_LINUX_FIXTURE_TEXT(Environment, "NEVERD_GUEST=explicit")
NEVERD_LINUX_FIXTURE_TEXT(ExecutableName, "fixture")
NEVERD_LINUX_FIXTURE_TEXT(Tail, "tail")
NEVERD_LINUX_FIXTURE_TEXT(MissingTools, "Clang and ld.lld are required for ELF process fixtures")
#endif
#ifdef NEVERD_LINUX_FIXTURE_BYTES
NEVERD_LINUX_FIXTURE_BYTES(BinaryOutput, 0, 0xff, 0x7f)
#endif
#ifdef NEVERD_LINUX_FIXTURE_MODE
NEVERD_LINUX_FIXTURE_MODE(Normal, 'n', "normal")
NEVERD_LINUX_FIXTURE_MODE(Loop, 'l', "loop")
NEVERD_LINUX_FIXTURE_MODE(Fault, 'f', "fault")
NEVERD_LINUX_FIXTURE_MODE(Unknown, 'u', "unknown")
NEVERD_LINUX_FIXTURE_MODE(Partial, 'p', "partial")
NEVERD_LINUX_FIXTURE_MODE(ReadOnly, 'r', "readonly")
#endif
#ifdef NEVERD_LINUX_FIXTURE_SERVICE
#if defined(__aarch64__)
NEVERD_LINUX_FIXTURE_SERVICE(Write, 64)
NEVERD_LINUX_FIXTURE_SERVICE(Exit, 93)
NEVERD_LINUX_FIXTURE_SERVICE(GetPID, 172)
NEVERD_LINUX_FIXTURE_SERVICE(GetTID, 178)
#else
NEVERD_LINUX_FIXTURE_SERVICE(Write, 1)
NEVERD_LINUX_FIXTURE_SERVICE(Exit, 60)
NEVERD_LINUX_FIXTURE_SERVICE(GetPID, 39)
NEVERD_LINUX_FIXTURE_SERVICE(GetTID, 186)
#endif
#endif
