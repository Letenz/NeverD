NEVERD_SEH_MUTEX_VALUE(SehMutexShortQuantum, 17)
NEVERD_SEH_MUTEX_VALUE(SehMutexDelay, 16384)
NEVERD_SEH_MUTEX_VALUE(SehMutexFilterStage, 1)
NEVERD_SEH_MUTEX_VALUE(SehMutexFinallyStage, 2)
NEVERD_SEH_MUTEX_VALUE(SehMutexHandledStage, 3)
NEVERD_SEH_MUTEX_VALUE(SehMutexInstructionLimit, 200000)
NEVERD_SEH_MUTEX_VALUE(SehMutexPoolType, 0)
NEVERD_SEH_MUTEX_VALUE(SehMutexPoolTag, 0x4d555458)
NEVERD_SEH_MUTEX_VALUE(SehMutexChildOffset, 0x1000)
NEVERD_SEH_MUTEX_VALUE(SehMutexPeerOffset, 0x2000)
NEVERD_SEH_MUTEX_VALUE(SehMutexOtherOffset, 0x3000)
#endif

