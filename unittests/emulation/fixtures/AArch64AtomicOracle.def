// Name, offset selector (0: aligned, 1: within block, 2: crossing block),
// protected page, split-page window, compare mismatch.
#ifdef NEVERD_ATOMIC_ORACLE_SCENARIO
NEVERD_ATOMIC_ORACLE_SCENARIO(Aligned, 0, PageReadWrite, 0, 0)
NEVERD_ATOMIC_ORACLE_SCENARIO(WithinBlock, 1, PageReadWrite, 0, 0)
NEVERD_ATOMIC_ORACLE_SCENARIO(CrossingBlock, 2, PageReadWrite, 0, 0)
NEVERD_ATOMIC_ORACLE_SCENARIO(ReadOnly, 0, PageReadOnly, 0, 0)
NEVERD_ATOMIC_ORACLE_SCENARIO(NoAccess, 0, PageNoAccess, 0, 0)
NEVERD_ATOMIC_ORACLE_SCENARIO(Mismatch, 0, PageReadWrite, 0, 1)
NEVERD_ATOMIC_ORACLE_SCENARIO(MismatchReadOnly, 0, PageReadOnly, 0, 1)
NEVERD_ATOMIC_ORACLE_SCENARIO(SplitReadOnly, 2, PageReadOnly, 1, 0)
NEVERD_ATOMIC_ORACLE_SCENARIO(SplitNoAccess, 2, PageNoAccess, 1, 0)
#endif
