NEVERD_SEH_SIMD_VALUE(SehSIMDTrap, 0x100)
NEVERD_SEH_SIMD_VALUE(SehSIMDBefore, 1)
NEVERD_SEH_SIMD_VALUE(SehSIMDFinally, 2)
