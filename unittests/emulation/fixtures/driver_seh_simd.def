NEVERD_SEH_SIMD_TEXT(SehSIMDCheckedSuffix, "_checked_")
NEVERD_SEH_SIMD_TEXT(SehSIMDFilterMessage,
                     "WDM SEH: SIMD filter code=%08lx mode=%c\n")
NEVERD_SEH_SIMD_TEXT(SehSIMDFinallyMessage,
                     "WDM SEH: SIMD finally abnormal=%u\n")
NEVERD_SEH_SIMD_TEXT(SehSIMDCompleteMessage,
                     "WDM SEH: SIMD verified case=%lu\n")
NEVERD_SEH_SIMD_TEXT(SehSIMDFailure, "WDM SEH: failure")
NEVERD_SEH_SIMD_TEXT(SehSIMDMissing, "original WDK SEH fixture unavailable")
#endif
#ifndef NEVERD_SEH_SIMD_EXECUTE
#define NEVERD_SEH_SIMD_SETUP                                                  \
  "movdqu %[Seed], %%xmm0\n\t"                                                 \
  "movdqa %%xmm0, %%xmm1\n\t"                                                  \
  "movdqa %%xmm0, %%xmm2\n\t"                                                  \
  "movdqa %%xmm0, %%xmm3\n\t"                                                  \
  "movdqa %%xmm0, %%xmm4\n\t"                                                  \
  "movdqa %%xmm0, %%xmm5\n\t"                                                  \
  "movdqa %%xmm0, %%xmm6\n\t"                                                  \
  "movdqa %%xmm0, %%xmm7\n\t"                                                  \
  "movdqa %%xmm0, %%xmm8\n\t"                                                  \
  "movdqa %%xmm0, %%xmm9\n\t"                                                  \
  "movdqa %%xmm0, %%xmm10\n\t"                                                 \
  "movdqa %%xmm0, %%xmm11\n\t"                                                 \
  "movdqa %%xmm0, %%xmm12\n\t"                                                 \
  "movdqa %%xmm0, %%xmm13\n\t"                                                 \
  "movdqa %%xmm0, %%xmm14\n\t"                                                 \
  "movdqa %%xmm0, %%xmm15\n\t"                                                 \
  "movdqu %[Left], %%xmm0\n\t"                                                 \
  "movdqu %[Right], %%xmm1\n\t"                                                \
  "ldmxcsr %[Control]\n\t"                                                     \
  "std\n\t"
#define NEVERD_SEH_SIMD_DIVIDE "divss %%xmm1, %%xmm0\n\t"
#define NEVERD_SEH_SIMD_ADD "addss %%xmm1, %%xmm0\n\t"
#define NEVERD_SEH_SIMD_MULTIPLY "mulss %%xmm1, %%xmm0\n\t"
#define NEVERD_SEH_SIMD_CAPTURE                                                \
  "pushfq\n\t"                                                                 \
  "popq %[Flags]\n\t"                                                          \
  "cld\n\t"                                                                    \
  "stmxcsr %[After]\n\t"                                                       \
  "movdqu %%xmm0, %[Result]\n\t"                                               \
  "movdqu %%xmm5, %[Volatile]\n\t"                                             \
  "movdqu %%xmm15, %[Nonvolatile]\n\t"                                         \
  "ldmxcsr %[Default]\n\t"
#define NEVERD_SEH_SIMD_EXECUTE(Operation)                                     \
  __asm__ volatile(NEVERD_SEH_SIMD_SETUP Operation NEVERD_SEH_SIMD_CAPTURE     \
                   : [Result] "=m"(SimdResult), [After] "=m"(SimdAfter),       \
                     [Flags] "=&r"(SimdFlags), [Volatile] "=m"(SimdVolatile),  \
                     [Nonvolatile] "=m"(SimdNonvolatile)                       \
                   : [Seed] "m"(Seed), [Left] "m"(Left), [Right] "m"(Right),   \
                     [Control] "m"(Control), [Default] "m"(Default)            \
                   : "cc", "xmm0", "xmm1", "xmm2", "xmm3", "xmm4", "xmm5",     \
                     "xmm6", "xmm7", "xmm8", "xmm9", "xmm10", "xmm11",         \
                     "xmm12", "xmm13", "xmm14", "xmm15")
#define NEVERD_SEH_SIMD_LIVE                                                   \
  "stmxcsr %0\n\t"                                                             \
  "pushfq\n\t"                                                                 \
  "popq %1\n\t"
#define NEVERD_SEH_SIMD_CLOBBER                                                \
  "pxor %%xmm0, %%xmm0\n\t"                                                    \
  "pxor %%xmm1, %%xmm1\n\t"                                                    \
  "pxor %%xmm5, %%xmm5\n\t"
#endif
