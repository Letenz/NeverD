#ifdef NEVERD_SEH_SIMD_CASE
// Operation, unmasked condition, operands, retained/masked status, masked
// result and Windows status. Arithmetic facts come from original x64 probes;
// the Windows kernel classifier was checked independently of the OS model.
NEVERD_SEH_SIMD_CASE(Invalid, SehSIMDDivide, 1, 0, 0, 1, 1, 0xffc00000,
                     0xc0000090)
NEVERD_SEH_SIMD_CASE(Denormal, SehSIMDAdd, 2, 1, 0, 2, 2, 1, 0xc0000090)
NEVERD_SEH_SIMD_CASE(Zero, SehSIMDDivide, 4, 0x3f800000, 0, 4, 4, 0x7f800000,
                     0xc000008e)
NEVERD_SEH_SIMD_CASE(Overflow, SehSIMDMultiply, 8, 0x7f7fffff, 0x7f7fffff, 0x28,
                     0x28, 0x7f800000, 0xc0000091)
NEVERD_SEH_SIMD_CASE(Underflow, SehSIMDMultiply, 16, 0x00800000, 0x00800000,
                     0x10, 0x30, 0, 0xc0000093)
NEVERD_SEH_SIMD_CASE(ExactTiny, SehSIMDMultiply, 16, 0x00800000, 0x3f000000,
                     0x10, 0, 0x00400000, 0xc0000093)
NEVERD_SEH_SIMD_CASE(ExactOverflow, SehSIMDMultiply, 8, 0x7f7fffff, 0x40000000,
                     0x08, 0x28, 0x7f800000, 0xc0000091)
NEVERD_SEH_SIMD_CASE(Precision, SehSIMDDivide, 32, 0x3f800000, 0x40400000, 0x20,
                     0x20, 0x3eaaaaab, 0xc000008f)
#endif
