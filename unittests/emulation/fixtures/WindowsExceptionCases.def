// Independent fixture ABI facts; native SDK assertions verify these offsets.
#ifdef NEVERD_VEH_CONTEXT_X64
NEVERD_VEH_CONTEXT_X64(ContextSize, 1232)
NEVERD_VEH_CONTEXT_X64(ContextFlags, 48)
NEVERD_VEH_CONTEXT_X64(ContextPC, 248)
NEVERD_VEH_CONTEXT_X64(ContextSP, 152)
NEVERD_VEH_CONTEXT_X64(ContextPointer, 128)
NEVERD_VEH_CONTEXT_X64(ContextResult, 120)
NEVERD_VEH_CONTEXT_X64(ContextVector, 416)
NEVERD_VEH_CONTEXT_X64(ContextVectorCount, 16)
NEVERD_VEH_CONTEXT_X64(ContextControl, 52)
NEVERD_VEH_CONTEXT_X64(ContextControlCopy, 280)
NEVERD_VEH_CONTEXT_X64(ContextPrivileged, 56)
NEVERD_VEH_CONTEXT_X64(ContextAll, 0x10000b)
NEVERD_VEH_CONTEXT_X64(ControlValue, 0x5f80)
#endif
#ifdef NEVERD_VEH_CONTEXT_ARM64
NEVERD_VEH_CONTEXT_ARM64(ContextSize, 912)
NEVERD_VEH_CONTEXT_ARM64(ContextFlags, 0)
NEVERD_VEH_CONTEXT_ARM64(ContextPC, 264)
NEVERD_VEH_CONTEXT_ARM64(ContextSP, 256)
NEVERD_VEH_CONTEXT_ARM64(ContextPointer, 8)
NEVERD_VEH_CONTEXT_ARM64(ContextResult, 8)
NEVERD_VEH_CONTEXT_ARM64(ContextVector, 272)
NEVERD_VEH_CONTEXT_ARM64(ContextVectorCount, 32)
NEVERD_VEH_CONTEXT_ARM64(ContextControl, 784)
NEVERD_VEH_CONTEXT_ARM64(ContextControlCopy, 784)
NEVERD_VEH_CONTEXT_ARM64(ContextPrivileged, 152)
NEVERD_VEH_CONTEXT_ARM64(ContextAll, 0x400007)
NEVERD_VEH_CONTEXT_ARM64(ControlValue, 0x01400000)
#endif
#ifdef NEVERD_VEH_ASM
#if defined(_M_X64) || defined(__x86_64__)
NEVERD_VEH_ASM(ReadFault, ".text\n.p2align 4\n.globl "
                          "ReadFault\nReadFault:\nmovq (%rcx), %rax\nretq\n")
NEVERD_VEH_ASM(WriteFault, ".text\n.p2align 4\n.globl "
                           "WriteFault\nWriteFault:\nmovq %rdx, (%rcx)\nretq\n")
NEVERD_VEH_ASM(
    ContextFault,
    ".text\n.p2align 4\n.globl ContextFault\nContextFault:\nmovdqu "
    "VectorSeed(%rip), %xmm0\n.globl ContextFaultSite\nContextFaultSite:\nmovq "
    "(%rcx), %rax\n.globl ContextResume\nContextResume:\nmovdqu %xmm0, "
    "(%rdx)\nretq\n")
NEVERD_VEH_ASM(
    DivideFault,
    ".text\n.p2align 4\n.globl DivideFault\nDivideFault:\nmovq $16, %rax\nxorq "
    "%rdx, %rdx\n.globl DivideFaultSite\nDivideFaultSite:\ndivq %rcx\nretq\n")
#else
NEVERD_VEH_ASM(
    ReadFault,
    ".text\n.p2align 4\n.globl ReadFault\nReadFault:\nldr x0, [x0]\nret\n")
NEVERD_VEH_ASM(
    WriteFault,
    ".text\n.p2align 4\n.globl WriteFault\nWriteFault:\nstr x1, [x0]\nret\n")
NEVERD_VEH_ASM(
    ContextFault,
    ".text\n.p2align 4\n.globl ContextFault\nContextFault:\nadrp "
    "x9, VectorSeed\nadd x9, x9, :lo12:VectorSeed\nldr q0, "
    "[x9]\n.globl ContextFaultSite\nContextFaultSite:\nldr x0, "
    "[x0]\n.globl ContextResume\nContextResume:\nstr q0, [x1]\nret\n")
#endif
#endif
