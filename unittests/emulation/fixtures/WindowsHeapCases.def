#ifdef NEVERD_HEAP_BUILD
NEVERD_HEAP_BUILD(OutputDirectory, "windows-heap-fixtures")
NEVERD_HEAP_BUILD(X64Target, "x86_64-pc-windows-msvc")
NEVERD_HEAP_BUILD(AArch64Target, "aarch64-pc-windows-msvc")
NEVERD_HEAP_BUILD(X64Machine, "x64")
NEVERD_HEAP_BUILD(AArch64Machine, "arm64")
NEVERD_HEAP_BUILD(ProgramEntry, "entry")
NEVERD_HEAP_BUILD(ProgramBase, "0x140000000")
NEVERD_HEAP_BUILD(ProviderFile, "kernel32.dll")
#endif
