#ifdef NEVERD_VCH_VALUE
NEVERD_VCH_VALUE(CompletionStatus, 53)
NEVERD_VCH_VALUE(AlternateData, 0x0f1e2d3c4b5a6978ULL)
NEVERD_VCH_VALUE(ExceptionTrace, 0xe)
NEVERD_VCH_VALUE(TraceShift, 4)
NEVERD_VCH_VALUE(ObservationWords, 4)
#endif
#ifdef NEVERD_VCH_TEXT
NEVERD_VCH_TEXT(ContinuationTempPrefix, "neverd-vectored-continuations")
NEVERD_VCH_TEXT(ContinuationLabel, "Vectored continuation observations: ")
#endif
#ifdef NEVERD_VCH_CASE
NEVERD_VCH_CASE(Order, "!O", 0xe213, 1, 3)
NEVERD_VCH_CASE(ShortCircuit, "!S", 0xe12, 1, 2)
NEVERD_VCH_CASE(Duplicate, "!D", 0xe113, 1, 3)
NEVERD_VCH_CASE(Mutation, "!M", 0xe134e234, 2, 6)
NEVERD_VCH_CASE(Context, "!C", 0xe1, 1, 1)
NEVERD_VCH_CASE(FinalContext, "!F", 0xe1e1, 2, 2)
NEVERD_VCH_CASE(Nested, "!N", 0xe1e23, 2, 2)
NEVERD_VCH_CASE(Loader, "!L", 0xe1e2e3, 3, 3)
NEVERD_VCH_CASE(Exit, "!E", 0xe1, 1, 1)
NEVERD_VCH_CASE(AddInException, "!A", 0xe1, 1, 1)
NEVERD_VCH_CASE(RemoveInException, "!R", 0xe, 1, 0)
NEVERD_VCH_CASE(HandleKinds, "!H", 0xe1, 1, 1)
NEVERD_VCH_CASE(Noncontinuable, "!Q", 0xe1, 1, 1)
#endif
#ifdef NEVERD_VCH_NEGATIVE
NEVERD_VCH_NEGATIVE("!U", ExceptionUnhandled)
NEVERD_VCH_NEGATIVE("!P", ExceptionContext)
NEVERD_VCH_NEGATIVE("!G", ExceptionContext)
NEVERD_VCH_NEGATIVE("!J", ExceptionFrame)
NEVERD_VCH_NEGATIVE("!I", ExceptionDisposition)
NEVERD_VCH_NEGATIVE("!B", ExceptionLimit)
NEVERD_VCH_NEGATIVE("!K", ExceptionHandler)
NEVERD_VCH_NEGATIVE("!V", ExceptionLimit)
#endif
#ifdef NEVERD_VCH_MODE
NEVERD_VCH_MODE(OrderMode, 'O')
NEVERD_VCH_MODE(ShortCircuitMode, 'S')
NEVERD_VCH_MODE(DuplicateMode, 'D')
NEVERD_VCH_MODE(MutationMode, 'M')
NEVERD_VCH_MODE(ContextMode, 'C')
NEVERD_VCH_MODE(FinalContextMode, 'F')
NEVERD_VCH_MODE(NestedMode, 'N')
NEVERD_VCH_MODE(LoaderMode, 'L')
