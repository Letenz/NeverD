#ifdef NEVERD_MMIO_X64_UPDATE
// [RSI] memory, RDX source; carry starts set.
NEVERD_MMIO_X64_UPDATE(Add, 8, 0xf0, 0x48, 0x01, 0x16)
NEVERD_MMIO_X64_UPDATE(Adc, 8, 0xf0, 0x48, 0x11, 0x16)
NEVERD_MMIO_X64_UPDATE(Sub, 8, 0xf0, 0x48, 0x29, 0x16)
