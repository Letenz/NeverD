//===- PE.def - PE32+ limits, layout values and diagnostics ---------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
#ifdef NEVERD_UNPACK_PE_VALUE
NEVERD_UNPACK_PE_VALUE(PointerSize, 8)
NEVERD_UNPACK_PE_VALUE(MaxSections, 96)
// The optional header reserves one directory beyond the named ones.
NEVERD_UNPACK_PE_VALUE(MaxDirectories, 16)
NEVERD_UNPACK_PE_VALUE(MinFileAlignment, 512)
NEVERD_UNPACK_PE_VALUE(MaxFileAlignment, 65536)
NEVERD_UNPACK_PE_VALUE(SectionNameBytes, 8)
NEVERD_UNPACK_PE_VALUE(OrdinalFlag, 1ull << 63)
NEVERD_UNPACK_PE_VALUE(HintBytes, 2)
NEVERD_UNPACK_PE_VALUE(MaxDebugRecords, 4096)
NEVERD_UNPACK_PE_VALUE(MaxTLSCallbacks, 256)
NEVERD_UNPACK_PE_VALUE(MaxDelayDescriptors, 4096)
NEVERD_UNPACK_PE_VALUE(MaxDelayNameBytes, 4096)
#endif

#ifdef NEVERD_UNPACK_PE_BYTES
NEVERD_UNPACK_PE_BYTES(DOSMagic, 'M', 'Z')
#endif

// COFF machine, guest instruction set. An image for any other machine is
// rejected by name.
#ifdef NEVERD_UNPACK_PE_MACHINE
NEVERD_UNPACK_PE_MACHINE(IMAGE_FILE_MACHINE_AMD64, X64)
NEVERD_UNPACK_PE_MACHINE(IMAGE_FILE_MACHINE_ARM64, AArch64)
#endif

// Directories that describe the file layout or the load address of the input.
// Bound imports and certificates name replaced file contents, and the input's
// relocations cannot be shown to cover generated content. The rebuilt file
// names a new import directory. Its IAT protection range must be recovered
// from the cells and section permissions instead of retaining the old range.
#ifdef NEVERD_UNPACK_PE_STALE_DIRECTORY
NEVERD_UNPACK_PE_STALE_DIRECTORY(BOUND_IMPORT)
NEVERD_UNPACK_PE_STALE_DIRECTORY(CERTIFICATE_TABLE)
NEVERD_UNPACK_PE_STALE_DIRECTORY(BASE_RELOCATION_TABLE)
NEVERD_UNPACK_PE_STALE_DIRECTORY(IAT)
#endif

#ifdef NEVERD_UNPACK_PE_TEXT
NEVERD_UNPACK_PE_TEXT(NotPE, "input has no PE signature")
NEVERD_UNPACK_PE_TEXT(Truncated, "PE headers are truncated or overlap")
NEVERD_UNPACK_PE_TEXT(
    Machine, "only 64-bit PE32+ images for x86-64 or ARM64 can be unpacked")
NEVERD_UNPACK_PE_TEXT(
    Alignment, "PE section or file alignment is outside the supported layout")
NEVERD_UNPACK_PE_TEXT(
    Sections, "PE section table is unordered, overlapping or outside the image")
NEVERD_UNPACK_PE_TEXT(SectionData, "PE section data lies outside the file")
NEVERD_UNPACK_PE_TEXT(
    HeaderRoom, "PE headers have no room for the rebuilt metadata section")
NEVERD_UNPACK_PE_TEXT(ImageSize,
                      "rebuilt image exceeds the PE32+ address range")
NEVERD_UNPACK_PE_TEXT(AmbiguousTLS,
                      "multiple TLS directories match the observed callbacks")
NEVERD_UNPACK_PE_TEXT(TLSState,
                      "TLS restoration requires a matching live TLS snapshot")
NEVERD_UNPACK_PE_TEXT(TLSCallbacks,
                      "TLS restoration exceeds the supported callback count")
NEVERD_UNPACK_PE_TEXT(TLSDirectory, "original TLS directory is invalid and no "
                                    "witnessed replacement is available")
NEVERD_UNPACK_PE_TEXT(ImportRange,
                      "a repaired import cell is outside relative-call range")
NEVERD_UNPACK_PE_TEXT(
    IATProtection,
    "read-only import cells cannot share a safe native IAT protection range")
NEVERD_UNPACK_PE_TEXT(
    DelayLayout,
    "delay-import metadata is incomplete or overlaps owned storage")
NEVERD_UNPACK_PE_TEXT(DelayAttributes,
                      "delay-import restoration requires RVA-based descriptors")
NEVERD_UNPACK_PE_TEXT(
    DelayState, "delay-import cells require in-image thunks or observed exports")
#endif
