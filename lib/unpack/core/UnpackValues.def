//===- UnpackValues.def - Shared unpacking constants and diagnostics ------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// One row per container module. The orchestration reaches formats only
// through this registry; no protector supplies execution or rebuild rules.
// Kind, namespace of the module under lib/unpack/format.
#ifdef NEVERD_UNPACK_FORMAT_MODULE
NEVERD_UNPACK_FORMAT_MODULE(PE64, pe)
#endif

#ifdef NEVERD_UNPACK_VALUE
// The granule of guest page permissions and execution watches.
NEVERD_UNPACK_VALUE(PageSize, 4096)
NEVERD_UNPACK_VALUE(MaxImportHelperSites, 256)
NEVERD_UNPACK_VALUE(ImportLookbackBytes, 256)
NEVERD_UNPACK_VALUE(HeapReferenceRecords, 64)
NEVERD_UNPACK_VALUE(PointerBytes, 8)
#endif

#ifdef NEVERD_UNPACK_PRIVATE_TEXT
NEVERD_UNPACK_PRIVATE_TEXT(ImportRepairSetupFailed, "setup_failure")
NEVERD_UNPACK_PRIVATE_TEXT(
    ExternalHeapState,
    "the captured image or TLS bytes contain possible references to live "
    "process heap allocations; "
    "their state is not reconstructed (snapshot_only emits analysis bytes)")
NEVERD_UNPACK_PRIVATE_TEXT(
    UnknownHeapState, "the process profile has no live heap inventory contract "
                      "(snapshot_only emits analysis bytes)")
NEVERD_UNPACK_PRIVATE_TEXT(
    DirectServiceState,
    "execution used direct model service numbers; their native binding is "
    "not reconstructed (snapshot_only emits analysis bytes)")
NEVERD_UNPACK_PRIVATE_TEXT(HeapInventory,
                           "the process heap inventory has invalid extents")
NEVERD_UNPACK_PRIVATE_TEXT(ImportHelperLimit,
                           "import-helper candidate limit reached")
// Rebuilt metadata lives in one appended extent so that no original byte of
// the recovered program is displaced.
NEVERD_UNPACK_PRIVATE_TEXT(MetadataSection, ".neverd")
NEVERD_UNPACK_PRIVATE_TEXT(ReadFailed, "cannot read input: ")
NEVERD_UNPACK_PRIVATE_TEXT(InputTooLarge, "input exceeds the unpacking limit")
NEVERD_UNPACK_PRIVATE_TEXT(UnknownFormat,
                           "input is not an executable container that can be "
                           "unpacked; supported: ")
NEVERD_UNPACK_PRIVATE_TEXT(FormatSeparator, ", ")
NEVERD_UNPACK_PRIVATE_TEXT(Limits,
                           "unpack limits must be positive and consistent")
NEVERD_UNPACK_PRIVATE_TEXT(
    ImageChanged, "the observed image does not match the input headers")
NEVERD_UNPACK_PRIVATE_TEXT(EntryOutside,
                           "generated code was entered outside the input image")
NEVERD_UNPACK_PRIVATE_TEXT(ImportLimit,
                           "recovered imports exceed the unpacking limit")
NEVERD_UNPACK_PRIVATE_TEXT(Rebuilt, "rebuilt image failed validation: ")
NEVERD_UNPACK_PRIVATE_TEXT(UnknownName, "unknown unpacking enumerator")
NEVERD_UNPACK_PRIVATE_TEXT(
    NoEntry, "execution ended before a transfer into generated code was "
             "accepted as the entry: ")
#endif
