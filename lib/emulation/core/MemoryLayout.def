//===- MemoryLayout.def - Bounded physical backing policy -----------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
NEVERD_MEMORY_VALUE(PageSize, 4096)
NEVERD_MEMORY_VALUE(ProjectionReserve, 8 * 1024 * 1024)
NEVERD_MEMORY_VALUE(MaxRAM, 1024ull * 1024 * 1024)
// Both checked ISAs admit this physical width; a transport may narrow it.
NEVERD_MEMORY_VALUE(MaxTransportAddress, (1ull << 40) - 1)
