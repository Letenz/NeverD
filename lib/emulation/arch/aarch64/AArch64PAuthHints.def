//===- AArch64PAuthHints.def - Signing hints with authentication disabled -===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// Only the architecturally compatible HINT-space signing/authentication forms.
// The checked machine keeps SCTLR_EL1.EnIA/EnIB clear. Execute the original
// words through the transport; this inventory does not implement active PAuth.
// Stripping, authenticated branches/loads and key access are separate
// contracts.
#ifdef NEVERD_AARCH64_PAUTH_HINT
NEVERD_AARCH64_PAUTH_HINT(PACIA1716, 0xd503211f)
NEVERD_AARCH64_PAUTH_HINT(PACIB1716, 0xd503215f)
NEVERD_AARCH64_PAUTH_HINT(AUTIA1716, 0xd503219f)
NEVERD_AARCH64_PAUTH_HINT(AUTIB1716, 0xd50321df)
NEVERD_AARCH64_PAUTH_HINT(PACIAZ, 0xd503231f)
NEVERD_AARCH64_PAUTH_HINT(PACIASP, 0xd503233f)
NEVERD_AARCH64_PAUTH_HINT(PACIBZ, 0xd503235f)
NEVERD_AARCH64_PAUTH_HINT(PACIBSP, 0xd503237f)
NEVERD_AARCH64_PAUTH_HINT(AUTIAZ, 0xd503239f)
NEVERD_AARCH64_PAUTH_HINT(AUTIASP, 0xd50323bf)
NEVERD_AARCH64_PAUTH_HINT(AUTIBZ, 0xd50323df)
NEVERD_AARCH64_PAUTH_HINT(AUTIBSP, 0xd50323ff)
#endif
