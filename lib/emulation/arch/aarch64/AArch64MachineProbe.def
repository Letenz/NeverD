//===- AArch64MachineProbe.def - ARM64 startup program ---------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
#ifdef NEVERD_AARCH64_PROBE_VALUE
NEVERD_AARCH64_PROBE_VALUE(ScalarSeed, 0x1122334455667700ULL)
NEVERD_AARCH64_PROBE_VALUE(ScalarStride, 0x101)
NEVERD_AARCH64_PROBE_VALUE(VectorLowSeed, 0x0123456789abcdefULL)
NEVERD_AARCH64_PROBE_VALUE(VectorHighSeed, 0xfedcba9876543210ULL)
NEVERD_AARCH64_PROBE_VALUE(VectorStride, 0x101)
NEVERD_AARCH64_PROBE_VALUE(StackAlignment, 16)
NEVERD_AARCH64_PROBE_VALUE(NZCV, 0xa0000000)
// Round toward +infinity, FZ/DN; retain preexisting QC/divide-by-zero status.
NEVERD_AARCH64_PROBE_VALUE(FPCR, 0x03400000)
NEVERD_AARCH64_PROBE_VALUE(FPSR, 0x08000002)
NEVERD_AARCH64_PROBE_VALUE(InexactFPSR, 0x08000012)
NEVERD_AARCH64_PROBE_VALUE(FirstVector, 29)
NEVERD_AARCH64_PROBE_VALUE(ResultVector, 30)
NEVERD_AARCH64_PROBE_VALUE(LastVector, 31)
NEVERD_AARCH64_PROBE_VALUE(FloatHalfULP, 0x33800000)
NEVERD_AARCH64_PROBE_VALUE(FloatOne, 0x3f800000)
NEVERD_AARCH64_PROBE_VALUE(FloatRoundedUp, 0x3f800001)
NEVERD_AARCH64_PROBE_VALUE(VectorResultLow, 0x73000000)
NEVERD_AARCH64_PROBE_VALUE(VectorResultHigh, 0xfdb97530eca827e4ULL)
#endif
#ifdef NEVERD_AARCH64_PROBE_INSTRUCTION
NEVERD_AARCH64_PROBE_INSTRUCTION(Nop, 0xd503201f)
// fadd s30, s31, s29: 1 + 2^-24 rounds up and sets cumulative IXC.
NEVERD_AARCH64_PROBE_INSTRUCTION(FloatingAdd, 0x1e3d2bfe)
// add v31.2d, v31.2d, v29.2d: both 64-bit lanes must execute.
NEVERD_AARCH64_PROBE_INSTRUCTION(VectorAdd, 0x4efd87ff)
// Both return-address keys must remain disabled; arbitrary LR bits survive.
NEVERD_AARCH64_PROBE_INSTRUCTION(SignA, 0xd503233f)
NEVERD_AARCH64_PROBE_INSTRUCTION(AuthenticateA, 0xd50323bf)
NEVERD_AARCH64_PROBE_INSTRUCTION(SignB, 0xd503237f)
NEVERD_AARCH64_PROBE_INSTRUCTION(AuthenticateB, 0xd50323ff)
// All branch-target forms must preserve state in the unguarded projection.
NEVERD_AARCH64_PROBE_INSTRUCTION(BranchTarget, 0xd503241f)
NEVERD_AARCH64_PROBE_INSTRUCTION(CallTarget, 0xd503245f)
NEVERD_AARCH64_PROBE_INSTRUCTION(JumpTarget, 0xd503249f)
NEVERD_AARCH64_PROBE_INSTRUCTION(CallOrJumpTarget, 0xd50324df)
// Observe the virtual CPU's CTR twice without imposing a host cache geometry.
NEVERD_AARCH64_PROBE_INSTRUCTION(CacheType, 0xd53b003a)
NEVERD_AARCH64_PROBE_INSTRUCTION(CacheTypeAgain, 0xd53b003b)
// X28 addresses this private program; the original maintenance words execute.
NEVERD_AARCH64_PROBE_INSTRUCTION(CleanData, 0xd50b7b3c)
NEVERD_AARCH64_PROBE_INSTRUCTION(DataBarrier, 0xd5033b9f)
NEVERD_AARCH64_PROBE_INSTRUCTION(InvalidateInstruction, 0xd50b753c)
NEVERD_AARCH64_PROBE_INSTRUCTION(InstructionDataBarrier, 0xd5033b9f)
NEVERD_AARCH64_PROBE_INSTRUCTION(InstructionBarrier, 0xd5033fdf)
#endif
