//===- CheckedAArch64Instructions.def - Admitted ARMv8 integer ISA --------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// Operand admission additionally excludes FP/SIMD, SVE, system registers and
// constrained-unpredictable writeback. HINT is restricted to the NOP encoding.
