#ifdef NEVERD_AARCH64_ENCODING
// MRS/MSR TPIDR_EL0, Xt. Only the general-register field is variable.
NEVERD_AARCH64_ENCODING(ReadThreadPointer, 0xffffffe0, 0xd53bd040)
NEVERD_AARCH64_ENCODING(WriteThreadPointer, 0xffffffe0, 0xd51bd040)
NEVERD_AARCH64_ENCODING(ReadFPControl, 0xffffffe0, 0xd53b4400)
NEVERD_AARCH64_ENCODING(WriteFPControl, 0xffffffe0, 0xd51b4400)
NEVERD_AARCH64_ENCODING(ReadFPStatus, 0xffffffe0, 0xd53b4420)
NEVERD_AARCH64_ENCODING(WriteFPStatus, 0xffffffe0, 0xd51b4420)
NEVERD_AARCH64_ENCODING(UnsignedMemory, 0x3b000000, 0x39000000)
NEVERD_AARCH64_ENCODING(ImmediateMemory, 0x3b200000, 0x38000000)
NEVERD_AARCH64_ENCODING(RegisterMemory, 0x3b200c00, 0x38200800)
NEVERD_AARCH64_ENCODING(PairMemory, 0x3a000000, 0x28000000)
NEVERD_AARCH64_ENCODING(LiteralMemory, 0x3b000000, 0x18000000)
NEVERD_AARCH64_ENCODING(NOP, 0xffffffff, 0xd503201f)
#endif
#ifdef NEVERD_AARCH64_FIELD
NEVERD_AARCH64_FIELD(RegisterMask, 31)
NEVERD_AARCH64_FIELD(BaseShift, 5)
NEVERD_AARCH64_FIELD(SecondShift, 10)
NEVERD_AARCH64_FIELD(IndexShift, 16)
NEVERD_AARCH64_FIELD(SizeShift, 30)
NEVERD_AARCH64_FIELD(OpcodeShift, 22)
NEVERD_AARCH64_FIELD(OpcodeMask, 3)
NEVERD_AARCH64_FIELD(ModeShift, 10)
NEVERD_AARCH64_FIELD(PairModeShift, 23)
NEVERD_AARCH64_FIELD(PairLoadBit, 1u << 22)
NEVERD_AARCH64_FIELD(PairWidthBit, 1u << 31)
NEVERD_AARCH64_FIELD(SignLoadBit, 1u << 23)
NEVERD_AARCH64_FIELD(LoadBit, 1u << 22)
NEVERD_AARCH64_FIELD(UnsignedOffsetShift, 10)
NEVERD_AARCH64_FIELD(UnsignedOffsetMask, 0xfff)
NEVERD_AARCH64_FIELD(ImmediateShift, 12)
NEVERD_AARCH64_FIELD(ImmediateBits, 9)
NEVERD_AARCH64_FIELD(PairOffsetShift, 15)
NEVERD_AARCH64_FIELD(PairOffsetBits, 7)
NEVERD_AARCH64_FIELD(LiteralOffsetShift, 5)
NEVERD_AARCH64_FIELD(LiteralOffsetBits, 19)
NEVERD_AARCH64_FIELD(ExtendShift, 13)
NEVERD_AARCH64_FIELD(ExtendMask, 7)
NEVERD_AARCH64_FIELD(ScaleBit, 1u << 12)
NEVERD_AARCH64_FIELD(UXTW, 2)
NEVERD_AARCH64_FIELD(UXTX, 3)
NEVERD_AARCH64_FIELD(SXTW, 6)
NEVERD_AARCH64_FIELD(SXTX, 7)
NEVERD_AARCH64_FIELD(VectorMemoryBit, 1u << 26)
NEVERD_AARCH64_FIELD(VectorLoadBit, 1)
NEVERD_AARCH64_FIELD(VectorFullWidthBit, 2)
NEVERD_AARCH64_FIELD(VectorBytes, 16)
NEVERD_AARCH64_FIELD(FP32Bits, 32)
NEVERD_AARCH64_FIELD(LayoutElementMask, 0xff)
#endif
