//===- X64VectorInstructions.def - Legacy SSE/SSE2 data operations --------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// Name, memory width, alignment, move/store, complete operand form.
// Floating-point operations retain masked MXCSR status/control.
// MMX, VEX/EVEX and unmasked FP exceptions remain outside this contract.
// String MOVSD has separate operand admission and restart semantics.
NEVERD_X64_VECTOR_INSTRUCTION(MOVD, 4, 1, true, GeneralMove)
NEVERD_X64_VECTOR_INSTRUCTION(MOVQ, 8, 1, true, GeneralMove)
NEVERD_X64_VECTOR_INSTRUCTION(MOVSS, 4, 1, true, Move)
NEVERD_X64_VECTOR_INSTRUCTION(MOVSD, 8, 1, true, Move)
NEVERD_X64_VECTOR_INSTRUCTION(MOVUPS, 16, 1, true, Move)
NEVERD_X64_VECTOR_INSTRUCTION(MOVUPD, 16, 1, true, Move)
NEVERD_X64_VECTOR_INSTRUCTION(MOVDQU, 16, 1, true, Move)
NEVERD_X64_VECTOR_INSTRUCTION(MOVAPS, 16, 16, true, Move)
NEVERD_X64_VECTOR_INSTRUCTION(MOVAPD, 16, 16, true, Move)
NEVERD_X64_VECTOR_INSTRUCTION(MOVDQA, 16, 16, true, Move)
NEVERD_X64_VECTOR_INSTRUCTION(MOVLHPS, 16, 1, false, RegisterPair)
NEVERD_X64_VECTOR_INSTRUCTION(MOVHLPS, 16, 1, false, RegisterPair)
NEVERD_X64_VECTOR_INSTRUCTION(XORPS, 16, 16, false, Source)
NEVERD_X64_VECTOR_INSTRUCTION(XORPD, 16, 16, false, Source)
NEVERD_X64_VECTOR_INSTRUCTION(PXOR, 16, 16, false, Source)
NEVERD_X64_VECTOR_INSTRUCTION(ANDPS, 16, 16, false, Source)
NEVERD_X64_VECTOR_INSTRUCTION(ANDPD, 16, 16, false, Source)
NEVERD_X64_VECTOR_INSTRUCTION(PAND, 16, 16, false, Source)
NEVERD_X64_VECTOR_INSTRUCTION(ORPS, 16, 16, false, Source)
NEVERD_X64_VECTOR_INSTRUCTION(ORPD, 16, 16, false, Source)
NEVERD_X64_VECTOR_INSTRUCTION(POR, 16, 16, false, Source)
NEVERD_X64_VECTOR_INSTRUCTION(ANDNPS, 16, 16, false, Source)
NEVERD_X64_VECTOR_INSTRUCTION(ANDNPD, 16, 16, false, Source)
NEVERD_X64_VECTOR_INSTRUCTION(PANDN, 16, 16, false, Source)
#define NEVERD_X64_PACKED_INTEGER(Name)                                        \
  NEVERD_X64_VECTOR_INSTRUCTION(Name, 16, 16, false, Source)
#include "X64PackedIntegerInstructions.def"
#undef NEVERD_X64_PACKED_INTEGER
#define NEVERD_X64_PACKED_SHIFT(Name, Count)                                   \
  NEVERD_X64_VECTOR_INSTRUCTION(Name, 16, 16, false, Count)
#include "X64PackedShiftInstructions.def"
#undef NEVERD_X64_PACKED_SHIFT
#define NEVERD_X64_SSE_INSTRUCTION(Name, Width, Alignment, Double, ...)        \
  NEVERD_X64_VECTOR_INSTRUCTION(Name, Width, Alignment, false, Source)
#include "X64SSEInstructions.def"
#undef NEVERD_X64_SSE_INSTRUCTION
NEVERD_X64_VECTOR_INSTRUCTION(CVTTSS2SI, 4, 1, false, IntegerResult)
NEVERD_X64_VECTOR_INSTRUCTION(CVTTSD2SI, 8, 1, false, IntegerResult)
NEVERD_X64_VECTOR_INSTRUCTION(MOVMSKPS, 0, 1, false, RegisterMask)
NEVERD_X64_VECTOR_INSTRUCTION(MOVMSKPD, 0, 1, false, RegisterMask)
NEVERD_X64_VECTOR_INSTRUCTION(PMOVMSKB, 0, 1, false, RegisterMask)
#define NEVERD_X64_SHUFFLE_INSTRUCTION(Name, Form)                             \
  NEVERD_X64_VECTOR_INSTRUCTION(Name, 16, 16, false, Form)
#include "X64ShuffleInstructions.def"
#undef NEVERD_X64_SHUFFLE_INSTRUCTION
