//===- X64VectorInstructions.def - Legacy SSE/SSE2 data operations --------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// Name, memory width, alignment, move/store, permits a general register.
// Data operations do not observe MXCSR; the bounded scalar FP entries below
// retain its status/control. MMX, VEX/EVEX and other FP families are rejected.
// String MOVSD has separate operand admission and restart semantics.
NEVERD_X64_VECTOR_INSTRUCTION(MOVD, 4, 1, true, true)
NEVERD_X64_VECTOR_INSTRUCTION(MOVQ, 8, 1, true, true)
NEVERD_X64_VECTOR_INSTRUCTION(MOVSS, 4, 1, true, false)
NEVERD_X64_VECTOR_INSTRUCTION(MOVSD, 8, 1, true, false)
NEVERD_X64_VECTOR_INSTRUCTION(MOVUPS, 16, 1, true, false)
NEVERD_X64_VECTOR_INSTRUCTION(MOVUPD, 16, 1, true, false)
NEVERD_X64_VECTOR_INSTRUCTION(MOVDQU, 16, 1, true, false)
NEVERD_X64_VECTOR_INSTRUCTION(MOVAPS, 16, 16, true, false)
NEVERD_X64_VECTOR_INSTRUCTION(MOVAPD, 16, 16, true, false)
NEVERD_X64_VECTOR_INSTRUCTION(MOVDQA, 16, 16, true, false)
NEVERD_X64_VECTOR_INSTRUCTION(MOVLHPS, 16, 1, false, false)
NEVERD_X64_VECTOR_INSTRUCTION(MOVHLPS, 16, 1, false, false)
NEVERD_X64_VECTOR_INSTRUCTION(XORPS, 16, 16, false, false)
NEVERD_X64_VECTOR_INSTRUCTION(XORPD, 16, 16, false, false)
NEVERD_X64_VECTOR_INSTRUCTION(PXOR, 16, 16, false, false)
NEVERD_X64_VECTOR_INSTRUCTION(ANDPS, 16, 16, false, false)
NEVERD_X64_VECTOR_INSTRUCTION(ANDPD, 16, 16, false, false)
NEVERD_X64_VECTOR_INSTRUCTION(PAND, 16, 16, false, false)
NEVERD_X64_VECTOR_INSTRUCTION(ORPS, 16, 16, false, false)
NEVERD_X64_VECTOR_INSTRUCTION(ORPD, 16, 16, false, false)
NEVERD_X64_VECTOR_INSTRUCTION(POR, 16, 16, false, false)
NEVERD_X64_VECTOR_INSTRUCTION(ANDNPS, 16, 16, false, false)
NEVERD_X64_VECTOR_INSTRUCTION(ANDNPD, 16, 16, false, false)
NEVERD_X64_VECTOR_INSTRUCTION(PANDN, 16, 16, false, false)
// Masked scalar FP operations; the machine preserves MXCSR status/control.
NEVERD_X64_VECTOR_INSTRUCTION(SUBSS, 4, 1, false, false)
NEVERD_X64_VECTOR_INSTRUCTION(SUBSD, 8, 1, false, false)
NEVERD_X64_VECTOR_INSTRUCTION(CVTTSS2SI, 4, 1, false, false)
NEVERD_X64_VECTOR_INSTRUCTION(CVTTSD2SI, 8, 1, false, false)
