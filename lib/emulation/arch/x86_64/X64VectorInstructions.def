//===- X64VectorInstructions.def - Legacy SSE/SSE2 data operations --------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// Name, memory width, alignment, move/store, complete operand form, first
// 64-bit store lane. High-half moves preview lane 1; full stores start at 0.
// Floating-point operations retain masked MXCSR status/control.
// MMX, VEX/EVEX and unmasked FP exceptions remain outside this contract.
// String MOVSD has separate operand admission and restart semantics.
// IntegerSource selects m32/m64 through its complete operand rule.
NEVERD_X64_VECTOR_INSTRUCTION(MOVD, 4, 1, true, GeneralMove, 0)
NEVERD_X64_VECTOR_INSTRUCTION(MOVQ, 8, 1, true, GeneralMove, 0)
NEVERD_X64_VECTOR_INSTRUCTION(MOVSS, 4, 1, true, Move, 0)
NEVERD_X64_VECTOR_INSTRUCTION(MOVSD, 8, 1, true, Move, 0)
NEVERD_X64_VECTOR_INSTRUCTION(MOVLPS, 8, 1, true, MemoryMove, 0)
NEVERD_X64_VECTOR_INSTRUCTION(MOVHPS, 8, 1, true, MemoryMove, 1)
NEVERD_X64_VECTOR_INSTRUCTION(MOVLPD, 8, 1, true, MemoryMove, 0)
NEVERD_X64_VECTOR_INSTRUCTION(MOVHPD, 8, 1, true, MemoryMove, 1)
NEVERD_X64_VECTOR_INSTRUCTION(MOVUPS, 16, 1, true, Move, 0)
NEVERD_X64_VECTOR_INSTRUCTION(MOVUPD, 16, 1, true, Move, 0)
NEVERD_X64_VECTOR_INSTRUCTION(MOVDQU, 16, 1, true, Move, 0)
NEVERD_X64_VECTOR_INSTRUCTION(MOVAPS, 16, 16, true, Move, 0)
NEVERD_X64_VECTOR_INSTRUCTION(MOVAPD, 16, 16, true, Move, 0)
NEVERD_X64_VECTOR_INSTRUCTION(MOVDQA, 16, 16, true, Move, 0)
NEVERD_X64_VECTOR_INSTRUCTION(MOVLHPS, 16, 1, false, RegisterPair, 0)
NEVERD_X64_VECTOR_INSTRUCTION(MOVHLPS, 16, 1, false, RegisterPair, 0)
NEVERD_X64_VECTOR_INSTRUCTION(XORPS, 16, 16, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(XORPD, 16, 16, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(PXOR, 16, 16, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(ANDPS, 16, 16, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(ANDPD, 16, 16, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(PAND, 16, 16, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(ORPS, 16, 16, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(ORPD, 16, 16, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(POR, 16, 16, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(ANDNPS, 16, 16, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(ANDNPD, 16, 16, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(PANDN, 16, 16, false, Source, 0)
#define NEVERD_X64_PACKED_INTEGER(Name)                                        \
  NEVERD_X64_VECTOR_INSTRUCTION(Name, 16, 16, false, Source, 0)
#include "X64PackedIntegerInstructions.def"
#undef NEVERD_X64_PACKED_INTEGER
#define NEVERD_X64_PACKED_SHIFT(Name, Count)                                   \
  NEVERD_X64_VECTOR_INSTRUCTION(Name, 16, 16, false, Count, 0)
#include "X64PackedShiftInstructions.def"
#undef NEVERD_X64_PACKED_SHIFT
#define NEVERD_X64_SSE_INSTRUCTION(Name, Width, Alignment, Double, ...)        \
  NEVERD_X64_VECTOR_INSTRUCTION(Name, Width, Alignment, false, Source, 0)
#include "X64SSEInstructions.def"
#undef NEVERD_X64_SSE_INSTRUCTION
NEVERD_X64_VECTOR_INSTRUCTION(CVTSS2SI, 4, 1, false, IntegerResult, 0)
NEVERD_X64_VECTOR_INSTRUCTION(CVTSD2SI, 8, 1, false, IntegerResult, 0)
NEVERD_X64_VECTOR_INSTRUCTION(CVTTSS2SI, 4, 1, false, IntegerResult, 0)
NEVERD_X64_VECTOR_INSTRUCTION(CVTTSD2SI, 8, 1, false, IntegerResult, 0)
NEVERD_X64_VECTOR_INSTRUCTION(CVTSI2SS, 0, 1, false, IntegerSource, 0)
NEVERD_X64_VECTOR_INSTRUCTION(CVTSI2SD, 0, 1, false, IntegerSource, 0)
NEVERD_X64_VECTOR_INSTRUCTION(CVTSS2SD, 4, 1, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(CVTSD2SS, 8, 1, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(CVTPS2PD, 8, 1, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(CVTPD2PS, 16, 16, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(CVTDQ2PS, 16, 16, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(CVTDQ2PD, 8, 1, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(CVTPS2DQ, 16, 16, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(CVTTPS2DQ, 16, 16, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(CVTPD2DQ, 16, 16, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(CVTTPD2DQ, 16, 16, false, Source, 0)
// Legacy predicates 0-7 decode to family IDs with two operands and sse_cc.
// Reserved controls retain an explicit immediate and fail Source admission.
NEVERD_X64_VECTOR_INSTRUCTION(CMPSS, 4, 1, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(CMPSD, 8, 1, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(CMPPS, 16, 16, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(CMPPD, 16, 16, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(COMISS, 4, 1, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(COMISD, 8, 1, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(UCOMISS, 4, 1, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(UCOMISD, 8, 1, false, Source, 0)
NEVERD_X64_VECTOR_INSTRUCTION(MOVMSKPS, 0, 1, false, RegisterMask, 0)
NEVERD_X64_VECTOR_INSTRUCTION(MOVMSKPD, 0, 1, false, RegisterMask, 0)
NEVERD_X64_VECTOR_INSTRUCTION(PMOVMSKB, 0, 1, false, RegisterMask, 0)
#define NEVERD_X64_SHUFFLE_INSTRUCTION(Name, Form)                             \
  NEVERD_X64_VECTOR_INSTRUCTION(Name, 16, 16, false, Form, 0)
#include "X64ShuffleInstructions.def"
#undef NEVERD_X64_SHUFFLE_INSTRUCTION
