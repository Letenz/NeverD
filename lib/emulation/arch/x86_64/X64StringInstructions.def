//===- X64StringInstructions.def - Restartable string operations ----------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
NEVERD_X64_STRING_INSTRUCTION(MOVSB, 1, Move)
NEVERD_X64_STRING_INSTRUCTION(MOVSW, 2, Move)
// MOVSD shares a decoder identity with the SSE move. A combined instruction
// inventory may omit this row when that identity is already present.
#ifndef NEVERD_X64_STRING_SHARED_MOVSD
NEVERD_X64_STRING_INSTRUCTION(MOVSD, 4, Move)
#endif
NEVERD_X64_STRING_INSTRUCTION(MOVSQ, 8, Move)
NEVERD_X64_STRING_INSTRUCTION(STOSB, 1, Store)
NEVERD_X64_STRING_INSTRUCTION(STOSW, 2, Store)
NEVERD_X64_STRING_INSTRUCTION(STOSD, 4, Store)
NEVERD_X64_STRING_INSTRUCTION(STOSQ, 8, Store)
NEVERD_X64_STRING_INSTRUCTION(LODSB, 1, Load)
NEVERD_X64_STRING_INSTRUCTION(LODSW, 2, Load)
NEVERD_X64_STRING_INSTRUCTION(LODSD, 4, Load)
NEVERD_X64_STRING_INSTRUCTION(LODSQ, 8, Load)
NEVERD_X64_STRING_INSTRUCTION(CMPSB, 1, Compare)
NEVERD_X64_STRING_INSTRUCTION(CMPSW, 2, Compare)
NEVERD_X64_STRING_INSTRUCTION(CMPSD, 4, Compare)
NEVERD_X64_STRING_INSTRUCTION(CMPSQ, 8, Compare)
NEVERD_X64_STRING_INSTRUCTION(SCASB, 1, Scan)
NEVERD_X64_STRING_INSTRUCTION(SCASW, 2, Scan)
NEVERD_X64_STRING_INSTRUCTION(SCASD, 4, Scan)
NEVERD_X64_STRING_INSTRUCTION(SCASQ, 8, Scan)
