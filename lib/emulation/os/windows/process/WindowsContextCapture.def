//===- WindowsContextCapture.def - Caller-context capture policy ---------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
#ifdef NEVERD_WINDOWS_PROCESS_VALUE
#define NEVERD_WINDOWS_X64_CAPTURE_FLAGS(Value)                                \
  NEVERD_WINDOWS_PROCESS_VALUE(X64CapturedContextFlags, Value)
#endif
// RtlCaptureContext publishes the legacy FXSAVE pointer fields, even for
// a 64-bit caller. Exception snapshots retain their complete internal state.
#ifdef NEVERD_WINDOWS_CAPTURE_FP_POINTER
NEVERD_WINDOWS_CAPTURE_FP_POINTER(264)
NEVERD_WINDOWS_CAPTURE_FP_POINTER(272)
#endif
#ifdef NEVERD_WINDOWS_PROCESS_TEXT
NEVERD_WINDOWS_PROCESS_TEXT(CaptureContextBuffer,
                            "invalid or inaccessible caller context buffer")
NEVERD_WINDOWS_PROCESS_TEXT(CaptureContextReturn,
                            "inaccessible caller context return address")
#endif
// Native Windows leaves home slots, debug registers and extended vector/debug
// storage untouched. The legacy FP save writes its first 416 bytes only.
#ifdef NEVERD_WINDOWS_CAPTURE_RANGE
NEVERD_WINDOWS_CAPTURE_RANGE(X64, 48, 24)
NEVERD_WINDOWS_CAPTURE_RANGE(X64, 120, 552)
NEVERD_WINDOWS_CAPTURE_RANGE(AArch64, 0, 792)
#endif
#include "../exception/WindowsX64Context.def"
#undef NEVERD_WINDOWS_X64_CAPTURE_FLAGS
