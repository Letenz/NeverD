#ifdef NEVERD_WINDOWS_PROCESS_TEXT
NEVERD_WINDOWS_PROCESS_TEXT(ExceptionLimit,
                            "user exception handler or nesting limit exceeded")
NEVERD_WINDOWS_PROCESS_TEXT(ExceptionArguments,
                            "unsupported RaiseException flags or parameters")
NEVERD_WINDOWS_PROCESS_TEXT(ExceptionUnhandled,
                            "user exception was not handled")
NEVERD_WINDOWS_PROCESS_TEXT(ExceptionMetadataChanged,
                            "live user exception metadata changed")
NEVERD_WINDOWS_PROCESS_TEXT(ExceptionModuleRetired,
                            "exception dispatch image was unloaded or replaced")
NEVERD_WINDOWS_PROCESS_TEXT(
    ExceptionLoaderBoundary,
    "exception unwind crossed a loader callback boundary")
NEVERD_WINDOWS_PROCESS_TEXT(
    ExceptionPersonalityCall,
    "direct calls to the modeled C exception personality are unsupported")
NEVERD_WINDOWS_PROCESS_TEXT(ExceptionDisposition,
                            "invalid vectored exception handler disposition")
NEVERD_WINDOWS_PROCESS_TEXT(
    ExceptionContext,
    "invalid or unsupported user exception context modification")
NEVERD_WINDOWS_PROCESS_TEXT(ExceptionFrame,
                            "invalid or inaccessible user exception frame")
NEVERD_WINDOWS_PROCESS_TEXT(
    ExceptionHandler, "vectored exception handler is not executable user code")
#endif
// Register widths describe the Windows ABI, independently of the host layout.
// The last column lists bits a guest continuation may change. Privilege,
// debug state, ARM64 X18 and unmodeled CONTEXT fields remain immutable.
#ifdef NEVERD_WINDOWS_CONTEXT_X64
NEVERD_WINDOWS_CONTEXT_X64(MXCSR, 52, 4, 0xffff)
NEVERD_WINDOWS_CONTEXT_X64(CS, 56, 2, 0)
