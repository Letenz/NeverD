NEVERD_WINDOWS_X64_CONTEXT_LAYOUT(FXMXCSROffset, 280)
NEVERD_WINDOWS_X64_CONTEXT_LAYOUT(XmmOffset, 416)
#endif
#ifdef NEVERD_WINDOWS_CONTEXT_X64
NEVERD_WINDOWS_CONTEXT_X64(MXCSR, 52, 4, 0xffff)
