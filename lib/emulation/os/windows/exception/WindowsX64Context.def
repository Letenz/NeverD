#ifdef NEVERD_WINDOWS_X64_CONTEXT_LAYOUT
NEVERD_WINDOWS_X64_CONTEXT_LAYOUT(Size, 1232)
NEVERD_WINDOWS_X64_CONTEXT_LAYOUT(FlagsOffset, 48)
NEVERD_WINDOWS_X64_CONTEXT_LAYOUT(MXCSROffset, 52)
