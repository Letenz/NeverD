#ifdef NEVERD_WINDOWS_X64_CAPTURE_FLAGS
NEVERD_WINDOWS_X64_CAPTURE_FLAGS(0x10000f)
#endif
// Checked logical context publication uses the flat guest data selector.
// This is not a statement about host or raw transport selector numbers.
#ifdef NEVERD_WINDOWS_CAPTURE_DATA_SEGMENT
NEVERD_WINDOWS_CAPTURE_DATA_SEGMENT(58)
NEVERD_WINDOWS_CAPTURE_DATA_SEGMENT(60)
NEVERD_WINDOWS_CAPTURE_DATA_SEGMENT(62)
NEVERD_WINDOWS_CAPTURE_DATA_SEGMENT(64)
#endif
