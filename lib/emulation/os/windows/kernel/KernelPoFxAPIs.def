//===- KernelPoFxAPIs.def - Component power DDI contracts ---------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// Component-power argument counts, IRQL ceilings and typed operations.
///
//===----------------------------------------------------------------------===//
NEVERD_KERNEL_POFX_API(PoFxRegisterDevice, 3, Passive,
                       registerPoFxDevice(A[0], A[1], A[2]))
NEVERD_KERNEL_POFX_API(PoFxUnregisterDevice, 1, Passive,
                       unregisterPoFxDevice(A[0]))
NEVERD_KERNEL_POFX_API(PoFxStartDevicePowerManagement, 1, Passive,
                       startPoFxPowerManagement(A[0]))
NEVERD_KERNEL_POFX_API(PoFxActivateComponent, 3, Dispatch,
                       changePoFxComponent(A[0], uint32_t(A[1]), uint32_t(A[2]),
                                           PoFxCondition::Active))
NEVERD_KERNEL_POFX_API(PoFxIdleComponent, 3, Dispatch,
                       changePoFxComponent(A[0], uint32_t(A[1]), uint32_t(A[2]),
                                           PoFxCondition::Idle))
NEVERD_KERNEL_POFX_API(PoFxCompleteIdleCondition, 2, Dispatch,
                       completePoFxIdleCondition(A[0], uint32_t(A[1])))
NEVERD_KERNEL_POFX_API(PoFxCompleteIdleState, 2, Dispatch,
                       completePoFxIdleState(A[0], uint32_t(A[1])))
NEVERD_KERNEL_POFX_API(PoFxCompleteDevicePowerNotRequired, 1, Dispatch,
                       completePoFxPowerNotRequired(A[0]))
NEVERD_KERNEL_POFX_API(PoFxReportDevicePoweredOn, 1, Dispatch,
                       reportPoFxDevicePoweredOn(A[0]))
NEVERD_KERNEL_POFX_API(PoFxSetComponentLatency, 3, Dispatch,
                       setPoFxComponentLatency(A[0], uint32_t(A[1]), A[2]))
NEVERD_KERNEL_POFX_API(PoFxSetComponentResidency, 3, Dispatch,
                       setPoFxComponentResidency(A[0], uint32_t(A[1]), A[2]))
NEVERD_KERNEL_POFX_API(PoFxSetComponentWake, 3, Dispatch,
                       setPoFxComponentWake(A[0], uint32_t(A[1]),
                                            uint8_t(A[2]) != 0))
NEVERD_KERNEL_POFX_API(PoFxSetDeviceIdleTimeout, 2, Dispatch,
                       setPoFxDeviceIdleTimeout(A[0], A[1]))
