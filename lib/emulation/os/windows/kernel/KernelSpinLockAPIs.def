//===- KernelSpinLockAPIs.def - Executive spin-lock API contracts ---------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// Public x64 WDK executive spin-lock entries and their typed operations.
/// This profile restricts
/// DPC-level calls to exact DISPATCH_LEVEL in the owning model.
///
//===----------------------------------------------------------------------===//

// https://learn.microsoft.com/windows-hardware/drivers/ddi/wdm/nf-wdm-keacquirespinlockraisetodpc
// https://learn.microsoft.com/windows-hardware/drivers/kernel/initializing-spin-locks
NEVERD_KERNEL_SPINLOCK_API(KeInitializeSpinLock, 1, Any,
                           initializeSpinLock(A[0]))
NEVERD_KERNEL_SPINLOCK_API(KeAcquireSpinLockRaiseToDpc, 1, Dispatch,
                           acquireSpinLock(A[0], SpinLockMode::Raise))
NEVERD_KERNEL_SPINLOCK_API(KeReleaseSpinLock, 2, Dispatch,
                           releaseSpinLock(A[0], uint8_t(A[1])))
NEVERD_KERNEL_SPINLOCK_API(KeAcquireSpinLockAtDpcLevel, 1, Dispatch,
                           acquireSpinLock(A[0], SpinLockMode::AtDpc))
NEVERD_KERNEL_SPINLOCK_API(KeReleaseSpinLockFromDpcLevel, 1, Dispatch,
                           releaseSpinLock(A[0], std::nullopt))
NEVERD_KERNEL_SPINLOCK_API(KeTryToAcquireSpinLockAtDpcLevel, 1, Dispatch,
                           acquireSpinLock(A[0], SpinLockMode::TryAtDpc))

// In-stack queued spin locks keep the wait token in a caller KLOCK_QUEUE_HANDLE
// and save the old IRQL there. RVA 0x22e780 raises to DISPATCH_LEVEL; the
// AtDpcLevel form (RVA 0x22c490) runs already there. Releases (RVA 0x22cf70 and
// the FromDpcLevel form RVA 0x2cde30) clear the lock and, for the raising form,
// restore the saved IRQL.
// https://learn.microsoft.com/windows-hardware/drivers/ddi/wdm/nf-wdm-keacquireinstackqueuedspinlock
NEVERD_KERNEL_SPINLOCK_API(KeAcquireInStackQueuedSpinLock, 2, Dispatch,
                           acquireQueuedSpinLock(A[0], A[1], true))
// https://learn.microsoft.com/windows-hardware/drivers/ddi/wdm/nf-wdm-kereleaseinstackqueuedspinlock
NEVERD_KERNEL_SPINLOCK_API(KeReleaseInStackQueuedSpinLock, 1, Dispatch,
                           releaseQueuedSpinLock(A[0], true))
// https://learn.microsoft.com/windows-hardware/drivers/ddi/wdm/nf-wdm-keacquireinstackqueuedspinlockatdpclevel
NEVERD_KERNEL_SPINLOCK_API(KeAcquireInStackQueuedSpinLockAtDpcLevel, 2,
                           Dispatch, acquireQueuedSpinLock(A[0], A[1], false))
// https://learn.microsoft.com/windows-hardware/drivers/ddi/wdm/nf-wdm-kereleaseinstackqueuedspinlockfromdpclevel
NEVERD_KERNEL_SPINLOCK_API(KeReleaseInStackQueuedSpinLockFromDpcLevel, 1,
                           Dispatch, releaseQueuedSpinLock(A[0], false))
