//===- KernelAPIIRQL.def - Kernel routine IRQL ceilings ------------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// Outer caller-IRQL limits from Microsoft's WDK DDI contracts. Conditional
/// limits remain with the routine or guest-memory implementation. Any means
/// any valid Windows x64 IRQL, not any integer representable by KIRQL.
///
//===----------------------------------------------------------------------===//

#ifdef NEVERD_KERNEL_IRQL_VALUE
NEVERD_KERNEL_IRQL_VALUE(Passive, scheduler::PassiveLevel)
NEVERD_KERNEL_IRQL_VALUE(APC, windows::APCLevel)
NEVERD_KERNEL_IRQL_VALUE(Dispatch, scheduler::DispatchLevel)
// WDK wdm.h _AMD64_: CLOCK_LEVEL is 13; device levels precede the clock.
// https://learn.microsoft.com/windows-hardware/drivers/kernel/managing-hardware-priorities
NEVERD_KERNEL_IRQL_VALUE(Device, 12)
NEVERD_KERNEL_IRQL_VALUE(Any, dispatcher::HighLevel)
#endif

