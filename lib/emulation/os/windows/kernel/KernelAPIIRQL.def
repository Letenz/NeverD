NEVERD_KERNEL_IRQL_API(MmIsAddressValid, Dispatch)
// https://learn.microsoft.com/windows-hardware/drivers/ddi/ntddk/nf-ntddk-mmgetphysicaladdress
// The query separately requires a live resident mapping with known ownership.
NEVERD_KERNEL_IRQL_API(MmGetPhysicalAddress, Any)
// Fixed nonpaged PFN query: this profile admits only live nonpaged-pool
// primary mappings; private backing and arbitrary reverse aliases refuse.
NEVERD_KERNEL_IRQL_API(MmGetVirtualForPhysical, Any)
// The base WDK query requires PASSIVE_LEVEL and returns caller-owned pool.
NEVERD_KERNEL_IRQL_API(MmGetPhysicalMemoryRanges, Passive)
