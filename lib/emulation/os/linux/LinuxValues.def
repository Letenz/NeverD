NEVERD_LINUX_VALUE(TooManyFiles, 24)
NEVERD_LINUX_VALUE(IllegalSeek, 29)
NEVERD_LINUX_VALUE(NameTooLong, 36)
NEVERD_LINUX_VALUE(FileDescriptorLimit, 4096)
NEVERD_LINUX_VALUE(FileCountLimit, 256)
NEVERD_LINUX_VALUE(FileByteLimit, 16 * 1024 * 1024)
NEVERD_LINUX_VALUE(FilePathLimit, 4096)
NEVERD_LINUX_VALUE(FileNameLimit, 255)
NEVERD_LINUX_VALUE(FileRegularMode, 0100000)
NEVERD_LINUX_VALUE(FilePermissionMask, 07777)
NEVERD_LINUX_VALUE(FileAccessMask, 7)
NEVERD_LINUX_VALUE(FileStatusSizeARM64, 128)
NEVERD_LINUX_VALUE(FileStatusSizeX64, 144)
NEVERD_LINUX_VALUE(OpenCloseOnExec, 02000000)
NEVERD_LINUX_VALUE(OpenLargeFileX64, 00100000)
NEVERD_LINUX_VALUE(OpenLargeFileARM64, 0400000)
NEVERD_LINUX_VALUE(SeekSet, 0)
NEVERD_LINUX_VALUE(SeekCurrent, 1)
NEVERD_LINUX_VALUE(SeekEnd, 2)
NEVERD_LINUX_VALUE(SeekHole, 4)
NEVERD_LINUX_VALUE(MmapBase, 0x100000000ULL)
