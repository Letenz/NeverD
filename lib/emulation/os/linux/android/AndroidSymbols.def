//===- AndroidSymbols.def - Bionic symbol vocabulary -----------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// One inventory owns symbol spellings and Bionic call bindings. Prefixes retain
// the existing diagnostics for unknown members of a modeled call family.
#ifndef NEVERD_ANDROID_SYMBOL
#define NEVERD_ANDROID_SYMBOL(Name, Text)
#define NEVERD_ANDROID_UNDEF_SYMBOL
#endif
#ifndef NEVERD_ANDROID_CALL
#define NEVERD_ANDROID_CALL(Name, Text, Handler)                               \
  NEVERD_ANDROID_SYMBOL(Name, Text)
#define NEVERD_ANDROID_UNDEF_CALL
#endif
#ifndef NEVERD_ANDROID_PREFIX
#define NEVERD_ANDROID_PREFIX(Name, Text, Handler)                             \
  NEVERD_ANDROID_SYMBOL(Name, Text)
#define NEVERD_ANDROID_UNDEF_PREFIX
#endif

NEVERD_ANDROID_CALL(DLOpen, "dlopen", openLibrary)
NEVERD_ANDROID_CALL(DLSym, "dlsym", lookupSymbol)
NEVERD_ANDROID_CALL(DLClose, "dlclose", closeLibrary)
NEVERD_ANDROID_CALL(DLError, "dlerror", getLinkerError)
NEVERD_ANDROID_CALL(PthreadOnce, "pthread_once", once)
#define NEVERD_ANDROID_THREAD_CALL(Name, Text, Method)                         \
  NEVERD_ANDROID_CALL(Name, Text, threadCall)
#include "AndroidThreads.def"
#undef NEVERD_ANDROID_THREAD_CALL
NEVERD_ANDROID_PREFIX(PthreadAttrPrefix, "pthread_attr_", threadAttributes)
#define NEVERD_ANDROID_THREAD_ATTRIBUTE_CALL(Name, Text, Method)               \
  NEVERD_ANDROID_CALL(Name, Text, threadAttributes)
#include "AndroidThreadAttributes.def"
#undef NEVERD_ANDROID_THREAD_ATTRIBUTE_CALL
NEVERD_ANDROID_CALL(CxaAtExit, "__cxa_atexit", registerExit)
NEVERD_ANDROID_CALL(CxaFinalize, "__cxa_finalize", finalizeCall)
NEVERD_ANDROID_CALL(StrtokR, "strtok_r", tokenize)
NEVERD_ANDROID_CALL(Sscanf, "sscanf", scan)
NEVERD_ANDROID_CALL(Vsscanf, "vsscanf", scan)
NEVERD_ANDROID_PREFIX(PthreadMutexAttrPrefix, "pthread_mutexattr_",
                      mutexAttributes)
NEVERD_ANDROID_PREFIX(PthreadMutexPrefix, "pthread_mutex", mutex)
NEVERD_ANDROID_CALL(Errno, "__errno", getErrno)
NEVERD_ANDROID_CALL(GetPageSize, "getpagesize", getPageSize)
NEVERD_ANDROID_CALL(Sysconf, "sysconf", queryConfiguration)
NEVERD_ANDROID_CALL(Time, "time", getTime)
NEVERD_ANDROID_CALL(DeviceAPILevel, "android_get_device_api_level", getAPILevel)
NEVERD_ANDROID_CALL(StackCheckFail, "__stack_chk_fail", failCall)
NEVERD_ANDROID_CALL(Abort, "abort", failCall)
NEVERD_ANDROID_CALL(Memcpy, "memcpy", copyMemory)
NEVERD_ANDROID_CALL(Memmove, "memmove", copyMemory)
NEVERD_ANDROID_CALL(Memset, "memset", setMemory)
NEVERD_ANDROID_CALL(Memcmp, "memcmp", compareMemory)
NEVERD_ANDROID_CALL(Strlen, "strlen", stringLength)
NEVERD_ANDROID_CALL(Strnlen, "strnlen", stringLength)
NEVERD_ANDROID_CALL(Strcmp, "strcmp", compareString)
NEVERD_ANDROID_CALL(Strncmp, "strncmp", compareString)
NEVERD_ANDROID_CALL(Strchr, "strchr", findCharacter)
NEVERD_ANDROID_CALL(Strrchr, "strrchr", findCharacter)
NEVERD_ANDROID_CALL(StrchrChk, "__strchr_chk", findCharacter)
NEVERD_ANDROID_CALL(StrrchrChk, "__strrchr_chk", findCharacter)
NEVERD_ANDROID_CALL(SystemPropertyGet, "__system_property_get", getProperty)
NEVERD_ANDROID_CALL(Malloc, "malloc", malloc)
NEVERD_ANDROID_CALL(Calloc, "calloc", calloc)
NEVERD_ANDROID_CALL(Realloc, "realloc", realloc)
NEVERD_ANDROID_CALL(Free, "free", free)
NEVERD_ANDROID_CALL(Syscall, "syscall", syscall)
NEVERD_ANDROID_SYMBOL(StandardIO, "__sF")
NEVERD_ANDROID_SYMBOL(StackGuard, "__stack_chk_guard")
NEVERD_ANDROID_CALL(MutexAttrInit, "pthread_mutexattr_init",
                    initializeMutexAttribute)
NEVERD_ANDROID_CALL(MutexAttrDestroy, "pthread_mutexattr_destroy",
                    destroyMutexAttribute)
NEVERD_ANDROID_CALL(MutexInit, "pthread_mutex_init", initializeMutex)
#define NEVERD_ANDROID_MUTEX_ATTRIBUTE_CALL(Name, Text, Mask, Shift, Maximum,  \
                                            Setter)                            \
  NEVERD_ANDROID_CALL(Name, Text, mutexAttributes)
#define NEVERD_ANDROID_MUTEX_CALL(Name, Text, Method)                          \
  NEVERD_ANDROID_CALL(Name, Text, mutex)
#include "AndroidMutex.def"
#undef NEVERD_ANDROID_MUTEX_CALL
#undef NEVERD_ANDROID_MUTEX_ATTRIBUTE_CALL
NEVERD_ANDROID_SYMBOL(PthreadMutexObjectPrefix, "pthread_mutex_")
NEVERD_ANDROID_CALL(Snprintf, "snprintf", format)
NEVERD_ANDROID_CALL(Vsnprintf, "vsnprintf", format)
NEVERD_ANDROID_CALL(Sprintf, "sprintf", format)
NEVERD_ANDROID_CALL(Vsprintf, "vsprintf", format)

#ifdef NEVERD_ANDROID_UNDEF_SYMBOL
#undef NEVERD_ANDROID_UNDEF_SYMBOL
#undef NEVERD_ANDROID_SYMBOL
#endif
#ifdef NEVERD_ANDROID_UNDEF_CALL
#undef NEVERD_ANDROID_UNDEF_CALL
#undef NEVERD_ANDROID_CALL
#endif
#ifdef NEVERD_ANDROID_UNDEF_PREFIX
#undef NEVERD_ANDROID_UNDEF_PREFIX
#undef NEVERD_ANDROID_PREFIX
#endif
