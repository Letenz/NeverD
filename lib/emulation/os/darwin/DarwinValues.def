NEVERD_DARWIN_VALUE(AtNoFollowAny, 0x800)
NEVERD_DARWIN_VALUE(GetPath, 50)
NEVERD_DARWIN_VALUE(DuplicateFD, 0)
NEVERD_DARWIN_VALUE(GetDescriptorFlags, 1)
NEVERD_DARWIN_VALUE(SetDescriptorFlags, 2)
NEVERD_DARWIN_VALUE(GetFileFlags, 3)
NEVERD_DARWIN_VALUE(DuplicateCloseOnExec, 67)
NEVERD_DARWIN_VALUE(FileStatusSize, 144)
NEVERD_DARWIN_VALUE(FileRegularMode, 0x8000)
NEVERD_DARWIN_VALUE(FileDirectoryMode, 0x4000)
NEVERD_DARWIN_VALUE(FilePermissionMask, 0x0fff)
