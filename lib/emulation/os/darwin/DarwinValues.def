//===- DarwinValues.def - Bounded Darwin execution vocabulary ------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// ABI facts: Apple XNU bsd/kern/syscalls.master, bsd/sys/mman.h and the
// architecture-specific bsd/dev/*/systemcalls.c. See docs/darwin-emulation.md.
#ifdef NEVERD_DARWIN_VALUE
NEVERD_DARWIN_VALUE(StackTop, 0x00007fffffe00000ULL)
NEVERD_DARWIN_VALUE(ReturnGate, 0x00007fffffc00000ULL)
NEVERD_DARWIN_VALUE(MaxStackSize, 1024 * 1024)
NEVERD_DARWIN_VALUE(UserLimit, 0x0000800000000000ULL)
NEVERD_DARWIN_VALUE(MinimumAddress, 0x10000)
NEVERD_DARWIN_VALUE(MmapBase, 0x1000000000ULL)
NEVERD_DARWIN_VALUE(PageSizeX64, 4096)
NEVERD_DARWIN_VALUE(PageSizeARM64, 16384)
NEVERD_DARWIN_VALUE(BSDClass, 0x02000000)
NEVERD_DARWIN_VALUE(SVCImmediate, 0x80)
NEVERD_DARWIN_VALUE(CarryARM64, 0x20000000)
NEVERD_DARWIN_VALUE(ProcessID, 1000)
NEVERD_DARWIN_VALUE(ParentID, 1)
NEVERD_DARWIN_VALUE(UserID, 1000)
NEVERD_DARWIN_VALUE(GroupID, 1000)
NEVERD_DARWIN_VALUE(BadDescriptor, 9)
NEVERD_DARWIN_VALUE(MaxWriteBytes, 0x7fffffff)
NEVERD_DARWIN_VALUE(BadAddress, 14)
NEVERD_DARWIN_VALUE(InvalidArgument, 22)
NEVERD_DARWIN_VALUE(NoMemory, 12)
NEVERD_DARWIN_VALUE(PermissionDenied, 13)
NEVERD_DARWIN_VALUE(MapPrivate, 0x2)
NEVERD_DARWIN_VALUE(MapAnonymous, 0x1000)
NEVERD_DARWIN_VALUE(ProtRead, 1)
NEVERD_DARWIN_VALUE(ProtWrite, 2)
NEVERD_DARWIN_VALUE(ProtExecute, 4)
#endif
#ifdef NEVERD_DARWIN_TEXT
NEVERD_DARWIN_TEXT(PageZeroSegment, "__PAGEZERO")
NEVERD_DARWIN_TEXT(DyldPath, "/usr/lib/dyld")
NEVERD_DARWIN_TEXT(ExecutablePathPrefix, "executable_path=")
#endif
#ifdef NEVERD_DARWIN_SERVICE
NEVERD_DARWIN_SERVICE(Exit, 1, None)
NEVERD_DARWIN_SERVICE(Write, 4, Wide)
NEVERD_DARWIN_SERVICE(GetPID, 20, Int)
NEVERD_DARWIN_SERVICE(GetUID, 24, UInt)
NEVERD_DARWIN_SERVICE(GetEUID, 25, UInt)
NEVERD_DARWIN_SERVICE(GetPPID, 39, Int)
NEVERD_DARWIN_SERVICE(GetEGID, 43, UInt)
NEVERD_DARWIN_SERVICE(GetGID, 47, UInt)
NEVERD_DARWIN_SERVICE(Munmap, 73, Int)
NEVERD_DARWIN_SERVICE(Mprotect, 74, Int)
NEVERD_DARWIN_SERVICE(Mmap, 197, Wide)
#endif

#ifdef NEVERD_DARWIN_DIAGNOSTIC
NEVERD_DARWIN_DIAGNOSTIC(
    MemoryMode, "unsupported Darwin memory mode (only private anonymous "
                "data mappings; no JIT, file or private-gate mutation)")
NEVERD_DARWIN_DIAGNOSTIC(MemoryDevice,
                         "Darwin memory service encountered device memory")
NEVERD_DARWIN_DIAGNOSTIC(MemoryMaximum,
                         "Darwin mapping lost its maximum protection")
NEVERD_DARWIN_DIAGNOSTIC(ImageArchitecture,
                         "Darwin profile requires a baseline x64 or ARM64 "
                         "executable; iOS devices require ARM64")
NEVERD_DARWIN_DIAGNOSTIC(
    ImagePlatform, "Mach-O platform does not match the explicit Darwin profile")
NEVERD_DARWIN_DIAGNOSTIC(
    ImageEntry, "unsupported or ambiguous Mach-O entry/thread/stack contract")
NEVERD_DARWIN_DIAGNOSTIC(ImageDependencies,
                         "Darwin profile does not implement dynamic "
                         "dependencies, fixups, initializers or TLS")
NEVERD_DARWIN_DIAGNOSTIC(
    ImageCommands, "unsupported Mach-O execution flags, commands or encryption")
NEVERD_DARWIN_DIAGNOSTIC(ImageInterpreter,
                         "unsupported Mach-O interpreter startup")
NEVERD_DARWIN_DIAGNOSTIC(
    StackAlignment,
    "Darwin stack size must be aligned to the guest OS page size")
NEVERD_DARWIN_DIAGNOSTIC(
    SegmentPermissions,
    "unsupported Darwin segment alignment, flags or permissions")
NEVERD_DARWIN_DIAGNOSTIC(PageZeroReservation,
                         "invalid Mach-O __PAGEZERO reservation")
NEVERD_DARWIN_DIAGNOSTIC(
    MachHeaderPermissions,
    "Darwin Mach header segment requires read and execute permissions")
NEVERD_DARWIN_DIAGNOSTIC(
    ReadableSegment, "Darwin profile requires readable nonempty permissions")
NEVERD_DARWIN_DIAGNOSTIC(ImageOverlap,
                         "Darwin image overlaps a reserved or non-user address")
NEVERD_DARWIN_DIAGNOSTIC(ProcessLimits,
                         "invalid Darwin process options or resource limits")
NEVERD_DARWIN_DIAGNOSTIC(ExecutableEntry,
                         "Darwin entry does not name executable user memory")
NEVERD_DARWIN_DIAGNOSTIC(MissingContinuation,
                         "CPU stopped without a Darwin continuation")
NEVERD_DARWIN_DIAGNOSTIC(ServiceTrap,
                         "trap does not match the Darwin BSD service ABI")
NEVERD_DARWIN_DIAGNOSTIC(StartupNul,
                         "Darwin startup string contains a NUL byte")
NEVERD_DARWIN_DIAGNOSTIC(StartupArguments,
                         "Darwin startup arguments exceed the stack")
NEVERD_DARWIN_DIAGNOSTIC(StartupVector,
                         "Darwin startup vector exceeds the stack")
NEVERD_DARWIN_DIAGNOSTIC(OutputLimit,
                         "captured Darwin output exceeds the workload limit")
NEVERD_DARWIN_DIAGNOSTIC(UnsupportedService, "unsupported Darwin service {0:x}")
#endif
