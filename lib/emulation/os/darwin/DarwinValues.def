// Cancellation is outside this single-thread profile; both entry numbers
// share the exact same service owner and retain the original report number.
#ifdef NEVERD_DARWIN_SERVICE_ALIAS
NEVERD_DARWIN_SERVICE_ALIAS(Read, 396)
NEVERD_DARWIN_SERVICE_ALIAS(Write, 397)
NEVERD_DARWIN_SERVICE_ALIAS(Open, 398)
NEVERD_DARWIN_SERVICE_ALIAS(Close, 399)
NEVERD_DARWIN_SERVICE_ALIAS(Fcntl, 406)
NEVERD_DARWIN_SERVICE_ALIAS(Pread, 414)
NEVERD_DARWIN_SERVICE_ALIAS(OpenAt, 464)
#endif

