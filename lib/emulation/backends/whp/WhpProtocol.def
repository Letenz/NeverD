//===- WhpProtocol.def - Dynamically resolved Windows hypervisor API
//-------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
#ifdef NEVERD_WHP_STRING
NEVERD_WHP_STRING(Library, L"WinHvPlatform.dll")
#endif
#ifdef NEVERD_WHP_TEXT
NEVERD_WHP_TEXT(HostFailure, "{0} (HRESULT {1:x8})")
NEVERD_WHP_TEXT(OperationFailure, "{0} ({2}; HRESULT {1:x8})")
NEVERD_WHP_TEXT(MapFailure, "{0} (HRESULT {1:x8}; GPA {2:x}; bytes {3})")
NEVERD_WHP_TEXT(XsaveSizeFailure,
                "{0} ({1}; returned bytes {2}; capacity {3}; admitted "
                "{4}..{5})")
NEVERD_WHP_TEXT(XsaveEncodeFailure, "{0} ({1}; preparing XSAVE; capacity {2})")
NEVERD_WHP_TEXT(XsaveDecodeFailure,
                "{0} ({1}; captured bytes {2}; XSTATE_BV {3:x}; "
                "XCOMP_BV {4:x}; FCW {5:x}; FOP {6:x}; MXCSR {7:x})")
NEVERD_WHP_TEXT(XsaveMetadataMismatch,
                "inconsistent WHP floating-point metadata "
                "({0}; XSAVE {1:x}; named register {2:x})")
#endif
#ifdef NEVERD_WHP_VALUE
// WHP's documented status is not declared by every Windows SDK.
NEVERD_WHP_VALUE(InsufficientBuffer, 0x80370301)
// VP zero serves the cooperative cache; the other slots retain parallel CPUs.
NEVERD_WHP_VALUE(ProcessorCount, 32)
#endif
#ifdef NEVERD_WHP_ADDRESS
// Leave the low MMIO aperture available to the ARM64 interrupt controller.
NEVERD_WHP_ADDRESS(ParallelWindowBase, 0x100000000ull)
NEVERD_WHP_ADDRESS(ProcessorWindowSize,
                   memory::MaxRAM + memory::ProjectionReserve)
NEVERD_WHP_ADDRESS(RedistributorBase, 0x81000000ull)
NEVERD_WHP_ADDRESS(RedistributorStride, 0x20000ull)
#endif
#ifdef NEVERD_WHP_FUNCTION
NEVERD_WHP_FUNCTION(WHvGetCapability)
NEVERD_WHP_FUNCTION(WHvCreatePartition)
NEVERD_WHP_FUNCTION(WHvDeletePartition)
NEVERD_WHP_FUNCTION(WHvGetPartitionProperty)
NEVERD_WHP_FUNCTION(WHvSetPartitionProperty)
NEVERD_WHP_FUNCTION(WHvSetupPartition)
NEVERD_WHP_FUNCTION(WHvMapGpaRange)
NEVERD_WHP_FUNCTION(WHvUnmapGpaRange)
NEVERD_WHP_FUNCTION(WHvCreateVirtualProcessor)
NEVERD_WHP_FUNCTION(WHvDeleteVirtualProcessor)
NEVERD_WHP_FUNCTION(WHvGetVirtualProcessorRegisters)
NEVERD_WHP_FUNCTION(WHvSetVirtualProcessorRegisters)
NEVERD_WHP_FUNCTION(WHvRunVirtualProcessor)
NEVERD_WHP_FUNCTION(WHvCancelRunVirtualProcessor)
#endif
#if defined(_M_X64) || defined(__x86_64__)
#ifdef NEVERD_WHP_X64_OPTIONAL_FUNCTION
NEVERD_WHP_X64_OPTIONAL_FUNCTION(WHvGetVirtualProcessorState)
NEVERD_WHP_X64_OPTIONAL_FUNCTION(WHvSetVirtualProcessorState)
NEVERD_WHP_X64_OPTIONAL_FUNCTION(WHvGetVirtualProcessorXsaveState)
NEVERD_WHP_X64_OPTIONAL_FUNCTION(WHvSetVirtualProcessorXsaveState)
#endif
#endif
