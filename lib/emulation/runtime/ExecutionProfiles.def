//===- ExecutionProfiles.def - Authoritative CPU semantic profiles -------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// The fixed checked profiles select explicit supervisor or user ISA subsets.
// Flat software profiles inherit the pinned engine's instruction model; they do
// not establish architectural user/supervisor isolation or full OS
// compatibility.
#ifdef NEVERD_EXECUTION_FEATURE_GROUP
NEVERD_EXECUTION_FEATURE_GROUP(
    CommonFeatures,
    Feature::ScalarInteger | Feature::VectorRegisterState |
        Feature::InstructionObservation | Feature::SharedPhysicalMemory |
        Feature::MultipleAddressSpaces | Feature::RetainedMemoryViews |
        Feature::TypedExits | Feature::CooperativeCPUs | Feature::ThreadPointer)
NEVERD_EXECUTION_FEATURE_GROUP(SoftwareFeatures,
                               CommonFeatures | Feature::FloatingPoint |
                                   Feature::SIMD | Feature::MMIO)
NEVERD_EXECUTION_FEATURE_GROUP(CheckedFeatures,
                               CommonFeatures | Feature::MemoryPreflight)
NEVERD_EXECUTION_FEATURE_GROUP(UserFeatures,
                               CheckedFeatures |
                                   Feature::UserSupervisorIsolation |
                                   Feature::ServiceTraps)
#endif

#ifdef NEVERD_BACKEND_EXECUTION_FEATURE
// Device atomics require a prepared provider independently of scalar MMIO.
#define NEVERD_ATOMIC_DEVICE(Backend)                                          \
  NEVERD_BACKEND_EXECUTION_FEATURE(Backend, X64, CheckedX64, MMIOAtomics)      \
  NEVERD_BACKEND_EXECUTION_FEATURE(Backend, AArch64, CheckedAArch64,           \
                                   MMIOAtomics)
NEVERD_ATOMIC_DEVICE(KVM)
NEVERD_ATOMIC_DEVICE(WHP)
NEVERD_ATOMIC_DEVICE(Unicorn)
#undef NEVERD_ATOMIC_DEVICE
NEVERD_BACKEND_EXECUTION_FEATURE(KVM, X64, Legacy, MMIOAtomics)
NEVERD_BACKEND_EXECUTION_FEATURE(WHP, X64, Legacy, MMIOAtomics)
// Explicitly requesting parallel_cpus selects concurrent checked runs with
// read-only native overlap and sequentially consistent shared write commits.
NEVERD_BACKEND_EXECUTION_FEATURE(KVM, X64, Legacy, ParallelCPUs)
NEVERD_BACKEND_EXECUTION_FEATURE(WHP, X64, Legacy, ParallelCPUs)
#define NEVERD_PARALLEL_CHECKED(Backend)                                       \
  NEVERD_BACKEND_EXECUTION_FEATURE(Backend, X64, CheckedX64, ParallelCPUs)     \
  NEVERD_BACKEND_EXECUTION_FEATURE(Backend, X64, CheckedUserX64, ParallelCPUs) \
  NEVERD_BACKEND_EXECUTION_FEATURE(Backend, AArch64, CheckedAArch64,           \
                                   ParallelCPUs)                               \
  NEVERD_BACKEND_EXECUTION_FEATURE(Backend, AArch64, CheckedUserAArch64,       \
                                   ParallelCPUs)
NEVERD_PARALLEL_CHECKED(KVM)
NEVERD_PARALLEL_CHECKED(WHP)
NEVERD_PARALLEL_CHECKED(Unicorn)
#undef NEVERD_PARALLEL_CHECKED
// Precise unmasked exceptions for the admitted legacy SSE instructions. This
// extends these native contracts only; the portable engine remains masked.
NEVERD_BACKEND_EXECUTION_FEATURE(KVM, X64, Legacy, SIMDExceptions)
NEVERD_BACKEND_EXECUTION_FEATURE(KVM, X64, CheckedX64, SIMDExceptions)
NEVERD_BACKEND_EXECUTION_FEATURE(KVM, X64, CheckedUserX64, SIMDExceptions)
NEVERD_BACKEND_EXECUTION_FEATURE(WHP, X64, Legacy, SIMDExceptions)
NEVERD_BACKEND_EXECUTION_FEATURE(WHP, X64, CheckedX64, SIMDExceptions)
NEVERD_BACKEND_EXECUTION_FEATURE(WHP, X64, CheckedUserX64, SIMDExceptions)
#endif
#ifdef NEVERD_EXECUTION_PROFILE
// Name, contract, ISA, privilege, address model, features, native, allowlist.
NEVERD_EXECUTION_PROFILE(LegacyX64, Legacy, X64, Flat, Flat, SoftwareFeatures,
                         false, false)
NEVERD_EXECUTION_PROFILE(SoftwareX64, Software, X64, Flat, Flat,
                         SoftwareFeatures, false, false)
NEVERD_EXECUTION_PROFILE(SoftwareARM64, Software, AArch64, Flat, Flat,
                         SoftwareFeatures, false, false)
NEVERD_EXECUTION_PROFILE(CheckedX64, CheckedX64, X64, Supervisor, Canonical,
                         CheckedFeatures | Feature::SIMD |
                             Feature::FloatingPoint | Feature::MMIO,
                         true, true)
NEVERD_EXECUTION_PROFILE(CheckedARM64, CheckedAArch64, AArch64, Supervisor,
                         Split,
                         CheckedFeatures | Feature::SIMD |
                             Feature::FloatingPoint,
                         true, true)
NEVERD_EXECUTION_PROFILE(CheckedUserX64, CheckedUserX64, X64, User, Canonical,
                         UserFeatures | Feature::SIMD | Feature::FloatingPoint,
                         true, true)
NEVERD_EXECUTION_PROFILE(CheckedUserARM64, CheckedUserAArch64, AArch64, User,
                         Split,
                         UserFeatures | Feature::SIMD | Feature::FloatingPoint,
                         true, true)
#endif

#ifdef NEVERD_NATIVE_EXECUTION_PROFILE
// Backend-qualified driver execution preserves the Windows environment policy
// while using the architectural supervisor address/observation boundary.
NEVERD_NATIVE_EXECUTION_PROFILE(NativeLegacyX64, Legacy, X64, Supervisor,
                                Canonical,
                                CheckedFeatures | Feature::SIMD |
                                    Feature::FloatingPoint | Feature::MMIO,
                                true, true)
#endif
