//===- RelocationFootprints.def - Bytes relocations rewrite -----*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// The bytes of an object's code that a relocation may leave different in
/// the linked image, which a pattern line leaves unstated.  Define the macros
/// a consumer reads before including this file; the others expand to nothing.
///
///   NEVERD_COFF_<MACHINE>_RELOCATION(Type, Width)
///       a COFF relocation of Type rewrites Width bytes at its offset
///   NEVERD_ELF_<MACHINE>_RELOCATION(Type, Before, Width)
///       an ELF relocation of Type may rewrite Before + Width bytes from
///       Before bytes ahead of its field
///   NEVERD_ELF_<MACHINE>_RELOCATIONS(First, Last, Before, Width)
///       so may every type from First to Last not listed one by one
///   NEVERD_ELF_ARM_UNSUPPORTED_RELOCATION(Type)
///       a type in such a range that a relocatable object does not hold
///   NEVERD_OTHER_RELOCATION(Width)
///       a relocation of any other object rewrites Width bytes
///
//===----------------------------------------------------------------------===//

#ifndef NEVERD_COFF_I386_RELOCATION
#define NEVERD_COFF_I386_RELOCATION(Type, Width)
#endif
#ifndef NEVERD_COFF_AMD64_RELOCATION
#define NEVERD_COFF_AMD64_RELOCATION(Type, Width)
#endif
#ifndef NEVERD_COFF_ARM_RELOCATION
#define NEVERD_COFF_ARM_RELOCATION(Type, Width)
#endif
#ifndef NEVERD_COFF_ARM64_RELOCATION
#define NEVERD_COFF_ARM64_RELOCATION(Type, Width)
#endif
#ifndef NEVERD_ELF_X86_64_RELOCATION
#define NEVERD_ELF_X86_64_RELOCATION(Type, Before, Width)
#endif
#ifndef NEVERD_ELF_386_RELOCATION
#define NEVERD_ELF_386_RELOCATION(Type, Before, Width)
#endif
#ifndef NEVERD_ELF_AARCH64_RELOCATION
#define NEVERD_ELF_AARCH64_RELOCATION(Type, Before, Width)
#endif
#ifndef NEVERD_ELF_AARCH64_RELOCATIONS
#define NEVERD_ELF_AARCH64_RELOCATIONS(First, Last, Before, Width)
#endif
#ifndef NEVERD_ELF_ARM_RELOCATION
#define NEVERD_ELF_ARM_RELOCATION(Type, Before, Width)
#endif
#ifndef NEVERD_ELF_ARM_RELOCATIONS
#define NEVERD_ELF_ARM_RELOCATIONS(First, Last, Before, Width)
#endif
#ifndef NEVERD_ELF_ARM_UNSUPPORTED_RELOCATION
#define NEVERD_ELF_ARM_UNSUPPORTED_RELOCATION(Type)
#endif
#ifndef NEVERD_OTHER_RELOCATION
#define NEVERD_OTHER_RELOCATION(Width)
#endif

//===----------------------------------------------------------------------===//
// COFF.  An instruction relocation covers the whole instruction it patches,
// because a pattern cannot leave part of a byte unstated; pair and absolute
// relocations rewrite nothing.
//===----------------------------------------------------------------------===//

NEVERD_COFF_I386_RELOCATION(IMAGE_REL_I386_ABSOLUTE, 0)
NEVERD_COFF_I386_RELOCATION(IMAGE_REL_I386_DIR16, 2)
NEVERD_COFF_I386_RELOCATION(IMAGE_REL_I386_REL16, 2)
NEVERD_COFF_I386_RELOCATION(IMAGE_REL_I386_SEG12, 2)
NEVERD_COFF_I386_RELOCATION(IMAGE_REL_I386_SECTION, 2)
NEVERD_COFF_I386_RELOCATION(IMAGE_REL_I386_SECREL7, 1)
NEVERD_COFF_I386_RELOCATION(IMAGE_REL_I386_DIR32, 4)
NEVERD_COFF_I386_RELOCATION(IMAGE_REL_I386_DIR32NB, 4)
NEVERD_COFF_I386_RELOCATION(IMAGE_REL_I386_SECREL, 4)
NEVERD_COFF_I386_RELOCATION(IMAGE_REL_I386_TOKEN, 4)
NEVERD_COFF_I386_RELOCATION(IMAGE_REL_I386_REL32, 4)

NEVERD_COFF_AMD64_RELOCATION(IMAGE_REL_AMD64_ABSOLUTE, 0)
NEVERD_COFF_AMD64_RELOCATION(IMAGE_REL_AMD64_PAIR, 0)
NEVERD_COFF_AMD64_RELOCATION(IMAGE_REL_AMD64_SECREL7, 1)
NEVERD_COFF_AMD64_RELOCATION(IMAGE_REL_AMD64_SECTION, 2)
NEVERD_COFF_AMD64_RELOCATION(IMAGE_REL_AMD64_ADDR32, 4)
NEVERD_COFF_AMD64_RELOCATION(IMAGE_REL_AMD64_ADDR32NB, 4)
NEVERD_COFF_AMD64_RELOCATION(IMAGE_REL_AMD64_REL32, 4)
NEVERD_COFF_AMD64_RELOCATION(IMAGE_REL_AMD64_REL32_1, 4)
NEVERD_COFF_AMD64_RELOCATION(IMAGE_REL_AMD64_REL32_2, 4)
NEVERD_COFF_AMD64_RELOCATION(IMAGE_REL_AMD64_REL32_3, 4)
NEVERD_COFF_AMD64_RELOCATION(IMAGE_REL_AMD64_REL32_4, 4)
NEVERD_COFF_AMD64_RELOCATION(IMAGE_REL_AMD64_REL32_5, 4)
NEVERD_COFF_AMD64_RELOCATION(IMAGE_REL_AMD64_SECREL, 4)
NEVERD_COFF_AMD64_RELOCATION(IMAGE_REL_AMD64_TOKEN, 4)
NEVERD_COFF_AMD64_RELOCATION(IMAGE_REL_AMD64_SREL32, 4)
NEVERD_COFF_AMD64_RELOCATION(IMAGE_REL_AMD64_SSPAN32, 4)
NEVERD_COFF_AMD64_RELOCATION(IMAGE_REL_AMD64_ADDR64, 8)

NEVERD_COFF_ARM_RELOCATION(IMAGE_REL_ARM_ABSOLUTE, 0)
NEVERD_COFF_ARM_RELOCATION(IMAGE_REL_ARM_PAIR, 0)
NEVERD_COFF_ARM_RELOCATION(IMAGE_REL_ARM_SECTION, 2)
NEVERD_COFF_ARM_RELOCATION(IMAGE_REL_ARM_ADDR32, 4)
NEVERD_COFF_ARM_RELOCATION(IMAGE_REL_ARM_ADDR32NB, 4)
NEVERD_COFF_ARM_RELOCATION(IMAGE_REL_ARM_BRANCH24, 4)
NEVERD_COFF_ARM_RELOCATION(IMAGE_REL_ARM_BRANCH11, 4)
NEVERD_COFF_ARM_RELOCATION(IMAGE_REL_ARM_TOKEN, 4)
NEVERD_COFF_ARM_RELOCATION(IMAGE_REL_ARM_BLX24, 4)
NEVERD_COFF_ARM_RELOCATION(IMAGE_REL_ARM_BLX11, 4)
NEVERD_COFF_ARM_RELOCATION(IMAGE_REL_ARM_REL32, 4)
NEVERD_COFF_ARM_RELOCATION(IMAGE_REL_ARM_SECREL, 4)
NEVERD_COFF_ARM_RELOCATION(IMAGE_REL_ARM_BRANCH20T, 4)
NEVERD_COFF_ARM_RELOCATION(IMAGE_REL_ARM_BRANCH24T, 4)
NEVERD_COFF_ARM_RELOCATION(IMAGE_REL_ARM_BLX23T, 4)
// A MOVW/MOVT pair: the low half of the address in the first instruction and
// the high half in the second.
NEVERD_COFF_ARM_RELOCATION(IMAGE_REL_ARM_MOV32A, 8)
NEVERD_COFF_ARM_RELOCATION(IMAGE_REL_ARM_MOV32T, 8)

// ARM64EC and ARM64X objects use these too.
NEVERD_COFF_ARM64_RELOCATION(IMAGE_REL_ARM64_ABSOLUTE, 0)
NEVERD_COFF_ARM64_RELOCATION(IMAGE_REL_ARM64_SECTION, 2)
NEVERD_COFF_ARM64_RELOCATION(IMAGE_REL_ARM64_ADDR32, 4)
NEVERD_COFF_ARM64_RELOCATION(IMAGE_REL_ARM64_ADDR32NB, 4)
NEVERD_COFF_ARM64_RELOCATION(IMAGE_REL_ARM64_BRANCH26, 4)
NEVERD_COFF_ARM64_RELOCATION(IMAGE_REL_ARM64_PAGEBASE_REL21, 4)
NEVERD_COFF_ARM64_RELOCATION(IMAGE_REL_ARM64_REL21, 4)
NEVERD_COFF_ARM64_RELOCATION(IMAGE_REL_ARM64_PAGEOFFSET_12A, 4)
NEVERD_COFF_ARM64_RELOCATION(IMAGE_REL_ARM64_PAGEOFFSET_12L, 4)
NEVERD_COFF_ARM64_RELOCATION(IMAGE_REL_ARM64_SECREL, 4)
NEVERD_COFF_ARM64_RELOCATION(IMAGE_REL_ARM64_SECREL_LOW12A, 4)
NEVERD_COFF_ARM64_RELOCATION(IMAGE_REL_ARM64_SECREL_HIGH12A, 4)
NEVERD_COFF_ARM64_RELOCATION(IMAGE_REL_ARM64_SECREL_LOW12L, 4)
NEVERD_COFF_ARM64_RELOCATION(IMAGE_REL_ARM64_TOKEN, 4)
NEVERD_COFF_ARM64_RELOCATION(IMAGE_REL_ARM64_BRANCH19, 4)
NEVERD_COFF_ARM64_RELOCATION(IMAGE_REL_ARM64_BRANCH14, 4)
NEVERD_COFF_ARM64_RELOCATION(IMAGE_REL_ARM64_REL32, 4)
NEVERD_COFF_ARM64_RELOCATION(IMAGE_REL_ARM64_ADDR64, 8)

//===----------------------------------------------------------------------===//
// ELF.  A linker does more to ELF code than fill in fields: it relaxes GOT
// loads, and in a static or executable link it replaces whole TLS access
// sequences, so a footprint spans the most any form of the instruction or
// sequence its relocation marks takes.  Markers that rewrite nothing have an
// empty footprint.
//===----------------------------------------------------------------------===//

NEVERD_ELF_X86_64_RELOCATION(R_X86_64_NONE, 0, 0)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_8, 0, 1)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_PC8, 0, 1)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_16, 0, 2)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_PC16, 0, 2)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_PC32, 0, 4)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_GOT32, 0, 4)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_PLT32, 0, 4)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_GOTPCREL, 0, 4)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_32, 0, 4)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_32S, 0, 4)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_DTPOFF32, 0, 4)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_TPOFF32, 0, 4)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_GOTPC32, 0, 4)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_SIZE32, 0, 4)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_64, 0, 8)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_DTPMOD64, 0, 8)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_DTPOFF64, 0, 8)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_TPOFF64, 0, 8)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_PC64, 0, 8)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_GOTOFF64, 0, 8)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_GOT64, 0, 8)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_GOTPCREL64, 0, 8)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_GOTPC64, 0, 8)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_GOTPLT64, 0, 8)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_PLTOFF64, 0, 8)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_SIZE64, 0, 8)
// A relaxable GOT load: the opcode and ModRM ahead of the field become those
// of `lea`, a direct `call`/`jmp` (with a prefix or a trailing `nop`) or an
// immediate form.  The REX variants reach one byte further back to the REX
// prefix, the CODE_4 ones to a two-byte REX2 prefix.
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_GOTPCRELX, 2, 4)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_REX_GOTPCRELX, 3, 4)
// Initial-exec and descriptor loads become immediate moves when the variable
// is the executable's own.
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_GOTTPOFF, 3, 4)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_GOTPC32_TLSDESC, 3, 4)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_CODE_4_GOTPCRELX, 4, 4)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_CODE_4_GOTTPOFF, 4, 4)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_CODE_4_GOTPC32_TLSDESC, 4, 4)
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_CODE_6_GOTTPOFF, 6, 4)
// The descriptor call `call *(%rax)` becomes a two-byte no-op.
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_TLSDESC_CALL, 0, 2)
// General dynamic: `.byte 0x66; lea x@tlsgd(%rip),%rdi` and a call to
// __tls_get_addr, 16 bytes with the field at 4, all rewritten.
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_TLSGD, 4, 12)
// Local dynamic: `lea x@tlsld(%rip),%rdi` and the call, 12 bytes (13 with
// `call *__tls_get_addr@GOTPCREL(%rip)`) with the field at 3.
NEVERD_ELF_X86_64_RELOCATION(R_X86_64_TLSLD, 3, 10)

NEVERD_ELF_386_RELOCATION(R_386_NONE, 0, 0)
NEVERD_ELF_386_RELOCATION(R_386_8, 0, 1)
NEVERD_ELF_386_RELOCATION(R_386_PC8, 0, 1)
NEVERD_ELF_386_RELOCATION(R_386_16, 0, 2)
NEVERD_ELF_386_RELOCATION(R_386_PC16, 0, 2)
NEVERD_ELF_386_RELOCATION(R_386_32, 0, 4)
NEVERD_ELF_386_RELOCATION(R_386_PC32, 0, 4)
NEVERD_ELF_386_RELOCATION(R_386_GOT32, 0, 4)
NEVERD_ELF_386_RELOCATION(R_386_PLT32, 0, 4)
NEVERD_ELF_386_RELOCATION(R_386_GOTOFF, 0, 4)
NEVERD_ELF_386_RELOCATION(R_386_GOTPC, 0, 4)
NEVERD_ELF_386_RELOCATION(R_386_32PLT, 0, 4)
NEVERD_ELF_386_RELOCATION(R_386_TLS_TPOFF, 0, 4)
NEVERD_ELF_386_RELOCATION(R_386_TLS_LE, 0, 4)
NEVERD_ELF_386_RELOCATION(R_386_TLS_LDO_32, 0, 4)
NEVERD_ELF_386_RELOCATION(R_386_TLS_LE_32, 0, 4)
NEVERD_ELF_386_RELOCATION(R_386_TLS_DTPMOD32, 0, 4)
NEVERD_ELF_386_RELOCATION(R_386_TLS_DTPOFF32, 0, 4)
NEVERD_ELF_386_RELOCATION(R_386_TLS_TPOFF32, 0, 4)
// Relaxable GOT loads and initial-exec or descriptor loads: the opcode and
// ModRM ahead of the field change with the instruction.
NEVERD_ELF_386_RELOCATION(R_386_GOT32X, 2, 4)
NEVERD_ELF_386_RELOCATION(R_386_TLS_IE, 2, 4)
NEVERD_ELF_386_RELOCATION(R_386_TLS_GOTIE, 2, 4)
NEVERD_ELF_386_RELOCATION(R_386_TLS_IE_32, 2, 4)
NEVERD_ELF_386_RELOCATION(R_386_TLS_GOTDESC, 2, 4)
NEVERD_ELF_386_RELOCATION(R_386_TLS_DESC_CALL, 0, 2)
// General dynamic: `lea x@tlsgd(,%ebx,1),%eax` (the field at 3) and a call to
// ___tls_get_addr, direct or through the GOT.
NEVERD_ELF_386_RELOCATION(R_386_TLS_GD, 3, 10)
// Local dynamic: `lea x@tlsldm(%ebx),%eax` (the field at 2) and the call.
NEVERD_ELF_386_RELOCATION(R_386_TLS_LDM, 2, 10)

NEVERD_ELF_AARCH64_RELOCATION(R_AARCH64_NONE, 0, 0)
NEVERD_ELF_AARCH64_RELOCATION(R_AARCH64_ABS16, 0, 2)
NEVERD_ELF_AARCH64_RELOCATION(R_AARCH64_PREL16, 0, 2)
NEVERD_ELF_AARCH64_RELOCATION(R_AARCH64_ABS32, 0, 4)
NEVERD_ELF_AARCH64_RELOCATION(R_AARCH64_PREL32, 0, 4)
NEVERD_ELF_AARCH64_RELOCATION(R_AARCH64_GOTREL32, 0, 4)
NEVERD_ELF_AARCH64_RELOCATION(R_AARCH64_PLT32, 0, 4)
NEVERD_ELF_AARCH64_RELOCATION(R_AARCH64_GOTPCREL32, 0, 4)
NEVERD_ELF_AARCH64_RELOCATION(R_AARCH64_ABS64, 0, 8)
NEVERD_ELF_AARCH64_RELOCATION(R_AARCH64_PREL64, 0, 8)
NEVERD_ELF_AARCH64_RELOCATION(R_AARCH64_GOTREL64, 0, 8)
NEVERD_ELF_AARCH64_RELOCATION(R_AARCH64_AUTH_ABS64, 0, 8)
// Every other static relocation patches one instruction, and TLS relaxation
// rewrites only instructions that carry one of their own (TLSDESC_CALL marks
// the `blr` that becomes a `nop`).
NEVERD_ELF_AARCH64_RELOCATION(R_AARCH64_PATCHINST, 0, 4)
NEVERD_ELF_AARCH64_RELOCATIONS(R_AARCH64_MOVW_UABS_G0,
                               R_AARCH64_LD64_GOTPAGE_LO15, 0, 4)
NEVERD_ELF_AARCH64_RELOCATIONS(R_AARCH64_TLSGD_ADR_PREL21,
                               R_AARCH64_TLSLD_LDST128_DTPREL_LO12_NC, 0, 4)
NEVERD_ELF_AARCH64_RELOCATIONS(R_AARCH64_AUTH_MOVW_GOTOFF_G0,
                               R_AARCH64_AUTH_TLSDESC_ADD_LO12, 0, 4)

NEVERD_ELF_ARM_RELOCATION(R_ARM_NONE, 0, 0)
NEVERD_ELF_ARM_RELOCATION(R_ARM_GNU_VTENTRY, 0, 0)
NEVERD_ELF_ARM_RELOCATION(R_ARM_GNU_VTINHERIT, 0, 0)
NEVERD_ELF_ARM_RELOCATION(R_ARM_ABS8, 0, 1)
// Data halfwords, and the 16-bit Thumb instructions.
NEVERD_ELF_ARM_RELOCATION(R_ARM_ABS16, 0, 2)
NEVERD_ELF_ARM_RELOCATION(R_ARM_THM_ABS5, 0, 2)
NEVERD_ELF_ARM_RELOCATION(R_ARM_THM_PC8, 0, 2)
NEVERD_ELF_ARM_RELOCATION(R_ARM_THM_SWI8, 0, 2)
NEVERD_ELF_ARM_RELOCATION(R_ARM_THM_JUMP6, 0, 2)
NEVERD_ELF_ARM_RELOCATION(R_ARM_THM_JUMP11, 0, 2)
NEVERD_ELF_ARM_RELOCATION(R_ARM_THM_JUMP8, 0, 2)
NEVERD_ELF_ARM_RELOCATION(R_ARM_THM_TLS_DESCSEQ16, 0, 2)
NEVERD_ELF_ARM_RELOCATION(R_ARM_THM_ALU_ABS_G0_NC, 0, 2)
NEVERD_ELF_ARM_RELOCATION(R_ARM_THM_ALU_ABS_G1_NC, 0, 2)
NEVERD_ELF_ARM_RELOCATION(R_ARM_THM_ALU_ABS_G2_NC, 0, 2)
NEVERD_ELF_ARM_RELOCATION(R_ARM_THM_ALU_ABS_G3, 0, 2)
// The dynamic types and the platform-private ones.
NEVERD_ELF_ARM_UNSUPPORTED_RELOCATION(R_ARM_TLS_DESC)
NEVERD_ELF_ARM_UNSUPPORTED_RELOCATION(R_ARM_TLS_DTPMOD32)
NEVERD_ELF_ARM_UNSUPPORTED_RELOCATION(R_ARM_TLS_DTPOFF32)
NEVERD_ELF_ARM_UNSUPPORTED_RELOCATION(R_ARM_TLS_TPOFF32)
NEVERD_ELF_ARM_UNSUPPORTED_RELOCATION(R_ARM_COPY)
NEVERD_ELF_ARM_UNSUPPORTED_RELOCATION(R_ARM_GLOB_DAT)
NEVERD_ELF_ARM_UNSUPPORTED_RELOCATION(R_ARM_JUMP_SLOT)
NEVERD_ELF_ARM_UNSUPPORTED_RELOCATION(R_ARM_RELATIVE)
NEVERD_ELF_ARM_UNSUPPORTED_RELOCATION(R_ARM_IRELATIVE)
// Every other static relocation patches a data word, an ARM instruction or a
// 32-bit Thumb instruction -- including V4BX, whose `bx` a linker for ARMv4
// rewrites, and BL, which interworking turns into BLX.
NEVERD_ELF_ARM_RELOCATION(R_ARM_THM_TLS_DESCSEQ32, 0, 4)
NEVERD_ELF_ARM_RELOCATIONS(R_ARM_NONE, R_ARM_TLS_IE12GP, 0, 4)
NEVERD_ELF_ARM_RELOCATIONS(R_ARM_THM_BF16, R_ARM_THM_BF18, 0, 4)

//===----------------------------------------------------------------------===//
// Any other object: a relocation is taken to cover four bytes.
//===----------------------------------------------------------------------===//

NEVERD_OTHER_RELOCATION(4)

#undef NEVERD_COFF_I386_RELOCATION
#undef NEVERD_COFF_AMD64_RELOCATION
#undef NEVERD_COFF_ARM_RELOCATION
#undef NEVERD_COFF_ARM64_RELOCATION
#undef NEVERD_ELF_X86_64_RELOCATION
#undef NEVERD_ELF_386_RELOCATION
#undef NEVERD_ELF_AARCH64_RELOCATION
#undef NEVERD_ELF_AARCH64_RELOCATIONS
#undef NEVERD_ELF_ARM_RELOCATION
#undef NEVERD_ELF_ARM_RELOCATIONS
#undef NEVERD_ELF_ARM_UNSUPPORTED_RELOCATION
#undef NEVERD_OTHER_RELOCATION
