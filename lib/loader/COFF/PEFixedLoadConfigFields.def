//===- PEFixedLoadConfigFields.def - Fixed-image load configuration -------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
/// \file
/// Audited PE32+ load-configuration fields. Unsupported nonzero fields refuse
/// the fixed snapshot; callable slots and the security cookie are loader writes.
//===----------------------------------------------------------------------===//

#ifndef NEVERD_PE_FIXED_LOAD_CONFIG_FIELD
#error "Define NEVERD_PE_FIXED_LOAD_CONFIG_FIELD before including this file"
#endif

NEVERD_PE_FIXED_LOAD_CONFIG_FIELD(Size, Scalar)
NEVERD_PE_FIXED_LOAD_CONFIG_FIELD(TimeDateStamp, Scalar)
NEVERD_PE_FIXED_LOAD_CONFIG_FIELD(MajorVersion, Zero)
NEVERD_PE_FIXED_LOAD_CONFIG_FIELD(MinorVersion, Zero)
NEVERD_PE_FIXED_LOAD_CONFIG_FIELD(GlobalFlagsClear, Scalar)
NEVERD_PE_FIXED_LOAD_CONFIG_FIELD(GlobalFlagsSet, Scalar)
NEVERD_PE_FIXED_LOAD_CONFIG_FIELD(CriticalSectionDefaultTimeout, Scalar)
NEVERD_PE_FIXED_LOAD_CONFIG_FIELD(DeCommitFreeBlockThreshold, Scalar)
NEVERD_PE_FIXED_LOAD_CONFIG_FIELD(DeCommitTotalFreeThreshold, Scalar)
NEVERD_PE_FIXED_LOAD_CONFIG_FIELD(LockPrefixTable, Zero)
NEVERD_PE_FIXED_LOAD_CONFIG_FIELD(MaximumAllocationSize, Scalar)
NEVERD_PE_FIXED_LOAD_CONFIG_FIELD(VirtualMemoryThreshold, Scalar)
NEVERD_PE_FIXED_LOAD_CONFIG_FIELD(ProcessAffinityMask, Scalar)
NEVERD_PE_FIXED_LOAD_CONFIG_FIELD(ProcessHeapFlags, Scalar)
