NEVERD_PE_FIXED_LOAD_CONFIG_FIELD(SEHandlerTable, Zero)
NEVERD_PE_FIXED_LOAD_CONFIG_FIELD(SEHandlerCount, Zero)
NEVERD_PE_FIXED_LOAD_CONFIG_FIELD(GuardCFCheckFunction, GuardCFCheck)
NEVERD_PE_FIXED_LOAD_CONFIG_FIELD(GuardCFCheckDispatch, GuardCFDispatch)
NEVERD_PE_FIXED_LOAD_CONFIG_FIELD(GuardCFFunctionTable, Zero)
NEVERD_PE_FIXED_LOAD_CONFIG_FIELD(GuardCFFunctionCount, Zero)
NEVERD_PE_FIXED_LOAD_CONFIG_FIELD(GuardFlags, GuardFlags)
NEVERD_PE_FIXED_LOAD_CONFIG_FIELD(CodeIntegrity, Zero)
