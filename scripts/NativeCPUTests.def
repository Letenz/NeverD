NEVERD_NATIVE_CPU_OWNER(NeverDRunControlTests)
NEVERD_NATIVE_CPU_OWNER(NeverDWindowsProcessTests)
NEVERD_NATIVE_CPU_OWNER(NeverDX64FPTests)
