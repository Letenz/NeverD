#ifdef NEVERD_NATIVE_CPU_OUTPUT_LIMIT
// Preserve bounded, repeated native observations in successful JUnit cases.
NEVERD_NATIVE_CPU_OUTPUT_LIMIT(65536)
#endif
#ifdef NEVERD_NATIVE_CPU_OWNER
NEVERD_NATIVE_CPU_OWNER(NeverDRunControlTests)
NEVERD_NATIVE_CPU_OWNER(NeverDWindowsProcessTests)
NEVERD_NATIVE_CPU_OWNER(NeverDX64FPTests)
NEVERD_NATIVE_CPU_OWNER(NeverDX64IntegerTests)
NEVERD_NATIVE_CPU_OWNER(NeverDMemoryLifecycleTests)
NEVERD_NATIVE_CPU_OWNER(NeverDInstructionFetchTests)
NEVERD_NATIVE_CPU_OWNER(NeverDX64MemoryUpdateTests)
