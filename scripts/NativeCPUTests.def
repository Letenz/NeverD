    "ExplicitBackends/"
    "X64FPTransport.StackChangesMatchIndependentHostFXSaveAndRestore/"
    "whpSupervisor")
NEVERD_NATIVE_CPU_REQUIRED_TEST(
    "ExplicitBackends/"
    "X64FPTransport.StackChangesMatchIndependentHostFXSaveAndRestore/whpUser")
NEVERD_NATIVE_CPU_REQUIRED_TEST(
    "ExplicitBackends/"
    "X64FPContext.CapturesFullPhysicalStateAndRestoresAfterExecution/"
    "whpSupervisor")
NEVERD_NATIVE_CPU_REQUIRED_TEST(
    "ExplicitBackends/"
    "X64FPContext.CapturesFullPhysicalStateAndRestoresAfterExecution/whpUser")
NEVERD_NATIVE_CPU_REQUIRED_TEST(
    "ExplicitBackends/"
    "X64FPContext.RejectsInvalidWidthsAndEncodingsWithoutTruncation/"
