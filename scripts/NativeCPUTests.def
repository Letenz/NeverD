    "SharedCPU.RebindingUsesSpaceIdentityEvenWithMatchingGenerations/NativeX64")
NEVERD_NATIVE_CPU_REQUIRED_TEST(
    "PortableAndNative/"
    "SharedCPU.OwnerLeaseRejectsMutationAndRecursiveExecutionAcrossSpaces/"
