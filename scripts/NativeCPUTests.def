    "ExplicitBackends/"
    "X64FPTransport.PreservesAllPhysicalLanesAndControlAcrossEveryTOP/"
    "whpSupervisor")
NEVERD_NATIVE_CPU_REQUIRED_TEST(
    "ExplicitBackends/"
    "X64FPTransport.PreservesAllPhysicalLanesAndControlAcrossEveryTOP/whpUser")
NEVERD_NATIVE_CPU_REQUIRED_TEST(
    "ExplicitBackends/"
    "X64FPTransport.StackChangesMatchIndependentHostFXSaveAndRestore/"
    "whpSupervisor")
NEVERD_NATIVE_CPU_REQUIRED_TEST(
    "ExplicitBackends/"
    "X64FPTransport.StackChangesMatchIndependentHostFXSaveAndRestore/whpUser")
NEVERD_NATIVE_CPU_REQUIRED_TEST(
    "ExplicitBackends/"
    "X64FPContext.CapturesFullPhysicalStateAndRestoresAfterExecution/"
    "whpSupervisor")
NEVERD_NATIVE_CPU_REQUIRED_TEST(
    "ExplicitBackends/"
    "X64FPContext.CapturesFullPhysicalStateAndRestoresAfterExecution/whpUser")
NEVERD_NATIVE_CPU_REQUIRED_TEST(
    "ExplicitBackends/"
    "X64FPContext.RejectsInvalidWidthsAndEncodingsWithoutTruncation/"
    "whpSupervisor")
NEVERD_NATIVE_CPU_REQUIRED_TEST(
    "ExplicitBackends/"
    "X64FPContext.RejectsInvalidWidthsAndEncodingsWithoutTruncation/whpUser")
NEVERD_NATIVE_CPU_REQUIRED_TEST(
    "PortableAndNative/"
    "SharedCPU.CPUsShareBytesAndSurviveDestructionOfTheirPeer/NativeX64")
NEVERD_NATIVE_CPU_REQUIRED_TEST(
    "PortableAndNative/"
    "SharedCPU.SharedCodeWritesInvalidateWarmTranslationsAndSavedContexts/"
    "NativeX64")
NEVERD_NATIVE_CPU_REQUIRED_TEST(
    "PortableAndNative/"
    "SharedCPU.RebindingUsesSpaceIdentityEvenWithMatchingGenerations/NativeX64")
NEVERD_NATIVE_CPU_REQUIRED_TEST(
    "PortableAndNative/"
    "SharedCPU.OwnerLeaseRejectsMutationAndRecursiveExecutionAcrossSpaces/"
