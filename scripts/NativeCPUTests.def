NEVERD_NATIVE_CPU_OWNER(NeverDServiceRequestTests)
NEVERD_NATIVE_CPU_OWNER(NeverDProjectionCacheTests)
NEVERD_NATIVE_CPU_OWNER(NeverDThreadPointerTests)
NEVERD_NATIVE_CPU_OWNER(NeverDUserExecutionTests)
#endif
#ifdef NEVERD_NATIVE_CPU_HOST
NEVERD_NATIVE_CPU_HOST(KVM, "Linux", "x86_64", "AMD64")
NEVERD_NATIVE_CPU_HOST(WHP, "Windows", "AMD64", "x86_64")
#endif

