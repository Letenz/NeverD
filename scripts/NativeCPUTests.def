    "whpSupervisor")
NEVERD_NATIVE_CPU_REQUIRED_TEST(
    "ExplicitBackends/"
    "X64Integer.MissingSourcePagePreservesBothProductHalves/"
    "whpUser")
NEVERD_NATIVE_CPU_REQUIRED_TEST(
    "ExplicitBackends/"
    "X64FPTransport.LogicalCPUSwitchingRestoresPhysicalFPAndTLS/whpSupervisor")
NEVERD_NATIVE_CPU_REQUIRED_TEST(
    "ExplicitBackends/"
    "X64FPTransport.LogicalCPUSwitchingRestoresPhysicalFPAndTLS/whpUser")
NEVERD_NATIVE_CPU_REQUIRED_TEST(
    "Native/X64ProbeExecution.OriginalProgramChecksFullStateAndOneDeadline/whp")
NEVERD_NATIVE_CPU_REQUIRED_TEST(
    "Native/X64ProbeExecution.ExistingGuestMappingAndRAMSurviveInitialization/"
    "whp")
NEVERD_NATIVE_CPU_REQUIRED_TEST(
    "ExplicitBackends/"
    "X64FPTransport.PreservesAllPhysicalLanesAndControlAcrossEveryTOP/"
    "whpSupervisor")
NEVERD_NATIVE_CPU_REQUIRED_TEST(
    "ExplicitBackends/"
    "X64FPTransport.PreservesAllPhysicalLanesAndControlAcrossEveryTOP/whpUser")
