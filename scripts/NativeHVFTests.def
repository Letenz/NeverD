           "ObserverFailurePreservesCompleteState/hvfSupervisor")
NEVERD_NATIVE_HVF_REQUIRED_HOST_TEST(
    ARM64, "Transports/AArch64NZCV."
           "ObserverFailurePreservesCompleteState/hvfUser")
NEVERD_NATIVE_HVF_REQUIRED_HOST_TEST(
