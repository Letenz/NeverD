#ifdef NEVERD_NATIVE_HVF_REQUIRED_HOST_TEST
// Each supported guest platform must execute its real startup/service fixture
// on the host's ISA. Loader-only registrations cannot satisfy this gate.
NEVERD_NATIVE_HVF_REQUIRED_HOST_TEST(
    ARM64, "Transports/DarwinProcess.StartupDataBSSCarryAndBinaryOutput/"
           "MacOSARM64_hvf")
NEVERD_NATIVE_HVF_REQUIRED_HOST_TEST(
    ARM64, "Transports/DarwinProcess.StartupDataBSSCarryAndBinaryOutput/"
           "IOSARM64_hvf")
NEVERD_NATIVE_HVF_REQUIRED_HOST_TEST(
    ARM64, "Transports/DarwinProcess.StartupDataBSSCarryAndBinaryOutput/"
           "SimulatorARM64_hvf")
NEVERD_NATIVE_HVF_REQUIRED_HOST_TEST(
    X64, "Transports/DarwinProcess.StartupDataBSSCarryAndBinaryOutput/"
         "MacOSX64_hvf")
NEVERD_NATIVE_HVF_REQUIRED_HOST_TEST(
    X64, "Transports/DarwinProcess.StartupDataBSSCarryAndBinaryOutput/"
         "SimulatorX64_hvf")
#endif
#ifdef NEVERD_NATIVE_HVF_REQUIRED_TEST
NEVERD_NATIVE_HVF_REQUIRED_TEST(
    "Hvf.ConcurrentCallersKeepIndependentGuestRegisters")
NEVERD_NATIVE_HVF_REQUIRED_TEST(
    "HvfConfiguration.NativeSelectionAndBuildAvailabilityAreExplicit")
NEVERD_NATIVE_HVF_REQUIRED_TEST(
    "Hvf.ExecutesAnInstructionAndCanBeCalledFromAnotherThread")
NEVERD_NATIVE_HVF_REQUIRED_TEST(
    "Hvf.DistinctCPUsKeepTheirBackingAndSurvivePeerDestruction")
NEVERD_NATIVE_HVF_REQUIRED_TEST(
    "Hvf.LiveInitializationProbeDoesNotChangeAnotherCPU")
NEVERD_NATIVE_HVF_REQUIRED_TEST(
    "Hvf.OneGuestPageBudgetDoesNotBecomeTheHostPageBudget")
NEVERD_NATIVE_HVF_REQUIRED_TEST(
    "HvfConfiguration.VocabularyAndHostISARejectMismatchesBeforeInitialization")
NEVERD_NATIVE_HVF_REQUIRED_TEST(
    "HvfExecutor.OneOwnerThreadAndCancelledQueueAdmissionAllowsRetry")
NEVERD_NATIVE_HVF_REQUIRED_TEST(
    "HvfExecutor.PartialMappingFailureRetiresBorrowedBacking")
#endif
