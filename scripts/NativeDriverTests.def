#ifdef NEVERD_NATIVE_DRIVER_OWNER
NEVERD_NATIVE_DRIVER_OWNER(NeverDNativeDriverTests)
#endif
#ifdef NEVERD_NATIVE_DRIVER_REQUIRED_TEST
NEVERD_NATIVE_DRIVER_REQUIRED_TEST(
    "DriverKernelSEH.ScopeEndLabelMayOverlapTheHandlerLandingPad")
NEVERD_NATIVE_DRIVER_REQUIRED_TEST(
    "DriverKernelSEH.OverlappingScopeStillHasAnExclusiveEnd")
NEVERD_NATIVE_DRIVER_REQUIRED_TEST(
    "DriverKernelSEH.OverlappingHandlerRetainsTargetValidationAndCanRetry")
NEVERD_NATIVE_DRIVER_REQUIRED_TEST(
    "DriverKernelSEH.FinallyRespectsRawScopeEndAtHandlerTarget")
NEVERD_NATIVE_DRIVER_REQUIRED_TEST(
    "DriverKernelSEH.KernelSSERecordsCaptureAllXmmAndPreserveFaultControls")
NEVERD_NATIVE_DRIVER_REQUIRED_TEST(
    "DriverKernelSEH.KernelSSEContinuationUsesTopLevelControlsAndAllRegisters")
NEVERD_NATIVE_DRIVER_REQUIRED_TEST(
    "DriverKernelSEH.KernelSSEFilterEditsPreserveUnwindAndRejectX87")
#endif
#ifdef NEVERD_NATIVE_DRIVER_REQUIRED_CASES
NEVERD_NATIVE_DRIVER_REQUIRED_CASES(
    "Native/DriverSIMDSEH.OriginalDriverCatchesAndRetriesSSEFaults/{backend}_driver_",
    "unittests/emulation/fixtures/driver_seh_simd.def", "NEVERD_SEH_SIMD_MODE")
NEVERD_NATIVE_DRIVER_REQUIRED_CASES(
    "Native/DriverSIMDSEH.OriginalDriverCatchesAndRetriesSSEFaults/{backend}_checked_",
    "unittests/emulation/fixtures/driver_seh_simd.def", "NEVERD_SEH_SIMD_MODE")
// Fixed images intentionally reject rebasing before guest entry. These
// outcomes are required as well as the original-address execution outcomes.
NEVERD_NATIVE_DRIVER_REQUIRED_CASES(
    "Corpus/"
    "DriverNativeExecution."
    "OriginalCorpusPreservesKnownOutcomesWithoutPortableTransport/"
    "{backend}_Original_",
    "unittests/emulation/DriverBuiltinImages.def", "NEVERD_PARITY_IMAGE")
NEVERD_NATIVE_DRIVER_REQUIRED_CASES(
    "Corpus/"
    "DriverNativeExecution."
    "OriginalCorpusPreservesKnownOutcomesWithoutPortableTransport/"
    "{backend}_Rebased_",
    "unittests/emulation/DriverBuiltinImages.def", "NEVERD_PARITY_IMAGE")
NEVERD_NATIVE_DRIVER_REQUIRED_CASES(
    "Corpus/"
    "DriverNativeExecution."
    "OriginalCorpusPreservesKnownOutcomesWithoutPortableTransport/"
    "{backend}_Original_",
    "unittests/emulation/DriverBackendParityCases.def", "NEVERD_PARITY_IMAGE")
NEVERD_NATIVE_DRIVER_REQUIRED_CASES(
    "Corpus/"
    "DriverNativeExecution."
    "OriginalCorpusPreservesKnownOutcomesWithoutPortableTransport/"
    "{backend}_Rebased_",
    "unittests/emulation/DriverBackendParityCases.def", "NEVERD_PARITY_IMAGE")
NEVERD_NATIVE_DRIVER_REQUIRED_CASES(
    "Corpus/"
    "DriverNativeExecution."
    "OriginalCorpusPreservesKnownOutcomesWithoutPortableTransport/"
    "{backend}_Original_",
    "unittests/emulation/DriverBackendParityCases.def",
    "NEVERD_PARITY_SCENARIO")
NEVERD_NATIVE_DRIVER_REQUIRED_CASES(
    "Corpus/"
    "DriverNativeExecution."
    "OriginalCorpusPreservesKnownOutcomesWithoutPortableTransport/"
    "{backend}_Rebased_",
    "unittests/emulation/DriverBackendParityCases.def",
    "NEVERD_PARITY_SCENARIO")
#endif
