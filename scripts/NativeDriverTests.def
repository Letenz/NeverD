#ifdef NEVERD_NATIVE_DRIVER_OWNER
NEVERD_NATIVE_DRIVER_OWNER(NeverDNativeDriverTests)
#endif
#ifdef NEVERD_NATIVE_DRIVER_REQUIRED_TEST
NEVERD_NATIVE_DRIVER_REQUIRED_TEST(
    "DriverSchedulingPolicy.RejectsMalformedAndOverflowingScenarios")
NEVERD_NATIVE_DRIVER_REQUIRED_TEST(
    "DriverSchedulingPolicy.ReportsExplicitPolicyAndPreservesDefaultShape")
NEVERD_NATIVE_DRIVER_REQUIRED_TEST(
    "DriverSchedulingPolicy.PassiveQueuesAndResumptionsShareReadyOrder")
NEVERD_NATIVE_DRIVER_REQUIRED_TEST(
    "DriverSchedulingPolicy.RunningClockKeepsEveryPeriodicBoundary")
NEVERD_NATIVE_DRIVER_REQUIRED_TEST(
    "DriverSchedulingPolicy.RunningClockCapacityFailurePreservesTimeAndExpiry")
NEVERD_NATIVE_DRIVER_REQUIRED_TEST(
    "DriverSchedulingPolicy.HighestPriorityPrecedesOlderPassiveWork")
NEVERD_NATIVE_DRIVER_REQUIRED_TEST(
    "DriverSchedulingPolicy.PriorityChangesReevaluateQueuedAndSuspendedThreads")
NEVERD_NATIVE_DRIVER_REQUIRED_TEST(
    "DriverSchedulingPolicy.InvalidPriorityPreservesCanonicalState")
NEVERD_NATIVE_DRIVER_REQUIRED_TEST(
    "DriverSchedulingPolicy.CooperativeDefaultRetainsWorkerFIFO")
NEVERD_NATIVE_DRIVER_REQUIRED_TEST(
    "DriverKernelSEH.ScopeEndLabelMayOverlapTheHandlerLandingPad")
NEVERD_NATIVE_DRIVER_REQUIRED_TEST(
    "DriverKernelSEH.OverlappingScopeStillHasAnExclusiveEnd")
NEVERD_NATIVE_DRIVER_REQUIRED_TEST(
    "DriverKernelSEH.OverlappingHandlerRetainsTargetValidationAndCanRetry")
NEVERD_NATIVE_DRIVER_REQUIRED_TEST(
    "DriverKernelSEH.FinallyRespectsRawScopeEndAtHandlerTarget")
NEVERD_NATIVE_DRIVER_REQUIRED_TEST(
    "DriverKernelSEH.KernelSSERecordsCaptureAllXmmAndPreserveFaultControls")
NEVERD_NATIVE_DRIVER_REQUIRED_TEST(
    "DriverKernelSEH.KernelSSEContinuationUsesTopLevelControlsAndAllRegisters")
NEVERD_NATIVE_DRIVER_REQUIRED_TEST(
    "DriverKernelSEH.KernelSSEFilterEditsPreserveUnwindAndRejectX87")
#endif
