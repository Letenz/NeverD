//===- ISAEncoding.def - ISA instruction encoding constants -----*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// The instruction encoding constants of neverd/support/ISAEncoding.h, one
/// macro per namespace they belong to.  Define the macros a consumer reads
/// before including this file; the others expand to nothing.
///
///   NEVERD_X86_ENCODING(Type, Name, Value)      namespace x86
///   NEVERD_AARCH64_ENCODING(Type, Name, Value)  namespace aarch64
///   NEVERD_ELF_ENCODING(Type, Name, Value)      namespace elf
///   NEVERD_MACHO_ENCODING(Type, Name, Value)    namespace macho
///   NEVERD_ARM_ENCODING(Type, Name, Value)      namespace arm
///   NEVERD_UNWIND_ENCODING(Type, Name, Value)   namespace unwind
///
/// A value may name a constant listed before it in the same namespace.
///
//===----------------------------------------------------------------------===//

#ifndef NEVERD_X86_ENCODING
#define NEVERD_X86_ENCODING(Type, Name, Value)
#endif
#ifndef NEVERD_AARCH64_ENCODING
#define NEVERD_AARCH64_ENCODING(Type, Name, Value)
#endif
#ifndef NEVERD_ELF_ENCODING
#define NEVERD_ELF_ENCODING(Type, Name, Value)
#endif
#ifndef NEVERD_MACHO_ENCODING
#define NEVERD_MACHO_ENCODING(Type, Name, Value)
#endif
#ifndef NEVERD_ARM_ENCODING
#define NEVERD_ARM_ENCODING(Type, Name, Value)
#endif
#ifndef NEVERD_UNWIND_ENCODING
#define NEVERD_UNWIND_ENCODING(Type, Name, Value)
#endif

// ===--------------------------------------------------------------------===//
// x86/x64 instruction encoding
// ===--------------------------------------------------------------------===//

// --- Opcode bytes ---
NEVERD_X86_ENCODING(uint8_t, kCallRel32, 0xE8)
NEVERD_X86_ENCODING(uint8_t, kJmpRel32, 0xE9)
NEVERD_X86_ENCODING(uint8_t, kJccShortBase, 0x70)
NEVERD_X86_ENCODING(uint8_t, kJccShortEnd, 0x7F)
NEVERD_X86_ENCODING(uint8_t, kTwoByteEscape, 0x0F)
NEVERD_X86_ENCODING(uint8_t, kJccNearBase, 0x80)
NEVERD_X86_ENCODING(uint8_t, kJccNearEnd, 0x8F)
NEVERD_X86_ENCODING(uint8_t, kInt3, 0xCC)
NEVERD_X86_ENCODING(uint8_t, kNop, 0x90)
NEVERD_X86_ENCODING(uint8_t, kJmpIndirectOp, 0xFF)
NEVERD_X86_ENCODING(uint8_t, kJmpIndirectModRM, 0x25)
NEVERD_X86_ENCODING(uint8_t, kFSSegmentPrefix, 0x64)

// --- Instruction lengths ---
NEVERD_X86_ENCODING(size_t, kRel32DispOffset, 1)
NEVERD_X86_ENCODING(size_t, kJmpRel32Len, 5)
NEVERD_X86_ENCODING(size_t, kCallRel32Len, 5)
NEVERD_X86_ENCODING(size_t, kJccShortLen, 2)
NEVERD_X86_ENCODING(size_t, kJccShortDispOffset, 1)
NEVERD_X86_ENCODING(size_t, kJccNearLen, 6)
NEVERD_X86_ENCODING(size_t, kJccNearDispOffset, 2)
NEVERD_X86_ENCODING(size_t, kJmpIndirectLen, 6)
NEVERD_X86_ENCODING(size_t, kJmpIndirectDispOffset, 2)

// ===--------------------------------------------------------------------===//
// AArch64 instruction encoding
// ===--------------------------------------------------------------------===//

NEVERD_AARCH64_ENCODING(size_t, kInsnSize, 4)

// --- Branch encoding (B / BL) ---
NEVERD_AARCH64_ENCODING(uint32_t, kB_Op, 0x14000000)
NEVERD_AARCH64_ENCODING(uint32_t, kImm26Mask, 0x03FFFFFF)

// --- Conditional branch (B.cond) ---
NEVERD_AARCH64_ENCODING(uint32_t, kBCond_Mask, 0xFF000010)
NEVERD_AARCH64_ENCODING(uint32_t, kBCond_Op, 0x54000000)
NEVERD_AARCH64_ENCODING(uint32_t, kBCond_Imm19Shift, 5)
NEVERD_AARCH64_ENCODING(uint32_t, kBCond_Imm19Mask, 0x7FFFF)
NEVERD_AARCH64_ENCODING(uint32_t, kBCond_Imm19Sign, 0x40000)
NEVERD_AARCH64_ENCODING(uint32_t, kBCond_Imm19SignExt, 0xFFF80000)

// --- Compare and branch (CBZ / CBNZ) ---
NEVERD_AARCH64_ENCODING(uint32_t, kCBZ_Mask, 0x7E000000)
NEVERD_AARCH64_ENCODING(uint32_t, kCBZ_Op, 0x34000000)

// --- Test and branch (TBZ / TBNZ) ---
NEVERD_AARCH64_ENCODING(uint32_t, kTBZ_Mask, 0x7E000000)
NEVERD_AARCH64_ENCODING(uint32_t, kTBZ_Op, 0x36000000)
NEVERD_AARCH64_ENCODING(uint32_t, kTBZ_Imm14Shift, 5)
NEVERD_AARCH64_ENCODING(uint32_t, kTBZ_Imm14Mask, 0x3FFF)
NEVERD_AARCH64_ENCODING(uint32_t, kTBZ_Imm14Sign, 0x2000)
NEVERD_AARCH64_ENCODING(uint32_t, kTBZ_Imm14SignExt, 0xFFFFC000)

// --- PC-relative addressing (ADRP / ADR) ---
NEVERD_AARCH64_ENCODING(uint32_t, kADRP_Mask, 0x9F000000)
NEVERD_AARCH64_ENCODING(uint32_t, kADRP_Op, 0x90000000)
NEVERD_AARCH64_ENCODING(uint32_t, kADR_Op, 0x10000000)
NEVERD_AARCH64_ENCODING(uint32_t, kImmHiShift, 5)
NEVERD_AARCH64_ENCODING(uint32_t, kImmHiMask, 0x7FFFF)
NEVERD_AARCH64_ENCODING(uint32_t, kImmLoShift, 29)
NEVERD_AARCH64_ENCODING(uint32_t, kImmLoMask, 0x3)
NEVERD_AARCH64_ENCODING(uint32_t, kImm21Sign, 0x100000)
NEVERD_AARCH64_ENCODING(uint32_t, kImm21SignExt, 0xFFE00000)
NEVERD_AARCH64_ENCODING(uint32_t, kRdMask, 0x1F)
NEVERD_AARCH64_ENCODING(uint32_t, kADRP_FixedBits, kADRP_Mask | kRdMask)

// --- ADRP page arithmetic ---
NEVERD_AARCH64_ENCODING(uint32_t, kPageShift, 12)
NEVERD_AARCH64_ENCODING(uint32_t, kImmLoWidth, 2)
NEVERD_AARCH64_ENCODING(uint32_t, kADRP_ImmBits, 32)

// --- Load/store immediate ---
NEVERD_AARCH64_ENCODING(uint32_t, kLDR_Imm12Shift, 10)
NEVERD_AARCH64_ENCODING(uint32_t, kLDR_Imm12Mask, 0xFFF)
NEVERD_AARCH64_ENCODING(uint64_t, kPageMask, ~uint64_t(0xFFF))

// --- Import veneer patterns ---
NEVERD_AARCH64_ENCODING(uint32_t, kADRP_X16_Mask, 0x9F00001F)
NEVERD_AARCH64_ENCODING(uint32_t, kADRP_X16_Match, 0x90000010)
NEVERD_AARCH64_ENCODING(uint32_t, kLDR_X16_X16_Mask, 0xFFC003FF)
NEVERD_AARCH64_ENCODING(uint32_t, kLDR_X16_X16_Match, 0xF9400210)
NEVERD_AARCH64_ENCODING(uint32_t, kLDR_X17_X16_Match, 0xF9400211)
NEVERD_AARCH64_ENCODING(uint32_t, kADD_X16_X16_Mask, 0xFFC003FF)
NEVERD_AARCH64_ENCODING(uint32_t, kADD_X16_X16_Match, 0x91000210)
NEVERD_AARCH64_ENCODING(size_t, kThunkLen, 12)
NEVERD_AARCH64_ENCODING(size_t, kELFPLTThunkLen, 16)

// --- Miscellaneous ---
NEVERD_AARCH64_ENCODING(uint32_t, kNop, 0xD503201F)
NEVERD_AARCH64_ENCODING(uint32_t, kBR_X16, 0xD61F0200)
NEVERD_AARCH64_ENCODING(uint32_t, kBR_X17, 0xD61F0220)

// --- Branch target identification: the landing pads of indirect calls ---
NEVERD_AARCH64_ENCODING(uint32_t, kBTI_C, 0xD503245F)
NEVERD_AARCH64_ENCODING(uint32_t, kBTI_JC, 0xD50324DF)

// +/- 128 MB reach of B/BL (26-bit signed imm << 2).
NEVERD_AARCH64_ENCODING(int64_t, kBranchRange, 1LL << 27)

// ===--------------------------------------------------------------------===//
// ELF PLT layout
// ===--------------------------------------------------------------------===//

NEVERD_ELF_ENCODING(uint32_t, kDefaultPLTEntrySize, 16)
NEVERD_ELF_ENCODING(uint32_t, kARMPLTEntrySize, 12)
NEVERD_ELF_ENCODING(uint32_t, kAArch64PLTEntrySize, 16)
NEVERD_ELF_ENCODING(uint32_t, kX86PLTEntrySize, 16)

// ===--------------------------------------------------------------------===//
// Mach-O stub layout
// ===--------------------------------------------------------------------===//

NEVERD_MACHO_ENCODING(uint32_t, kX86StubSize, 6)
NEVERD_MACHO_ENCODING(uint32_t, kAArch64StubSize, 12)
NEVERD_MACHO_ENCODING(uint32_t, kARMStubSize, 12)
NEVERD_MACHO_ENCODING(uint32_t, kDefaultStubSize, 6)

// ===--------------------------------------------------------------------===//
// ARM 32-bit instruction encoding
// ===--------------------------------------------------------------------===//

NEVERD_ARM_ENCODING(uint32_t, kLdrPC, 0xE51FF004u)
NEVERD_ARM_ENCODING(uint32_t, kArmNop, 0xE1A00000u) // MOV r0, r0
NEVERD_ARM_ENCODING(uint16_t, kThumbNop, 0xBF00)
NEVERD_ARM_ENCODING(uint32_t, kPCBias, 8)
NEVERD_ARM_ENCODING(size_t, kInsnSize, 4)
NEVERD_ARM_ENCODING(size_t, kThumbInsnSize, 2)
NEVERD_ARM_ENCODING(size_t, kLdrPCTrampLen, 8)
NEVERD_ARM_ENCODING(size_t, kThumbMovImmInsnSize, 4)
NEVERD_ARM_ENCODING(size_t, kThumbImportThunkLen, 12)
NEVERD_ARM_ENCODING(uint16_t, kThumbMovImmOp1Mask, 0xFBF0)
NEVERD_ARM_ENCODING(uint16_t, kThumbMovWIPOp1, 0xF240)
NEVERD_ARM_ENCODING(uint16_t, kThumbMovTIPOp1, 0xF2C0)
NEVERD_ARM_ENCODING(uint16_t, kThumbMovIPOp2Mask, 0x8F00)
NEVERD_ARM_ENCODING(uint16_t, kThumbMovIPOp2, 0x0C00)
NEVERD_ARM_ENCODING(uint32_t, kThumbLdrPCFromIP, 0xF000F8DC)
NEVERD_ARM_ENCODING(uint64_t, kThumbBWLen, 4)
NEVERD_ARM_ENCODING(int64_t, kThumbBWMinDisp, -(int64_t(1) << 24))
NEVERD_ARM_ENCODING(int64_t, kThumbBWMaxDisp, (int64_t(1) << 24) - 2)

// ===--------------------------------------------------------------------===//
// PE x64 unwind info layout (cf. llvm/Support/Win64EH.h)
// ===--------------------------------------------------------------------===//

NEVERD_UNWIND_ENCODING(uint8_t, kFlagsShift, 3)
NEVERD_UNWIND_ENCODING(uint8_t, kFlagsMask, 0x1F)

#undef NEVERD_X86_ENCODING
#undef NEVERD_AARCH64_ENCODING
#undef NEVERD_ELF_ENCODING
#undef NEVERD_MACHO_ENCODING
#undef NEVERD_ARM_ENCODING
#undef NEVERD_UNWIND_ENCODING
