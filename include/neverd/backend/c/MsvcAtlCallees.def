//===- MsvcAtlCallees.def - ATL/MFC string display callees -*- C++ -*-===//
//
// NeverD Decompiler
//
// This file intentionally has no include guard.
//
// MSVC_ATL_CALLEE(ID, MATCH, DECORATION, MATCH_KIND, ARITY_KIND, MAX_ARGS,
//                 RETURN_KIND, CLASS_STEM, FASTCALL)
//
// Display-only CStringT/CSimpleStringT members shared by ATL and MFC.
// MsvcCallees.def combines these with the common MSVC C++ member rules and
// documents the row fields. Add string-specific display rules here instead
// of another `Name == "IsEmpty"` / `ends_with("_cstr")` check.
// `??B` supplies the conversion-to-cstr stem used by these string classes.
//
//===----------------------------------------------------------------------===//

#ifndef MSVC_ATL_CALLEE
#define MSVC_ATL_CALLEE(ID, MATCH, DECORATION, MATCH_KIND, ARITY_KIND,         \
                        MAX_ARGS, RETURN_KIND, CLASS_STEM, FASTCALL)
#endif

MSVC_ATL_CALLEE(Cstr, "cstr", 'B', Suffix, Fixed, 1, WCharPtr, FromMatch, 1)
MSVC_ATL_CALLEE(IsEmpty, "IsEmpty", 0, Exact, Fixed, 1, Bool, CStringT, 1)
MSVC_ATL_CALLEE(GetLength, "GetLength", 0, Exact, Fixed, 1, Int32, CStringT, 1)
MSVC_ATL_CALLEE(GetManager, "GetManager", 0, Exact, Fixed, 1, VoidPtr, CStringT,
                1)
MSVC_ATL_CALLEE(Format, "Format", 0, Exact, Keep, 2, Void, CStringT, 1)
MSVC_ATL_CALLEE(Concatenate, "Concatenate", 0, Exact, Keep, 5, Void, CStringT,
                1)

#undef MSVC_ATL_CALLEE
