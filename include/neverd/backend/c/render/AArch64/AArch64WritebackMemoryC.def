//===- AArch64WritebackMemoryC.def - Writeback C syntax ---------*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
/// \file
/// Evaluate operands before binding fixed scratch registers. One original
/// instruction supplies the load value and the completed base.
//===----------------------------------------------------------------------===//

#ifndef NEVERD_A64_WRITEBACK_C_TEXT
#error "Define NEVERD_A64_WRITEBACK_C_TEXT before including this file"
#endif

NEVERD_A64_WRITEBACK_C_TEXT(kWritebackCValue, "__writeback_value")
NEVERD_A64_WRITEBACK_C_TEXT(kWritebackCBase, "__writeback_base")
NEVERD_A64_WRITEBACK_C_TEXT(kWritebackCData, "__writeback_data")
NEVERD_A64_WRITEBACK_C_TEXT(kWritebackCPair, "__writeback_pair")
NEVERD_A64_WRITEBACK_C_TEXT(
    kWritebackLoadCExpression,
    "({{ register uint64_t {0} __asm__(\"x17\"); "
    "register uint64_t {1} __asm__(\"x16\") = (uint64_t)({2}); "
    "__asm__ volatile(\".inst %c2\" : \"=&r\"({0}), \"+r\"({1}) "
    ": \"i\"({3}) : \"memory\"); "
    "(unsigned __int128){0} | ((unsigned __int128){1} << 64); })")
NEVERD_A64_WRITEBACK_C_TEXT(kWritebackStoreCExpression,
                            "({{ uint64_t {4} = (uint64_t)({2}); "
                            "uint64_t {5} = (uint64_t)({6}); "
                            "register uint64_t {1} __asm__(\"x16\") = {4}; "
                            "register uint64_t {0} __asm__(\"x17\") = {5}; "
                            "__asm__ volatile(\".inst %c2\" : \"+r\"({1}) "
                            ": \"r\"({0}), \"i\"({3}) : \"memory\"); {1}; })")
NEVERD_A64_WRITEBACK_C_TEXT(kWritebackCStructAssignment,
                            "{{ unsigned __int128 {0} = {1}; "
                            "{2}.field_0 = (uint64_t){0}; "
                            "{2}.field_1 = (uint64_t)({0} >> 64); }\n")

NEVERD_A64_WRITEBACK_C_TEXT(kWritebackCAssignment, "{0} = {1};\n")

NEVERD_A64_WRITEBACK_C_TEXT(
    kWritebackVectorStoreCExpression,
    "({{ const uint64_t {4} = (uint64_t)({2}); "
    "const unsigned __int128 {5} = (unsigned __int128)({6}); "
    "register int64_t __attribute__((vector_size(16))) {0} __asm__(\"v17\") = "
    "{7}; "
    "register uint64_t {1} __asm__(\"x16\") = {4}; "
    "__asm__ volatile(\".inst %c2\" : \"+r\"({1}) "
    ": \"w\"({0}), \"i\"({3}) : \"memory\"); {1}; })")
NEVERD_A64_WRITEBACK_C_TEXT(
    kWritebackVectorLoadCStatement,
    "{{ const uint64_t {4} = (uint64_t)({2}); "
    "register int64_t __attribute__((vector_size(16))) {0} __asm__(\"v17\"); "
    "register uint64_t {1} __asm__(\"x16\") = {4}; "
    "__asm__ volatile(\".inst %c2\" : \"=&w\"({0}), \"+r\"({1}) "
    ": \"i\"({3}) : \"memory\"); {5} }\n")

NEVERD_A64_WRITEBACK_C_TEXT(kWritebackCValueField, "{0}.field_0")
NEVERD_A64_WRITEBACK_C_TEXT(kWritebackCBaseField, "{0}.field_1")

#undef NEVERD_A64_WRITEBACK_C_TEXT
