///
/// \file
/// The punctuators of C (C17 6.4.6), longest first, so that a reader takes
/// the longest one a text starts with.
///
///   NEVERD_C_PUNCTUATOR(Spelling)
///
//===----------------------------------------------------------------------===//

#ifndef NEVERD_C_PUNCTUATOR
#define NEVERD_C_PUNCTUATOR(Spelling)
#endif

