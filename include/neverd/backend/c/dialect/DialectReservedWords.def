//===----------------------------------------------------------------------===//
///
/// \file
/// The keywords of each dialect.  A C identifier that is one is escaped:
/// Rust writes `r#match`; Go, which has no raw identifiers, writes `type_`.
///
///   NEVERD_RUST_KEYWORD(Word)
///   NEVERD_GO_KEYWORD(Word)
///
//===----------------------------------------------------------------------===//

#ifndef NEVERD_RUST_KEYWORD
#define NEVERD_RUST_KEYWORD(Word)
#endif
#ifndef NEVERD_GO_KEYWORD
#define NEVERD_GO_KEYWORD(Word)
#endif

