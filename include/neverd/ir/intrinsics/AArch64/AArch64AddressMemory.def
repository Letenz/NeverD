//===- AArch64AddressMemory.def - Original memory operations ---*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
/// \file
/// Original memory operations retain AddressAdd's access-EL checks and the
/// processor's AddressIncrement choice. VALUE owns encoding/shape constants;
/// TEXT owns diagnostics and LLVM syntax; Operations.def owns appended
/// identities, store direction and vector class. ENCODING owns Id, masked word,
/// access bytes, result bytes and signedness. Loads return accessed bytes;
/// explicit IR extends them through the encoded W/X result width before
/// publishing X, or publishes the natural vector view before zeroing its upper
/// V bytes. Stores consume only accessed bytes.
//===----------------------------------------------------------------------===//

#ifndef NEVERD_A64_ADDRESS_MEMORY_VALUE
#define NEVERD_A64_ADDRESS_MEMORY_VALUE(Type, Name, Value)
#endif
#ifndef NEVERD_A64_ADDRESS_MEMORY_TEXT
#define NEVERD_A64_ADDRESS_MEMORY_TEXT(Name, Text)
#endif
#ifndef NEVERD_A64_ADDRESS_MEMORY_ENCODING
#define NEVERD_A64_ADDRESS_MEMORY_ENCODING(Id, Word, Access, Result, Signed)
#endif

#include "neverd/ir/intrinsics/AArch64/AArch64AddressMemoryOperations.def"
// Canonical unscaled UXTX LDR word for existing typed IR producers.
NEVERD_A64_ADDRESS_MEMORY_VALUE(uint32_t, kAddressLoadOpcode, 0xf8606800U)
NEVERD_A64_ADDRESS_MEMORY_VALUE(uint32_t, kAddressMemoryOpcodeMask, 0xffe04c00U)
NEVERD_A64_ADDRESS_MEMORY_ENCODING(A64_LoadRegisterOffset, 0x38604800U, 1, 4,
                                   false)
NEVERD_A64_ADDRESS_MEMORY_ENCODING(A64_LoadRegisterOffset, 0x38e04800U, 1, 4,
                                   true)
NEVERD_A64_ADDRESS_MEMORY_ENCODING(A64_LoadRegisterOffset, 0x38a04800U, 1, 8,
                                   true)
NEVERD_A64_ADDRESS_MEMORY_ENCODING(A64_LoadRegisterOffset, 0x78604800U, 2, 4,
                                   false)
NEVERD_A64_ADDRESS_MEMORY_ENCODING(A64_LoadRegisterOffset, 0x78e04800U, 2, 4,
                                   true)
NEVERD_A64_ADDRESS_MEMORY_ENCODING(A64_LoadRegisterOffset, 0x78a04800U, 2, 8,
                                   true)
NEVERD_A64_ADDRESS_MEMORY_ENCODING(A64_LoadRegisterOffset, 0xb8604800U, 4, 4,
                                   false)
NEVERD_A64_ADDRESS_MEMORY_ENCODING(A64_LoadRegisterOffset, 0xb8a04800U, 4, 8,
                                   true)
NEVERD_A64_ADDRESS_MEMORY_ENCODING(A64_Load64RegisterOffset, 0xf8604800U, 8, 8,
                                   false)
NEVERD_A64_ADDRESS_MEMORY_ENCODING(A64_StoreRegisterOffset, 0x38204800U, 1, 0,
                                   false)
NEVERD_A64_ADDRESS_MEMORY_ENCODING(A64_StoreRegisterOffset, 0x78204800U, 2, 0,
                                   false)
NEVERD_A64_ADDRESS_MEMORY_ENCODING(A64_StoreRegisterOffset, 0xb8204800U, 4, 0,
                                   false)
NEVERD_A64_ADDRESS_MEMORY_ENCODING(A64_StoreRegisterOffset, 0xf8204800U, 8, 0,
                                   false)

NEVERD_A64_ADDRESS_MEMORY_ENCODING(A64_VectorLoadRegisterOffset, 0x3c604800U, 1,
                                   16, false)
NEVERD_A64_ADDRESS_MEMORY_ENCODING(A64_VectorLoadRegisterOffset, 0x7c604800U, 2,
                                   16, false)
NEVERD_A64_ADDRESS_MEMORY_ENCODING(A64_VectorLoadRegisterOffset, 0xbc604800U, 4,
                                   16, false)
NEVERD_A64_ADDRESS_MEMORY_ENCODING(A64_VectorLoadRegisterOffset, 0xfc604800U, 8,
                                   16, false)
NEVERD_A64_ADDRESS_MEMORY_ENCODING(A64_VectorLoadRegisterOffset, 0x3ce04800U,
                                   16, 16, false)
NEVERD_A64_ADDRESS_MEMORY_ENCODING(A64_VectorStoreRegisterOffset, 0x3c204800U,
                                   1, 0, false)
NEVERD_A64_ADDRESS_MEMORY_ENCODING(A64_VectorStoreRegisterOffset, 0x7c204800U,
                                   2, 0, false)
NEVERD_A64_ADDRESS_MEMORY_ENCODING(A64_VectorStoreRegisterOffset, 0xbc204800U,
                                   4, 0, false)
NEVERD_A64_ADDRESS_MEMORY_ENCODING(A64_VectorStoreRegisterOffset, 0xfc204800U,
                                   8, 0, false)
NEVERD_A64_ADDRESS_MEMORY_ENCODING(A64_VectorStoreRegisterOffset, 0x3ca04800U,
                                   16, 0, false)

NEVERD_A64_ADDRESS_MEMORY_VALUE(uint32_t, kAddressMemoryRegisterMask, 0x1fU)
NEVERD_A64_ADDRESS_MEMORY_VALUE(unsigned, kAddressMemoryBaseShift, 5)
NEVERD_A64_ADDRESS_MEMORY_VALUE(unsigned, kAddressMemoryIndexShift, 16)
NEVERD_A64_ADDRESS_MEMORY_VALUE(uint32_t, kAddressMemoryRegistersMask,
                                0x1f03ffU)
NEVERD_A64_ADDRESS_MEMORY_VALUE(unsigned, kAddressMemoryPointerBytes, 8)
NEVERD_A64_ADDRESS_MEMORY_VALUE(unsigned, kAddressMemoryPointerBits, 64)
NEVERD_A64_ADDRESS_MEMORY_VALUE(unsigned, kAddressMemoryWordBytes, 4)
NEVERD_A64_ADDRESS_MEMORY_VALUE(unsigned, kAddressMemoryVectorBytes, 16)
NEVERD_A64_ADDRESS_MEMORY_VALUE(unsigned, kAddressMemoryVectorBits, 128)
NEVERD_A64_ADDRESS_MEMORY_VALUE(unsigned, kAddressMemoryIdentifierBytes, 2)
NEVERD_A64_ADDRESS_MEMORY_VALUE(unsigned, kAddressLoadOperandCount, 3)
NEVERD_A64_ADDRESS_MEMORY_VALUE(unsigned, kAddressStoreOperandCount, 4)
NEVERD_A64_ADDRESS_MEMORY_VALUE(unsigned, kAddressMemoryDataOperand, 3)
NEVERD_A64_ADDRESS_MEMORY_VALUE(unsigned, kAddressMemoryNarrowIndexBytes, 4)
NEVERD_A64_ADDRESS_MEMORY_VALUE(uint32_t, kAddressMemoryWideIndexBit, 0x2000U)
NEVERD_A64_ADDRESS_MEMORY_VALUE(uint32_t, kAddressMemorySignedIndexBit, 0x8000U)
NEVERD_A64_ADDRESS_MEMORY_VALUE(uint64_t, kAddressMemoryNarrowMask,
                                0xffffffffULL)
NEVERD_A64_ADDRESS_MEMORY_VALUE(uint64_t, kAddressMemoryNarrowSignBit,
                                0x80000000ULL)
NEVERD_A64_ADDRESS_MEMORY_VALUE(unsigned, kAddressMemoryBaseOperand, 0)
NEVERD_A64_ADDRESS_MEMORY_VALUE(unsigned, kAddressMemoryIndexOperand, 1)
NEVERD_A64_ADDRESS_MEMORY_VALUE(unsigned, kAddressMemoryWordOperand, 2)
NEVERD_A64_ADDRESS_MEMORY_VALUE(uint32_t, kAddressMemoryScaleMask, 0x1000U)
NEVERD_A64_ADDRESS_MEMORY_VALUE(unsigned, kAddressMemoryScaleShift, 3)
NEVERD_A64_ADDRESS_MEMORY_VALUE(uint64_t, kAddressMemoryTagMask,
                                0xff00000000000000ULL)
NEVERD_A64_ADDRESS_MEMORY_VALUE(uint64_t, kAddressMemoryPreservedMask,
                                0xff80000000000000ULL)
NEVERD_A64_ADDRESS_MEMORY_VALUE(uint64_t, kAddressMemoryPoisonBit,
                                0x0040000000000000ULL)
NEVERD_A64_ADDRESS_MEMORY_VALUE(uint64_t, kAddressMemorySignBit,
                                0x0080000000000000ULL)
NEVERD_A64_ADDRESS_MEMORY_VALUE(unsigned, kAddressMemoryScratchBase, 16)
NEVERD_A64_ADDRESS_MEMORY_VALUE(unsigned, kAddressMemoryScratchIndex, 15)
NEVERD_A64_ADDRESS_MEMORY_VALUE(unsigned, kAddressMemoryScratchValue, 17)
NEVERD_A64_ADDRESS_MEMORY_TEXT(kAddressLoadAsm,
                               ".inst ${3:c} // neverd.address.load")
NEVERD_A64_ADDRESS_MEMORY_TEXT(kAddressLoadConstraints,
                               "=&{x17},{x16},{x15},i,~{memory}")
NEVERD_A64_ADDRESS_MEMORY_TEXT(kAddressLoadResult, "address.load")
NEVERD_A64_ADDRESS_MEMORY_TEXT(kAddressStoreAsm,
                               ".inst ${2:c} // neverd.address.store")
NEVERD_A64_ADDRESS_MEMORY_TEXT(kAddressStoreConstraints,
                               "{x16},{x15},i,{x17},~{memory}")
NEVERD_A64_ADDRESS_MEMORY_TEXT(kAddressVectorLoadAsm,
                               ".inst ${3:c} // neverd.address.vector.load")
NEVERD_A64_ADDRESS_MEMORY_TEXT(kAddressVectorLoadConstraints,
                               "=&{v17},{x16},{x15},i,~{memory}")
NEVERD_A64_ADDRESS_MEMORY_TEXT(kAddressVectorStoreAsm,
                               ".inst ${2:c} // neverd.address.vector.store")
NEVERD_A64_ADDRESS_MEMORY_TEXT(kAddressVectorStoreConstraints,
                               "{x16},{x15},i,{v17},~{memory}")
NEVERD_A64_ADDRESS_MEMORY_TEXT(kAddressMemoryMalformed,
                               "malformed AArch64 original memory operation")
NEVERD_A64_ADDRESS_MEMORY_TEXT(kAddressMemorySPUnsupported,
                               "SP-origin memory requires the original SP "
                               "alignment and tagging environment")

#undef NEVERD_A64_ADDRESS_MEMORY_ENCODING
#undef NEVERD_A64_ADDRESS_MEMORY_OPERATION
#undef NEVERD_A64_ADDRESS_MEMORY_TEXT
#undef NEVERD_A64_ADDRESS_MEMORY_VALUE
