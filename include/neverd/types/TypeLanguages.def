//===- TypeLanguages.def - Languages local types render in ------*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// The languages local types render in, the spellings of builtins each
/// takes, and the words each reserves, which a name must step around.
///
/// NEVERD_TYPE_LANGUAGE(Name, Id, Display, Spelling)
///   Id       How APIs, the CLI and settings name the language.
///   Display  How the workbench shows it.
///   Spelling How it names builtins unless asked (BuiltinSpellings.def).
/// NEVERD_TYPE_SPELLING(Language, Spelling)
///   A spelling Language names builtins in when asked, its default
///   first.
/// NEVERD_TYPE_KEYWORD(Language, Word)
///   A word Language reserves.  C++ reserves C's words too.
///
//===----------------------------------------------------------------------===//

#ifndef NEVERD_TYPE_LANGUAGE
#define NEVERD_TYPE_LANGUAGE(Name, Id, Display, Spelling)
#endif
#ifndef NEVERD_TYPE_SPELLING
#define NEVERD_TYPE_SPELLING(Language, Spelling)
#endif
#ifndef NEVERD_TYPE_KEYWORD
#define NEVERD_TYPE_KEYWORD(Language, Word)
#endif

NEVERD_TYPE_LANGUAGE(C, "c", "C", Portable)
NEVERD_TYPE_LANGUAGE(Cpp, "cpp", "C++", Portable)
NEVERD_TYPE_LANGUAGE(Rust, "rust", "Rust", Portable)
NEVERD_TYPE_LANGUAGE(Go, "go", "Go", Portable)
NEVERD_TYPE_LANGUAGE(Python, "python", "Python", Portable)
NEVERD_TYPE_LANGUAGE(JavaScript, "javascript", "JavaScript", Portable)
NEVERD_TYPE_LANGUAGE(Lua, "lua", "Lua", Portable)

NEVERD_TYPE_SPELLING(C, Portable)
NEVERD_TYPE_SPELLING(C, Windows)
NEVERD_TYPE_SPELLING(C, Keywords)
