//===- CallingConventions.def - Function type conventions -------*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// The calling conventions a local function type records.
///
/// NEVERD_CALLING_CONVENTION(Name, C, Rust, IDA)
///   C     Its MSVC or GNU spelling in a C declaration; empty for none.
///   Rust  Its extern ABI string in Rust.
///   IDA   Its spelling in IDA's local types; empty for none.
///
//===----------------------------------------------------------------------===//

#ifndef NEVERD_CALLING_CONVENTION
#define NEVERD_CALLING_CONVENTION(Name, C, Rust, IDA)
#endif

NEVERD_CALLING_CONVENTION(Unspecified, "", "C", "")
NEVERD_CALLING_CONVENTION(Cdecl, "__cdecl", "cdecl", "__cdecl")
NEVERD_CALLING_CONVENTION(Stdcall, "__stdcall", "stdcall", "__stdcall")
NEVERD_CALLING_CONVENTION(Fastcall, "__fastcall", "fastcall", "__fastcall")
NEVERD_CALLING_CONVENTION(Thiscall, "__thiscall", "thiscall", "__thiscall")
NEVERD_CALLING_CONVENTION(Vectorcall, "__vectorcall", "vectorcall",
                          "__vectorcall")
NEVERD_CALLING_CONVENTION(Win64, "__attribute__((ms_abi))", "win64",
                          "__fastcall")
NEVERD_CALLING_CONVENTION(SysV, "__attribute__((sysv_abi))", "sysv64", "")

#undef NEVERD_CALLING_CONVENTION
