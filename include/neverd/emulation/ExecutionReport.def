NEVERD_EXECUTION_REPORT_TEXT(UnknownFeature, "unknown CPU feature: ")
NEVERD_EXECUTION_REPORT_TEXT(DuplicateFeature,
                             "duplicate required CPU feature: ")
NEVERD_EXECUTION_REPORT_TEXT(ProbeBoolean, "CPU host probe must be 0 or 1")
NEVERD_EXECUTION_REPORT_TEXT(
    Disabled,
    "CPU emulation is disabled; rebuild with -DNEVERD_ENABLE_CPU_EMULATION=ON")
NEVERD_EXECUTION_REPORT_TEXT(AllocationFailed,
                             "could not allocate CPU capability report")
NEVERD_EXECUTION_REPORT_TEXT(QueryFailed, "CPU capability query failed: ")
NEVERD_EXECUTION_REPORT_TEXT(
    UnexpectedException,
    "CPU capability query failed with an unexpected exception")
NEVERD_EXECUTION_REPORT_TEXT(SessionFailed,
                             "could not create CPU query session")
#endif
