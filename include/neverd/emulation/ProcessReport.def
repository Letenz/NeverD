#ifdef NEVERD_PROCESS_REPORT_TEXT
NEVERD_PROCESS_REPORT_TEXT(DarwinFilesOptions, "invalid darwin_files option: ")
NEVERD_PROCESS_REPORT_TEXT(DarwinFilesProfile,
                           "darwin_files requires a macOS or iOS profile")
NEVERD_PROCESS_REPORT_TEXT(LinuxFilesOptions, "invalid linux_files option: ")
NEVERD_PROCESS_REPORT_TEXT(
    LinuxFilesProfile,
    "linux_files requires a Linux ELF64 or Android native profile")
NEVERD_PROCESS_REPORT_TEXT(Windows, "windows")
NEVERD_PROCESS_REPORT_TEXT(Module, "module")
NEVERD_PROCESS_REPORT_TEXT(EmptyOptions, "{}")
NEVERD_PROCESS_REPORT_TEXT(TooLarge, "process options JSON exceeds 64 KiB")
NEVERD_PROCESS_REPORT_TEXT(ObjectRequired,
                           "process options must be a JSON object")
NEVERD_PROCESS_REPORT_TEXT(UnknownField, "unknown process option: ")
NEVERD_PROCESS_REPORT_TEXT(FieldType, "invalid process option type or value: ")
NEVERD_PROCESS_REPORT_TEXT(PathRequired,
                           "process emulation requires a nonempty input path")
NEVERD_PROCESS_REPORT_TEXT(
    ProfileRequired, "process emulation requires an explicit guest profile")
NEVERD_PROCESS_REPORT_TEXT(Disabled, "process emulation is disabled; rebuild "
                                     "with -DNEVERD_ENABLE_CPU_EMULATION=ON")
NEVERD_PROCESS_REPORT_TEXT(AllocationFailed,
                           "could not allocate process report")
NEVERD_PROCESS_REPORT_TEXT(RunFailed, "process emulation failed: ")
NEVERD_PROCESS_REPORT_TEXT(
    UnexpectedException,
    "process emulation failed with an unexpected exception")
NEVERD_PROCESS_REPORT_TEXT(SessionFailed,
                           "could not create process emulation session")
NEVERD_PROCESS_REPORT_TEXT(InvalidReport, "invalid process emulation report")
#endif
#ifdef NEVERD_PROCESS_CLI_STRING
NEVERD_PROCESS_CLI_STRING(Command, "emulate")
NEVERD_PROCESS_CLI_STRING(
    Help,
    "Run a bounded guest process under an explicit OS profile and emit JSON")
NEVERD_PROCESS_CLI_STRING(Input, "input executable")
NEVERD_PROCESS_CLI_STRING(ProfileOption, "profile")
NEVERD_PROCESS_CLI_STRING(
    ProfileHelp,
    "Guest profile (required): linux-elf64-v1, android-aarch64-api28-v1, "
    "windows-pe64-v1, macos-macho64-v1, ios-macho64-v1 or "
    "ios-simulator-macho64-v1")
NEVERD_PROCESS_CLI_STRING(ProfileValue, "name")
NEVERD_PROCESS_CLI_STRING(OptionsOption, "options")
NEVERD_PROCESS_CLI_STRING(
    OptionsHelp,
    "Options JSON: backend, resource limits, "
    "arguments/environment, Linux clocks/files, Darwin files, Android native "
    "or Windows module options")
NEVERD_PROCESS_CLI_STRING(OptionsValue, "json")
#endif
#ifdef NEVERD_PROCESS_CLI_STATUS
NEVERD_PROCESS_CLI_STATUS(Success, 0)
NEVERD_PROCESS_CLI_STATUS(Error, 1)
NEVERD_PROCESS_CLI_STATUS(GuestFailure, 2)
NEVERD_PROCESS_CLI_STATUS(Incomplete, 3)
#endif

#ifdef NEVERD_PROCESS_REPORT_TEXT
NEVERD_PROCESS_REPORT_TEXT(AndroidOptions, "invalid Android native option: ")
NEVERD_PROCESS_REPORT_TEXT(WindowsOptions, "invalid Windows process option: ")
NEVERD_PROCESS_REPORT_TEXT(WindowsProfile,
                           "Windows options require windows-pe64-v1")
NEVERD_PROCESS_REPORT_TEXT(LinuxTimeOptions, "invalid linux_time option: ")
NEVERD_PROCESS_REPORT_TEXT(
    LinuxTimeProfile,
    "linux_time requires a Linux ELF64 or Android native profile")
#endif
