#ifdef NEVERD_EXECUTION_INPUT_LIMIT
NEVERD_EXECUTION_INPUT_LIMIT(NameBytes, NEVERD_EXECUTION_NAME_LIMIT, 128)
NEVERD_EXECUTION_INPUT_LIMIT(GuestNameBytes, NEVERD_EXECUTION_GUEST_NAME_LIMIT,
                             4096)
NEVERD_EXECUTION_INPUT_LIMIT(Stages, NEVERD_EXECUTION_STAGE_LIMIT, 64)
NEVERD_EXECUTION_INPUT_LIMIT(Arguments, NEVERD_EXECUTION_ARGUMENT_LIMIT, 64)
NEVERD_EXECUTION_INPUT_LIMIT(Buffers, NEVERD_EXECUTION_BUFFER_LIMIT, 64)
NEVERD_EXECUTION_INPUT_LIMIT(Instances, NEVERD_EXECUTION_INSTANCE_LIMIT, 4096)
NEVERD_EXECUTION_INPUT_LIMIT(Actions, NEVERD_EXECUTION_ACTION_LIMIT, 1000000)
NEVERD_EXECUTION_INPUT_LIMIT(TransferBytes, NEVERD_EXECUTION_TRANSFER_LIMIT,
                             67108864)
NEVERD_EXECUTION_INPUT_LIMIT(JSONBytes, NEVERD_EXECUTION_JSON_LIMIT, 2097152)
// Includes hex-expanded transfer data and bounded metadata, not guest RAM.
NEVERD_EXECUTION_INPUT_LIMIT(JSONOutputBytes, NEVERD_EXECUTION_REPORT_LIMIT,
                             201326592)
#endif
