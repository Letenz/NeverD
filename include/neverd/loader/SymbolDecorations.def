//===- SymbolDecorations.def - How formats spell C names -------*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// The object formats whose C compilers add one leading underscore to every
/// C name they emit as a symbol: `printf` links as `_printf`.  ELF and x64
/// COFF symbols spell C names as they are.  Also the formats whose import
/// entries name a function by its C name rather than by its symbol, the
/// argument bytes a calling convention appends to a name, and the prefix a
/// format's linker gives the symbol of an import's address slot.
///
//===----------------------------------------------------------------------===//

// NEVERD_ABI_UNDERSCORE(Format): on every architecture of Format.
#ifndef NEVERD_ABI_UNDERSCORE
#define NEVERD_ABI_UNDERSCORE(Format)
#endif
// NEVERD_ABI_UNDERSCORE_ON(Format, Arch): on one architecture of Format.
#ifndef NEVERD_ABI_UNDERSCORE_ON
#define NEVERD_ABI_UNDERSCORE_ON(Format, Arch)
#endif
// NEVERD_ABI_UNDECORATED_PREFIX(Format, Arch, Prefix): a name that starts
// with Prefix is already the symbol and takes no underscore, as Microsoft's
// C++ names (`?f@@YAXXZ`) and fastcall names (`@f@8`) on 32-bit Windows.
#ifndef NEVERD_ABI_UNDECORATED_PREFIX
#define NEVERD_ABI_UNDECORATED_PREFIX(Format, Arch, Prefix)
#endif
// NEVERD_IMPORT_C_NAMES(Format): an import entry names its function by the
// C name, the export name a PE import directory lists (`_initterm`, `exit`),
// not by the symbol it links as.  A Mach-O bind and an ELF dynamic symbol
// name the symbol itself.
#ifndef NEVERD_IMPORT_C_NAMES
#define NEVERD_IMPORT_C_NAMES(Format)
#endif
// NEVERD_ABI_ARGUMENT_BYTES_SUFFIX(Format, Arch): a stdcall or fastcall C
// name links with `@` and the bytes of its arguments after it (`_Sleep@4`,
// `@f@8`), and an import entry names its function without them (`Sleep`).
#ifndef NEVERD_ABI_ARGUMENT_BYTES_SUFFIX
#define NEVERD_ABI_ARGUMENT_BYTES_SUFFIX(Format, Arch)
#endif
// NEVERD_IMPORT_SLOT_PREFIX(Format, Prefix): the linker names the address
// slot of an import by Prefix and the symbol it imports, `__imp_calloc` for
// `calloc` (`__imp__calloc` on 32-bit Windows).
#ifndef NEVERD_IMPORT_SLOT_PREFIX
#define NEVERD_IMPORT_SLOT_PREFIX(Format, Prefix)
#endif

NEVERD_ABI_UNDERSCORE(MachO)
NEVERD_ABI_UNDERSCORE_ON(COFF, X86)
NEVERD_ABI_UNDECORATED_PREFIX(COFF, X86, "?")
NEVERD_ABI_UNDECORATED_PREFIX(COFF, X86, "@")
NEVERD_ABI_ARGUMENT_BYTES_SUFFIX(COFF, X86)
NEVERD_IMPORT_C_NAMES(COFF)
NEVERD_IMPORT_SLOT_PREFIX(COFF, "__imp_")

#undef NEVERD_ABI_UNDERSCORE
#undef NEVERD_ABI_UNDERSCORE_ON
#undef NEVERD_ABI_UNDECORATED_PREFIX
#undef NEVERD_ABI_ARGUMENT_BYTES_SUFFIX
#undef NEVERD_IMPORT_C_NAMES
#undef NEVERD_IMPORT_SLOT_PREFIX
