//===- RawLoader.def - Binary files no header describes ----------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
//
// NEVERD_RAW_PROCESSOR(Name, Arch, Mode): a processor a binary file can be
// read as, by the name the load options and the load dialog use.
// NEVERD_RAW_TEXT(Id, Text): the names the loader gives what it maps.
//
//===----------------------------------------------------------------------===//

#ifdef NEVERD_RAW_PROCESSOR
NEVERD_RAW_PROCESSOR("x86", X86, Default)
NEVERD_RAW_PROCESSOR("x86_64", X64, Default)
NEVERD_RAW_PROCESSOR("arm", ARM, ARM)
NEVERD_RAW_PROCESSOR("thumb", ARM, Thumb)
NEVERD_RAW_PROCESSOR("aarch64", AArch64, Default)
#undef NEVERD_RAW_PROCESSOR
#endif

#ifdef NEVERD_RAW_TEXT
NEVERD_RAW_TEXT(SegmentName, "seg000")
NEVERD_RAW_TEXT(EntryName, "start")
#undef NEVERD_RAW_TEXT
#endif
