#ifdef NEVERD_RAW_ISA_LIMIT
// Bytes a window holds, and the fewest a file may hold to be read at all.
NEVERD_RAW_ISA_LIMIT(WindowBytes, 4096)
NEVERD_RAW_ISA_LIMIT(LeastBytes, 512)
// Windows read at most, spread evenly over a larger file.
NEVERD_RAW_ISA_LIMIT(MostWindows, 1024)
// Bits of byte entropy below which a window is padding and above which it
// is compressed or encrypted, in tenths.
NEVERD_RAW_ISA_LIMIT(LeastEntropyTenths, 30)
NEVERD_RAW_ISA_LIMIT(MostEntropyTenths, 75)
// Percent of printable ASCII from which a window is text.
NEVERD_RAW_ISA_LIMIT(TextPercent, 85)
// Thousandths of a nat per byte by which the likeliest set must explain a
// window better than any set of another family for the window to count as
// code; it votes with the excess.
NEVERD_RAW_ISA_LIMIT(MarginMilli, 500)
// What settles a file on one family: the percent of the weight it takes;
// the windows that must vote for it (every window that may be code, in a
// file with fewer); and in thousandths, the weight it needs per window that
// may be code, the least weight in all, and the least per window it took.
// Code of a set the model lacks scatters a little weight over a few windows.
NEVERD_RAW_ISA_LIMIT(FamilyPercent, 90)
NEVERD_RAW_ISA_LIMIT(LeastVotes, 2)
NEVERD_RAW_ISA_LIMIT(WeightMilliPerWindow, 20)
NEVERD_RAW_ISA_LIMIT(LeastWeightMilli, 500)
NEVERD_RAW_ISA_LIMIT(VoteWeightMilli, 300)
// Windows of the family read for its alignment and width, spread evenly.
NEVERD_RAW_ISA_LIMIT(MostWidthWindows, 128)
// Of a width family's instructions, in hundredths of a percent, the median
// window's 64-bit-only share at most for the 32-bit set and at least for the
// 64-bit set; a share between leaves the width unclear.
NEVERD_RAW_ISA_LIMIT(NarrowMostBasisPoints, 50)
NEVERD_RAW_ISA_LIMIT(WideLeastBasisPoints, 150)
// The least share a guess is listed with, in percent.
NEVERD_RAW_ISA_LIMIT(ListedPercent, 1)
#undef NEVERD_RAW_ISA_LIMIT
#endif
