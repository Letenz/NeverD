#ifdef NEVERD_RAW_WIDTH
NEVERD_RAW_WIDTH("x86", "x86", "x86_64", "x86", BytePair, false,
                 "REX.W prefixes")
NEVERD_RAW_WIDTH("mips-be", "mips", "mips64", "mips", Word, true,
                 "64-bit-only instructions")
NEVERD_RAW_WIDTH("mips-le", "mipsel", "mips64el", "mips", Word, false,
                 "64-bit-only instructions")
NEVERD_RAW_WIDTH("ppc-be", "ppc", "ppc64", "ppc", Word, true,
                 "64-bit-only instructions")
NEVERD_RAW_WIDTH("riscv", "riscv32", "riscv64", "riscv", Parcel, false,
                 "64-bit-only instructions")
NEVERD_RAW_WIDTH("sparc", "sparc", "sparcv9", "sparc", Word, true,
                 "64-bit-only instructions")
#undef NEVERD_RAW_WIDTH
#endif

#ifdef NEVERD_RAW_WIDE
// x86-64: REX.W before an opcode common in code, which 32-bit code reads as
