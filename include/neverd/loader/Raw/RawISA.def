//===- RawISA.def - Instruction sets a binary file's bytes can show -----===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
//
// NEVERD_RAW_ISA(Id, Name, Processor, Family): an instruction set the ISA
// model (lib/loader/Raw/ISAModel.bin, scripts/generate_isa_model.py) knows,
// by its name in the model, the name the user reads, the RawLoader.def
// processor a binary file is read as (empty when NeverD cannot decode the
// set), and its family: sets that differ only in word size share one, so a
// window that tells them apart weakly still counts as code.
//
// NEVERD_RAW_FAMILY(Family, Unit): the bytes a family's instructions align
// to, where more than one; its position statistics tell where in a file its
// instructions start.
//
// NEVERD_RAW_WIDTH(Family, Narrow, Wide, Encoding, Reader, BigEndian,
// Evidence): a family of a 32-bit and a 64-bit set, how its instructions are
// read to tell which -- as 32-bit Words in the family's byte order, as RISC-V
// Parcels (16 bits, or 32 when the low two bits are set), or as every
// BytePair, the first byte high -- and what the user reads the 64-bit set's
// encodings as.
//
// NEVERD_RAW_WIDE(Encoding, Mask, Value): an instruction only the 64-bit set
// of an encoding has, by the bits under Mask.  The 32-bit set's code holds
// none; a RISC-V Parcel reader matches 32-bit instructions only.
//
// NEVERD_RAW_ISA_LIMIT(Id, Value): how windows of a binary file are read,
// and how much of it must show one set for the file to be read as it.
//
//===----------------------------------------------------------------------===//

#ifdef NEVERD_RAW_ISA
NEVERD_RAW_ISA("x86", "Intel x86 (32-bit)", "x86", "x86")
NEVERD_RAW_ISA("x86_64", "x86-64", "x86_64", "x86")
NEVERD_RAW_ISA("arm", "ARM (A32)", "arm", "arm")
NEVERD_RAW_ISA("thumb", "ARM Thumb", "thumb", "thumb")
NEVERD_RAW_ISA("aarch64", "ARM64 (AArch64)", "aarch64", "aarch64")
NEVERD_RAW_ISA("armeb", "ARM big-endian", "", "armeb")
NEVERD_RAW_ISA("mips", "MIPS big-endian (32-bit)", "", "mips-be")
NEVERD_RAW_ISA("mips64", "MIPS big-endian (64-bit)", "", "mips-be")
NEVERD_RAW_ISA("mipsel", "MIPS little-endian (32-bit)", "", "mips-le")
NEVERD_RAW_ISA("mips64el", "MIPS little-endian (64-bit)", "", "mips-le")
NEVERD_RAW_ISA("ppc", "PowerPC big-endian (32-bit)", "", "ppc-be")
NEVERD_RAW_ISA("ppc64", "PowerPC big-endian (64-bit)", "", "ppc-be")
NEVERD_RAW_ISA("ppc64le", "PowerPC little-endian (64-bit)", "", "ppc64le")
NEVERD_RAW_ISA("riscv32", "RISC-V (32-bit)", "", "riscv")
NEVERD_RAW_ISA("riscv64", "RISC-V (64-bit)", "", "riscv")
NEVERD_RAW_ISA("sparc", "SPARC (32-bit)", "", "sparc")
NEVERD_RAW_ISA("sparcv9", "SPARC V9 (64-bit)", "", "sparc")
NEVERD_RAW_ISA("s390x", "IBM z/Architecture", "", "s390x")
NEVERD_RAW_ISA("m68k", "Motorola 68000", "", "m68k")
NEVERD_RAW_ISA("hexagon", "Qualcomm Hexagon", "", "hexagon")
NEVERD_RAW_ISA("loongarch64", "LoongArch (64-bit)", "", "loongarch64")
NEVERD_RAW_ISA("msp430", "TI MSP430", "", "msp430")
NEVERD_RAW_ISA("avr", "Atmel AVR", "", "avr")
NEVERD_RAW_ISA("xtensa", "Tensilica Xtensa", "", "xtensa")
